+      await _copyTorrentFile(source, staged.path);
+      checkActive();
+      final copiedLength = await staged.length();
+      checkActive();
+      if (expectedLength > 0 && copiedLength != expectedLength) {
+        throw _TorrentSaveFailure(
+          'Torrent data incomplete ($copiedLength of $expectedLength bytes). Existing destination files were preserved.',
+        );
+      }
+
+      if (!_publishingExtractionTargets.add(destination)) {
+        throw const _TorrentSaveFailure(
+          'Another download is saving this destination. Retry after it finishes. Existing destination files were preserved.',
+        );
+      }
+      final backup = File(p.join(staging.path, 'previous'));
+      var backedUp = false;
+      try {
+        // Copy/verification can be slow and are asynchronous. Publication is a
+        // short same-volume rename section with no await: pause/cancel cannot
+        // interleave between the final intent check and replacing the file.
+        checkActive();
+        final destinationType = FileSystemEntity.typeSync(
+          destination,
+          followLinks: false,
+        );
+        if (destinationType != FileSystemEntityType.notFound) {
+          if (destinationType != FileSystemEntityType.file) {
+            throw const _TorrentSaveFailure(
+              'The download destination is occupied by a folder or link. Existing files were preserved; rename it or choose another folder.',
+            );
+          }
+          File(destination).renameSync(backup.path);
+          backedUp = true;
+        }
+        try {
+          staged.renameSync(destination);
+        } catch (_) {
+          if (backedUp) {
+            try {
+              backup.renameSync(destination);
+              backedUp = false;
+            } catch (_) {
+              preserveStaging = true;
+              throw _TorrentSaveFailure(
+                'Could not replace the downloaded file. The previous file is preserved at ${backup.path}. Restore it before retrying.',
+              );
+            }
