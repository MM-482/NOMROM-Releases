+    updates.where((task) => task.status == DownloadStatus.completed),
+    isEmpty,
+  );
+
+  void expectNoStaging() => expect(
+    platform.listSync().where(
+      (entity) => p.basename(entity.path).startsWith('.nomrom-torrent-'),
+    ),
+    isEmpty,
+  );
+
+  test(
+    'partial copy failure preserves existing destination and staging source',
+    () async {
+      copy = (source, target) async {
+        await File(target).writeAsBytes([1, 2]);
+        throw const FileSystemException('Simulated disk full');
+      };
+      final task = _task();
+      await start(task);
+      final destination = await File(
+        p.join(platform.path, task.link.filename),
+      ).writeAsString('previous library file');
+      final finished = terminal();
+      torrents.progress.add(_complete(task));
+      expect((await finished).status, DownloadStatus.failed);
+      expect(await destination.readAsString(), 'previous library file');
+      expect(
+        await File(
+          p.join(torrentFolder.path, task.link.filename),
+        ).readAsBytes(),
+        [1, 2, 3, 4],
+      );
+      expectNoCompletion();
+      expectNoStaging();
+    },
+  );
+
+  test('short copied file never replaces an existing destination', () async {
+    copy = (source, target) async {
+      await File(target).writeAsBytes([1, 2]);
+    };
+    final task = _task();
+    await start(task);
+    final destination = await File(
+      p.join(platform.path, task.link.filename),
+    ).writeAsString('previous library file');
+    final finished = terminal();
+    torrents.progress.add(_complete(task));
+    final result = await finished;
+    expect(result.status, DownloadStatus.failed);
+    expect(result.error, contains('incomplete'));
+    expect(await destination.readAsString(), 'previous library file');
+    expectNoCompletion();
+    expectNoStaging();
+  });
+
+  test('verified staged copy safely replaces an existing file', () async {
+    final task = _task();
+    await start(task);
+    final destination = await File(
+      p.join(platform.path, task.link.filename),
+    ).writeAsString('previous library file');
+    final finished = terminal();
+    torrents.progress.add(_complete(task));
+    expect((await finished).status, DownloadStatus.completed);
+    expect(await destination.readAsBytes(), [1, 2, 3, 4]);
+    expectNoStaging();
+  });
+
+  for (final action in ['pause', 'cancel', 'dispose']) {
+    test(
+      '$action during destination lookup prevents publication and late status',
+      () async {
+        final task = _task();
+        await start(task);
+        storage.gateNextPath = true;
+        final destination = await File(
+          p.join(platform.path, task.link.filename),
+        ).writeAsString('previous library file');
+        torrents.progress.add(_complete(task));
+        await storage.pathEntered.future.timeout(_timeout);
+        if (action == 'pause') {
+          await service.pauseDownload(task.id);
+        } else if (action == 'cancel') {
+          await service.cancelDownload(task.id);
+        } else {
+          service.dispose();
+        }
+        final before = notifications.idleCount;
+        storage.releasePath.complete();
+        await _waitFor(() => notifications.idleCount > before);
+        expect(await destination.readAsString(), 'previous library file');
+        expectNoCompletion();
+        expectNoStaging();
+        if (action == 'pause') {
+          expect(db.rows[task.id]!.status, DownloadStatus.paused);
+        } else if (action == 'cancel') {
+          expect(db.rows.containsKey(task.id), isFalse);
+        }
+      },
+    );
+  }
+
+  for (final action in ['pause', 'cancel']) {
+    test(
+      '$action during staged copy preserves destination and final user intent',
+      () async {
+        final copying = Completer<void>();
+        final release = Completer<void>();
+        copy = (source, target) async {
+          await File(target).writeAsBytes([1, 2]);
+          copying.complete();
+          await release.future;
+          await source.copy(target);
+        };
+        final task = _task();
+        await start(task);
+        final destination = await File(
+          p.join(platform.path, task.link.filename),
+        ).writeAsString('previous library file');
+        torrents.progress.add(_complete(task));
+        await copying.future.timeout(_timeout);
+        if (action == 'pause') {
+          await service.pauseDownload(task.id);
+        } else {
+          await service.cancelDownload(task.id);
+        }
+        final before = notifications.idleCount;
+        release.complete();
+        await _waitFor(() => notifications.idleCount > before);
+        expect(await destination.readAsString(), 'previous library file');
+        expectNoCompletion();
+        expectNoStaging();
+        expect(
+          db.rows[task.id]?.status,
+          action == 'pause' ? DownloadStatus.paused : isNull,
+        );
+      },
+    );
+
+    test('$action wins over delayed torrent failure shutdown', () async {
+      copy = (source, target) async =>
+          throw const FileSystemException('Disk full');
+      final task = _task();
+      await start(task);
+      torrents.gateNextCancel = true;
+      torrents.progress.add(_complete(task));
+      await torrents.cancelEntered.future.timeout(_timeout);
+      if (action == 'pause') {
+        await service.pauseDownload(task.id);
+      } else {
+        await service.cancelDownload(task.id);
+      }
+      final before = notifications.idleCount;
+      torrents.releaseCancel.complete();
+      await _waitFor(() => notifications.idleCount > before);
+      expect(
+        updates.where((task) => task.status == DownloadStatus.failed),
+        isEmpty,
+      );
+      expectNoCompletion();
+      expect(
+        db.rows[task.id]?.status,
+        action == 'pause' ? DownloadStatus.paused : isNull,
+      );
+    });
+
+    test('$action wins over an in-flight completion database write', () async {
+      final task = _task();
+      await start(task);
+      db.gateCompletion = true;
+      torrents.progress.add(_complete(task));
+      await db.completionEntered.future.timeout(_timeout);
+      final intent = action == 'pause'
+          ? service.pauseDownload(task.id)
+          : service.cancelDownload(task.id);
+      db.releaseCompletion.complete();
+      await intent;
+      await _waitFor(() => notifications.idleCount > 0);
+      expectNoCompletion();
+      expect(
+        db.rows[task.id]?.status,
+        action == 'pause' ? DownloadStatus.paused : isNull,
+      );
+    });
+  }
+
+  test('rejected app update cannot strand an active finalization', () async {
+    final copying = Completer<void>();
+    final release = Completer<void>();
+    copy = (source, target) async {
+      copying.complete();
+      await release.future;
+      await source.copy(target);
+    };
+    final task = _task();
+    await start(task);
+    final finished = terminal();
+    torrents.progress.add(_complete(task));
+    await copying.future.timeout(_timeout);
+    await expectLater(service.prepareForAppUpdate(), throwsStateError);
+    release.complete();
+    expect((await finished).status, DownloadStatus.completed);
+    expect(
+      await File(p.join(platform.path, task.link.filename)).readAsBytes(),
+      [1, 2, 3, 4],
+    );
+  });
+
+  test(
+    'immediate pause and resume cannot let the old finalizer finish the new run',
+    () async {
+      final copying = Completer<void>();
+      final release = Completer<void>();
+      var copies = 0;
+      copy = (source, target) async {
+        if (++copies == 1) {
+          copying.complete();
+          await release.future;
+        }
+        await source.copy(target);
+      };
+      final task = _task();
+      await start(task);
+      final destination = await File(
+        p.join(platform.path, task.link.filename),
+      ).writeAsString('previous library file');
+      torrents.progress.add(_complete(task));
+      await copying.future.timeout(_timeout);
+      await service.pauseDownload(task.id);
+      await service.resumeDownload(task.id);
+      release.complete();
+      await _waitFor(() => torrents.added.length == 2);
+      expectNoCompletion();
+      expect(db.rows[task.id]!.status, DownloadStatus.downloading);
+      expect(await destination.readAsString(), 'previous library file');
+      final finished = terminal();
+      torrents.progress.add(_complete(task));
+      expect((await finished).status, DownloadStatus.completed);
+      expect(copies, 2);
+      expect(await destination.readAsBytes(), [1, 2, 3, 4]);
+    },
+  );
+
+  for (final action in ['pause', 'cancel']) {
+    test(
+      '$action during reuse of an existing archive prevents late extraction completion',
+      () async {
+        final extracting = Completer<void>();
+        final release = Completer<void>();
+        final extractionReturned = Completer<void>();
+        sevenZip.onExtract = (archivePath, outputDir) async {
+          extracting.complete();
+          await release.future;
+          await File(p.join(outputDir, 'Game.chd')).writeAsBytes([9, 8, 7]);
+          extractionReturned.complete();
+          return outputDir;
+        };
+        final task = _task(filename: 'Game.zip');
+        final archive = await File(
+          p.join(platform.path, task.link.filename),
+        ).writeAsBytes([1, 2, 3, 4]);
+        makeService();
+        db.rows[task.id] = task;
+        service.setMaxConcurrentDownloads(1);
+        await extracting.future.timeout(_timeout);
+        if (action == 'pause') {
+          await service.pauseDownload(task.id);
+        } else {
+          await service.cancelDownload(task.id);
+        }
+        release.complete();
+        await extractionReturned.future.timeout(_timeout);
+        await _waitFor(
+          () => !platform.listSync().any(
+            (entry) => p.basename(entry.path).startsWith('.extract-'),
+          ),
+        );
+        expect(await archive.readAsBytes(), [1, 2, 3, 4]);
+        expect(await File(p.join(platform.path, 'Game.chd')).exists(), isFalse);
+        expectNoCompletion();
+        expect(
+          updates.where((task) => task.status == DownloadStatus.failed),
+          isEmpty,
+        );
+        expect(
+          db.rows[task.id]?.status,
+          action == 'pause' ? DownloadStatus.paused : isNull,
+        );
+        expect(
+          platform.listSync().where(
+            (entry) => p.basename(entry.path).startsWith('.extract-'),
+          ),
+          isEmpty,
+        );
+      },
+    );
+  }
+}
