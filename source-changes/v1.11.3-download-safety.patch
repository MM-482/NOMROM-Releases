+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:path/path.dart' as p;
+import 'package:romgi/models/models.dart';
+import 'package:romgi/services/extraction_receipt_store.dart';
+
+DownloadTask _task({
+  String slug = 'catalog-game-usa',
+  String platform = 'psx',
+  int size = 100,
+}) => DownloadTask(
+  id: 'task',
+  slug: slug,
+  title: 'Game',
+  platform: platform,
+  createdAt: DateTime(2026),
+  link: DownloadLink(
+    name: 'Game',
+    type: 'Game',
+    format: 'zip',
+    url: 'https://host/Game.zip?secret=never-store-this',
+    filename: 'Game.zip',
+    host: 'host',
+    sourceId: 'test-source',
+    sourceUrl: 'https://host/?key=never-store-this',
+    size: size,
+    sizeStr: '$size B',
+  ),
+);
+
+void main() {
+  const store = ExtractionReceiptStore();
+  late Directory root;
+
+  setUp(
+    () => root = Directory.systemTemp.createTempSync('extraction-receipt-'),
+  );
+  tearDown(() => root.deleteSync(recursive: true));
+
+  File file(String relative, [String content = 'verified extracted output']) {
+    final output = File(p.join(root.path, relative));
+    output.parent.createSync(recursive: true);
+    return output..writeAsStringSync(content);
+  }
+
+  Future<void> record(DownloadTask task, String target) =>
+      store.record(task, root, target, canPublish: () {});
+
+  test(
+    'a matching supported file without extraction provenance is not reused',
+    () async {
+      file('Game.chd');
+      expect(await store.find(_task(), root), isNull);
+    },
+  );
+
+  test(
+    'recorded file output is reusable without persisting source credentials',
+    () async {
+      final output = file('Downloaded.chd');
+      await record(_task(), output.path);
+      expect(await store.find(_task(), root), output.path);
+      final receipt = root.listSync().whereType<File>().singleWhere(
+        (entry) => p.basename(entry.path).startsWith('.nomrom-extraction-'),
+      );
+      final text = receipt.readAsStringSync();
+      expect(text, isNot(contains('never-store-this')));
+      expect(text, isNot(contains('https://')));
+    },
+  );
+
+  test('recorded directory requires its complete nested output set', () async {
+    final target = Directory(p.join(root.path, 'Game'))..createSync();
+    file('Game/discs/track.bin');
+    file('Game/Game.cue', 'FILE discs/track.bin BINARY');
+    await record(_task(), target.path);
+    expect(await store.find(_task(), root), target.path);
+    file('Game/unrelated.txt', 'added after extraction');
+    expect(await store.find(_task(), root), isNull);
+  });
+
+  for (final mutation in ['delete', 'replace', 'truncate']) {
+    test('$mutation of recorded output invalidates extraction reuse', () async {
+      final output = file('Game.chd');
+      await record(_task(), output.path);
+      if (mutation == 'delete') {
+        output.deleteSync();
+      } else if (mutation == 'replace') {
+        final original = output.statSync();
+        output.deleteSync();
+        file('Game.chd', 'x' * original.size);
+        output.setLastModifiedSync(
+          original.modified.add(const Duration(seconds: 1)),
+        );
+      } else {
+        output.writeAsStringSync('');
+      }
+      expect(await store.find(_task(), root), isNull);
+    });
+  }
+
+  test('catalog, system and archive identity cannot share a receipt', () async {
+    final output = file('Game.chd');
+    await record(_task(), output.path);
+    expect(await store.find(_task(slug: 'different-game'), root), isNull);
+    expect(await store.find(_task(platform: 'ps2'), root), isNull);
+    expect(await store.find(_task(size: 101), root), isNull);
+  });
+
+  test(
+    'modified receipt cannot authorize a target outside the platform folder',
+    () async {
+      final output = file('Game.chd');
+      await record(_task(), output.path);
+      final receipt = root.listSync().whereType<File>().singleWhere(
+        (entry) => p.basename(entry.path).startsWith('.nomrom-extraction-'),
+      );
+      final data =
+          jsonDecode(receipt.readAsStringSync()) as Map<String, dynamic>;
+      data['target'] = '../unrelated.chd';
+      receipt.writeAsStringSync(jsonEncode(data));
+      expect(await store.find(_task(), root), isNull);
+    },
+  );
+
+  test(
+    'receipt publication preserves unrelated colliding metadata files',
+    () async {
+      final output = file('Game.chd');
+      await record(_task(), output.path);
+      final receipt = root.listSync().whereType<File>().singleWhere(
+        (entry) => p.basename(entry.path).startsWith('.nomrom-extraction-'),
+      );
+      receipt.writeAsStringSync('unrelated user data');
+      await record(_task(), output.path);
+      expect(receipt.readAsStringSync(), 'unrelated user data');
+      expect(await store.find(_task(), root), isNull);
+    },
+  );
+
+  test(
+    'a cancellation at receipt publication leaves no reusable receipt',
+    () async {
+      final output = file('Game.chd');
+      var checks = 0;
+      await expectLater(
+        store.record(
+          _task(),
+          root,
+          output.path,
+          canPublish: () {
+            if (++checks == 2) throw StateError('cancelled');
+          },
+        ),
+        throwsStateError,
+      );
+      expect(output.existsSync(), isTrue);
+      expect(await store.find(_task(), root), isNull);
+      expect(root.listSync().whereType<Directory>(), isEmpty);
+    },
+  );
+}
