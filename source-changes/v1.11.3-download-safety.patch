new file mode 100644
index 0000000000000000000000000000000000000000..912340597700ff0f61af97f9061c6ae15bb4787e
--- /dev/null
+++ b/lib/services/extraction_receipt_store.dart
@@ -0,0 +1,211 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:crypto/crypto.dart';
+import 'package:path/path.dart' as p;
+
+import '../models/models.dart';
+
+/// Remembers only output that this app successfully extracted for this exact
+/// catalog/source identity. A similarly named file is not extraction evidence.
+class ExtractionReceiptStore {
+  const ExtractionReceiptStore();
+
+  String _identity(DownloadTask task) => sha256
+      .convert(
+        utf8.encode(
+          jsonEncode([
+            task.platform,
+            task.slug,
+            task.link.filename,
+            task.link.size,
+            task.link.sourceId,
+            task.link.torrentInfohash?.toLowerCase(),
+            task.link.torrentFilePath,
+          ]),
+        ),
+      )
+      .toString();
+
+  File _receipt(Directory platformDirectory, String identity) =>
+      File(p.join(platformDirectory.path, '.nomrom-extraction-$identity.json'));
+
+  /// Returns a previous output only if its identity, exact file set, lengths
+  /// and modification times still match a receipt created after extraction.
+  Future<String?> find(DownloadTask task, Directory platformDirectory) async {
+    try {
+      final identity = _identity(task);
+      final receipt = _receipt(platformDirectory, identity);
+      if (await FileSystemEntity.type(receipt.path, followLinks: false) !=
+          FileSystemEntityType.file) {
+        return null;
+      }
+      if (await receipt.length() > 8 * 1024 * 1024) return null;
+      final decoded = jsonDecode(await receipt.readAsString());
+      if (decoded is! Map<String, dynamic> ||
+          decoded['version'] != 1 ||
+          decoded['identity'] != identity ||
+          decoded['target'] is! String ||
+          decoded['files'] is! List) {
+        return null;
+      }
+      final target = p.join(
+        platformDirectory.path,
+        decoded['target'] as String,
+      );
+      final snapshot = await _snapshot(platformDirectory, target);
+      if (snapshot == null ||
+          decoded['target'] != snapshot.target ||
+          decoded['kind'] != snapshot.kind ||
+          jsonEncode(decoded['files']) != jsonEncode(snapshot.files)) {
+        return null;
+      }
+      return target;
+    } catch (_) {
+      // A missing, obsolete, unreadable or malformed receipt disables reuse.
+      return null;
+    }
+  }
+
+  /// Receipt failures never invalidate an otherwise successful extraction.
+  /// The caller must recheck task activity when handling an error.
+  Future<void> record(
+    DownloadTask task,
+    Directory platformDirectory,
+    String target, {
+    required void Function() canPublish,
+  }) async {
+    final snapshot = await _snapshot(platformDirectory, target);
+    if (snapshot == null) return;
+    canPublish();
+    final identity = _identity(task);
+    final receipt = _receipt(platformDirectory, identity);
+    if (p.equals(p.absolute(target), p.absolute(receipt.path))) return;
+    final staging = await platformDirectory.createTemp('.nomrom-receipt-');
+    try {
+      final temporary = File(p.join(staging.path, 'receipt.json'));
+      await temporary.writeAsString(
+        jsonEncode({
+          'version': 1,
+          'identity': identity,
+          'target': snapshot.target,
+          'kind': snapshot.kind,
+          'files': snapshot.files,
+        }),
+        flush: true,
+      );
+      final existing = await FileSystemEntity.type(
+        receipt.path,
+        followLinks: false,
+      );
+      if (existing != FileSystemEntityType.notFound &&
+          existing != FileSystemEntityType.file) {
+        return;
+      }
+      if (existing == FileSystemEntityType.file) {
+        try {
+          if (await receipt.length() > 8 * 1024 * 1024) return;
+          final previous = jsonDecode(await receipt.readAsString());
+          if (previous is! Map<String, dynamic> ||
+              previous['version'] != 1 ||
+              previous['identity'] != identity) {
+            return;
+          }
+        } catch (_) {
+          return;
+        }
+      }
+      canPublish();
+      // There is no suspension between the last task check and publishing the
+      // small app-owned receipt. Never remove a user directory or link here.
+      if (existing == FileSystemEntityType.file) receipt.deleteSync();
+      temporary.renameSync(receipt.path);
+    } finally {
+      try {
+        await staging.delete(recursive: true);
+      } catch (_) {}
+    }
+  }
+
+  Future<_ExtractionSnapshot?> _snapshot(
+    Directory platformDirectory,
+    String target,
+  ) async {
+    final root = p.normalize(p.absolute(platformDirectory.path));
+    final path = p.normalize(p.absolute(target));
+    if (!p.isWithin(root, path)) return null;
+    final canonicalRoot = await platformDirectory.resolveSymbolicLinks();
+
+    Future<FileSystemEntityType?> regularType(String candidate) async {
+      final relative = p.relative(candidate, from: root);
+      var current = root;
+      final segments = p.split(relative);
+      for (var index = 0; index < segments.length; index++) {
+        current = p.join(current, segments[index]);
+        final type = await FileSystemEntity.type(current, followLinks: false);
+        if (type != FileSystemEntityType.file &&
+            type != FileSystemEntityType.directory) {
+          return null;
+        }
+        if (index < segments.length - 1 &&
+            type != FileSystemEntityType.directory) {
+          return null;
+        }
+        final canonical = type == FileSystemEntityType.directory
+            ? await Directory(current).resolveSymbolicLinks()
+            : await File(current).resolveSymbolicLinks();
+        if (!p.equals(
+          canonical,
+          p.join(canonicalRoot, p.relative(current, from: root)),
+        )) {
+          return null;
+        }
+        if (index == segments.length - 1) return type;
+      }
+      return null;
+    }
+
+    final targetType = await regularType(path);
+    if (targetType == null) return null;
+    final filePaths = <String>[];
+    if (targetType == FileSystemEntityType.file) {
+      filePaths.add(path);
+    } else {
+      await for (final entity in Directory(
+        path,
+      ).list(recursive: true, followLinks: false)) {
+        final type = await regularType(entity.path);
+        if (type == null) return null;
+        if (type == FileSystemEntityType.file) filePaths.add(entity.path);
+      }
+    }
+    if (filePaths.isEmpty) return null;
+    filePaths.sort();
+    final files = <Map<String, Object>>[];
+    var totalLength = 0;
+    for (final filePath in filePaths) {
+      final stat = await File(filePath).stat();
+      if (stat.type != FileSystemEntityType.file) return null;
+      files.add({
+        'path': p.relative(filePath, from: root).replaceAll('\\', '/'),
+        'length': stat.size,
+        'modified': stat.modified.toUtc().microsecondsSinceEpoch,
+      });
+      totalLength += stat.size;
+    }
+    if (totalLength == 0) return null;
+    return _ExtractionSnapshot(
+      p.relative(path, from: root).replaceAll('\\', '/'),
+      targetType == FileSystemEntityType.file ? 'file' : 'directory',
+      files,
+    );
+  }
+}
+
+class _ExtractionSnapshot {
+  final String target;
+  final String kind;
+  final List<Map<String, Object>> files;
+
+  const _ExtractionSnapshot(this.target, this.kind, this.files);
+}
