+    const DebridError(
+      'Not a cache timeout (CACHING_TIMEOUT)',
+      code: 'REQUEST_FAILED',
+    ),
+    const DebridError(
+      'Inconsistent auth failure.',
+      code: 'CACHING_TIMEOUT',
+      authError: true,
+    ),
+  ]) {
+    test(
+      '${failure.code}/${failure.authError} is still a failure, not a remote-preparation pause',
+      () async {
+        debrid.plan('failed.rom', failure);
+        db.rows['failed'] = _task('failed');
+        downloads.setMaxConcurrentDownloads(1);
+        await debrid.started['failed.rom']!.future;
+        debrid.release['failed.rom']!.complete();
+        await _until(() => db.rows['failed']!.status == DownloadStatus.failed);
+        expect(db.rows['failed']!.waitingForDebrid, isFalse);
+        expect(db.rows['failed']!.error, contains(failure.code!));
+      },
+    );
+  }
+
+  test(
+    'a cache timeout still falls back to native torrents when P2P is enabled',
+    () async {
+      downloads.getLinkResolverPrefs = () =>
+          const LinkResolverPrefs(debridEnabled: true);
+      debrid.plan('native.rom', _cachingTimeout);
+      db.rows['native'] = _task('native');
+      downloads.setMaxConcurrentDownloads(1);
+      await debrid.started['native.rom']!.future;
+      debrid.release['native.rom']!.complete();
+      await _until(() => torrents.added.isNotEmpty);
+      expect(db.rows['native']!.status, DownloadStatus.downloading);
+      expect(db.rows['native']!.waitingForDebrid, isFalse);
+      expect(torrents.added.single.fileIndices, [0]);
+      await downloads.pauseDownload('native');
+    },
+  );
+
+  test(
+    'cancelled polling ignores even a late caching timeout and progress callback',
+    () async {
+      debrid.plan('cancelled.rom', _cachingTimeout);
+      debrid.ignoreCancellation.add('cancelled.rom');
+      db.rows['cancelled'] = _task('cancelled');
+      final events = <DownloadTask>[];
+      final subscription = downloads.downloadStream.listen(events.add);
+      addTearDown(subscription.cancel);
+      downloads.setMaxConcurrentDownloads(1);
+      await debrid.started['cancelled.rom']!.future;
+      await downloads.cancelDownload('cancelled');
+      await Future<void>.delayed(Duration.zero);
+      final count = events.length;
+      debrid.cachingCallbacks['cancelled.rom']!(
+        const DebridCaching(progress: .9),
+      );
+      debrid.release['cancelled.rom']!.complete();
+      await Future<void>.delayed(const Duration(milliseconds: 20));
+      expect(db.rows.containsKey('cancelled'), isFalse);
+      expect(events.length, count);
+      expect(torrents.added, isEmpty);
+      expect(transport.calls, isEmpty);
+    },
+  );
+
+  test(
+    'cancelling while a waiting-state write is pending cannot revive the row or emit a stale pause',
+    () async {
+      debrid.plan('cancelled.rom', _cachingTimeout);
+      db.pausedWriteGate = Completer<void>();
+      db.rows['cancelled'] = _task('cancelled');
+      final events = <DownloadTask>[];
+      final subscription = downloads.downloadStream.listen(events.add);
+      addTearDown(subscription.cancel);
+      downloads.setMaxConcurrentDownloads(1);
+      await debrid.started['cancelled.rom']!.future;
+      debrid.release['cancelled.rom']!.complete();
+      await db.pausedWriteStarted.future;
+      final cancellation = downloads.cancelDownload('cancelled');
+      await _until(() => torrents.cancellations > 0);
+      await Future<void>.delayed(Duration.zero);
+      db.pausedWriteGate!.complete();
+      await cancellation;
+      await Future<void>.delayed(const Duration(milliseconds: 20));
+      expect(db.rows.containsKey('cancelled'), isFalse);
+      expect(events.where((task) => task.waitingForDebrid), isEmpty);
+    },
+  );
+
+  test(
+    'cancelling during saved configuration lookup cannot start debrid resolution or revive the task',
+    () async {
+      debrid.configurationGate = Completer<void>();
+      debrid.plan('cancelled.rom', _cachingTimeout);
+      db.rows['cancelled'] = _task('cancelled');
+      final events = <DownloadTask>[];
+      final subscription = downloads.downloadStream.listen(events.add);
+      addTearDown(subscription.cancel);
+      downloads.setMaxConcurrentDownloads(1);
+      await debrid.configurationStarted.future;
+      await downloads.cancelDownload('cancelled');
+      expect(db.rows.containsKey('cancelled'), isFalse);
+      debrid.configurationGate!.complete();
+      await Future<void>.delayed(const Duration(milliseconds: 20));
+      expect(debrid.calls, isEmpty);
+      expect(events, isEmpty);
+      expect(db.rows.containsKey('cancelled'), isFalse);
+      expect(torrents.added, isEmpty);
+      expect(transport.calls, isEmpty);
+    },
+  );
+
+  test('app-update preparation wins over a late caching timeout', () async {
+    debrid.plan('updating.rom', _cachingTimeout);
+    debrid.ignoreCancellation.add('updating.rom');
+    db.rows['updating'] = _task('updating');
+    final events = <DownloadTask>[];
+    final subscription = downloads.downloadStream.listen(events.add);
+    addTearDown(subscription.cancel);
+    downloads.setMaxConcurrentDownloads(1);
+    await debrid.started['updating.rom']!.future;
+    final preparation = downloads.prepareForAppUpdate();
+    debrid.cachingCallbacks['updating.rom']!(const DebridCaching(progress: .9));
+    debrid.release['updating.rom']!.complete();
+    await preparation;
+    expect(db.rows['updating']!.status, DownloadStatus.paused);
+    expect(db.rows['updating']!.error, isNull);
+    expect(db.rows['updating']!.resolvingDebrid, isFalse);
+    expect(db.rows['updating']!.waitingForDebrid, isFalse);
+    expect(
+      events.where(
+        (task) => task.status == DownloadStatus.failed || task.waitingForDebrid,
+      ),
+      isEmpty,
+    );
+    expect(torrents.added, isEmpty);
+  });
+
+  test(
+    'only a paused unresolved torrent with the exact marker is waiting for debrid',
+    () {
+      final base = _task('model');
+      expect(
+        base
+            .copyWith(
