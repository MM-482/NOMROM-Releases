+final _extraQualifier = RegExp(
+  r'^(?:demo|beta|proto(?:type)?|sample|preview|trial|dynamic theme|theme|wallpaper|trailer|bonus\s*(?:disc|dvd)|perfect guide|sound\s*track|cheat\s*disc|making of|dvd video|add[ -]?on|dlc|update|unlock key|license)(?:\b.*)?$',
+  caseSensitive: false,
+);
