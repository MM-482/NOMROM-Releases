+        ...other.metadata.coverUrls,
+      }.toList()..sort(),
+      screenshotUrls: {
+        ...metadata.screenshotUrls.where((uri) => !other.artwork.contains(uri)),
+        ...other.metadata.screenshotUrls,
+      }.toList()..sort(),
+      artworkUrls: {
+        ...metadata.artworkUrls.where((uri) => !other.artwork.contains(uri)),
+        ...other.metadata.artworkUrls,
+      }.toList()..sort(),
+      sourceName: 'Skraper import',
+    ),
+  );
+
+  Map<String, Object?> toJson() => {
+    'id': id,
+    'platform': platform,
+    'title': title,
+    'aliases': aliases,
+    'description': metadata.description,
+    'developer': metadata.developer,
+    'publisher': metadata.publisher,
+    'release_date': metadata.releaseDate,
+    'genre': metadata.genre,
+    'players': metadata.players,
+    'covers': metadata.coverUrls,
+    'screenshots': metadata.screenshotUrls,
+    'artwork': metadata.artworkUrls,
+  };
+
+  factory _Record.fromJson(dynamic value) {
+    if (value is! Map ||
+        value['id'] is! String ||
+        !RegExp(r'^[a-f0-9]{64}$').hasMatch(value['id'] as String) ||
+        value['platform'] is! String ||
+        value['title'] is! String ||
+        value['aliases'] is! List) {
+      throw const FormatException();
+    }
+    List<String> images(String key) =>
+        (value[key] as List? ?? const [])
+            .whereType<String>()
+            .where((uri) => SkraperImportService._artFilename(uri) != null)
+            .toSet()
+            .toList()
+          ..sort();
+    return _Record(
+      id: value['id'] as String,
+      platform: _platformKey(value['platform'] as String),
+      title: value['title'] as String,
+      aliases: (value['aliases'] as List).whereType<String>().toSet().toList()
+        ..sort(),
+      metadata: MetadataFound(
+        description: value['description'] as String?,
+        developer: value['developer'] as String?,
+        publisher: value['publisher'] as String?,
+        releaseDate: value['release_date'] as String?,
+        genre: value['genre'] as String?,
+        players: value['players'] as String?,
+        coverUrls: images('covers'),
+        screenshotUrls: images('screenshots'),
+        artworkUrls: images('artwork'),
+        sourceName: 'Skraper import',
+      ),
+    );
+  }
+}
+
+MetadataFound _withImages(
+  MetadataFound metadata,
+  Set<String> covers,
+  Set<String> screenshots,
+  Set<String> artwork,
+) => MetadataFound(
+  description: metadata.description,
+  developer: metadata.developer,
+  publisher: metadata.publisher,
+  releaseDate: metadata.releaseDate,
+  genre: metadata.genre,
+  players: metadata.players,
+  coverUrls: covers.toList()..sort(),
+  screenshotUrls: screenshots.toList()..sort(),
+  artworkUrls: artwork.toList()..sort(),
+  sourceName: 'Skraper import',
+);
+
+String? _field(XmlElement element, String tag, {int limit = 1024}) {
+  final value = element.getElement(tag)?.innerText.trim();
+  if (value == null || value.isEmpty) return null;
+  return value.length > limit ? value.substring(0, limit) : value;
+}
+
+String _platformKey(String value) {
+  final key = value.trim().toLowerCase();
+  if (key.isEmpty || key.length > 128 || RegExp(r'[\x00-\x1f]').hasMatch(key)) {
+    throw const FormatException('Choose a NOMROM platform for this gamelist.');
+  }
+  return key;
+}
+
+String _romStem(String value) {
+  final name = p.posix.basename(value.replaceAll('\\', '/'));
+  final extension = p.posix.extension(name).toLowerCase();
+  const extensions = {
+    '.zip',
+    '.7z',
+    '.rar',
+    '.nes',
+    '.fds',
+    '.sfc',
+    '.smc',
+    '.n64',
+    '.z64',
+    '.v64',
+    '.gb',
+    '.gbc',
+    '.gba',
+    '.nds',
+    '.3ds',
+    '.cia',
+    '.iso',
+    '.bin',
+    '.cue',
+    '.chd',
+    '.cso',
+    '.zso',
+    '.gdi',
+    '.cdi',
+    '.m3u',
+    '.pbp',
+    '.rom',
+    '.md',
+    '.gen',
+    '.smd',
+    '.sms',
+    '.gg',
+    '.pce',
+    '.a26',
+    '.a52',
+    '.a78',
+    '.j64',
+    '.lnx',
+    '.ngp',
+    '.ngc',
+    '.ws',
+    '.wsc',
+    '.adf',
+    '.d64',
+    '.tap',
+    '.dsk',
+    '.rvz',
+    '.wbfs',
+    '.wud',
+    '.wux',
+    '.nsp',
+    '.xci',
+    '.pkg',
+    '.vpk',
+    '.ccd',
+    '.img',
+    '.wad',
+    '.exe',
+    '.xbe',
+    '.xex',
+  };
+  return extensions.contains(extension)
+      ? name.substring(0, name.length - extension.length)
+      : name;
+}
+
+final _extraQualifier = RegExp(
+  r'^(?:demo|beta|proto(?:type)?|sample|preview|trial|dynamic theme|theme|wallpaper|trailer|bonus\s*(?:disc|dvd)|perfect guide|sound\s*track|cheat\s*disc|making of|dvd video|add[ -]?on|dlc|update|unlock key|license)(?:\b.*)?$',
+  caseSensitive: false,
+);
+
+({String key, String semantic}) _identity(String raw) {
+  final identity = catalogTitleIdentity(raw.trim());
+  // cleanMetadataTitle is safe only after catalog identity has removed known
+  // release tags and no meaningful bracketed edition remains.
+  final base = RegExp(r'[\[\]()]').hasMatch(identity.title)
+      ? identity.title
+      : cleanMetadataTitle(identity.title);
+  final extras =
+      identity.qualifiers
+          .where(_extraQualifier.hasMatch)
+          .map((value) => value.toLowerCase().replaceAll(RegExp(r'\s+'), ' '))
+          .toSet()
+          .toList()
+        ..sort();
+  final meaningful = RegExp(r'\([^()]*\)|\[[^\[\]]*\]')
+      .allMatches(identity.title)
+      .map((match) => match[0]!.toLowerCase())
+      .join('|');
+  final extra = extras.isNotEmpty
+      ? extras.join('|')
+      : (identity.extra ? 'extra' : '');
+  final key = base.toLowerCase().trim();
+  return (
+    key: extra.isEmpty ? key : '$key\u001f$extra',
+    semantic: '$meaningful\u001f$extra',
+  );
+}
+
+List<String> _aliases(String title, String romTitle) {
+  final name = _identity(title);
+  final rom = _identity(romTitle);
+  final aliases = <String>{};
+  if (romTitle.isEmpty) {
+    if (name.key.isNotEmpty) aliases.add(name.key);
+  } else if (rom.semantic == '\u001f' && name.semantic != '\u001f') {
+    // The display name may carry a Demo/edition qualifier omitted by a short
+    // ROM filename. Do not publish the less specific retail alias either.
+    if (name.key.isNotEmpty) aliases.add(name.key);
+  } else {
+    if (rom.key.isNotEmpty) aliases.add(rom.key);
+    // A generic display name must never turn a Demo/Deluxe ROM into a retail
+    // alias (or the reverse). Prefer its more precise ROM filename identity.
+    if (name.semantic == rom.semantic && name.key.isNotEmpty) {
+      aliases.add(name.key);
+    }
+  }
+  return aliases.toList()..sort();
+}
+
+String _primaryIdentity(String title, String romTitle) {
+  final name = _identity(title);
+  final rom = _identity(romTitle);
+  return romTitle.isEmpty ||
+          rom.semantic == '\u001f' && name.semantic != '\u001f'
+      ? name.key
+      : rom.key;
+}
+
+String? _date(String? value) {
+  if (value == null) return null;
+  final match = RegExp(r'^(\d{4})(\d{2})(\d{2})(?:T\d{6})?$').firstMatch(value);
+  if (match == null) return value.length <= 64 ? value : null;
+  final year = int.parse(match[1]!);
+  final month = int.parse(match[2]!);
+  final day = int.parse(match[3]!);
+  if (year < 1900 || month < 1 || month > 12 || day < 1 || day > 31) {
+    return null;
+  }
+  final date = DateTime.utc(year, month, day);
+  return date.year == year && date.month == month && date.day == day
+      ? '${match[1]}-${match[2]}-${match[3]}'
+      : null;
+}
+
+/// Signature and declared-dimension checks; decoding remains the image widget's
+/// responsibility. Reject excessive dimensions before handing bytes to codecs.
+String? _imageExtension(Uint8List bytes) {
+  bool dimensions(int width, int height) =>
+      width > 0 &&
+      height > 0 &&
+      width <= 16384 &&
+      height <= 16384 &&
+      width * height <= 50000000;
+  bool at(int offset, List<int> signature) =>
+      bytes.length >= offset + signature.length &&
+      List.generate(
+        signature.length,
+        (index) => index,
+      ).every((index) => bytes[offset + index] == signature[index]);
+  final data = ByteData.sublistView(bytes);
+  if (bytes.length >= 33 &&
+      at(0, [137, 80, 78, 71, 13, 10, 26, 10]) &&
+      at(12, [73, 72, 68, 82])) {
+    return dimensions(data.getUint32(16), data.getUint32(20)) ? 'png' : null;
+  }
+  if (bytes.length >= 13 &&
+      (at(0, [71, 73, 70, 56, 55, 97]) || at(0, [71, 73, 70, 56, 57, 97]))) {
+    return dimensions(
+          data.getUint16(6, Endian.little),
+          data.getUint16(8, Endian.little),
+        )
+        ? 'gif'
+        : null;
+  }
+  if (bytes.length >= 30 &&
+      at(0, [82, 73, 70, 70]) &&
+      at(8, [87, 69, 66, 80])) {
+    int width;
+    int height;
+    if (at(12, [86, 80, 56, 88])) {
+      width = 1 + bytes[24] + (bytes[25] << 8) + (bytes[26] << 16);
+      height = 1 + bytes[27] + (bytes[28] << 8) + (bytes[29] << 16);
+    } else if (at(12, [86, 80, 56, 76]) && bytes[20] == 0x2f) {
+      final packed = data.getUint32(21, Endian.little);
+      width = 1 + (packed & 0x3fff);
+      height = 1 + ((packed >> 14) & 0x3fff);
+    } else if (at(12, [86, 80, 56, 32]) && at(23, [0x9d, 0x01, 0x2a])) {
+      width = data.getUint16(26, Endian.little) & 0x3fff;
+      height = data.getUint16(28, Endian.little) & 0x3fff;
+    } else {
+      return null;
+    }
+    return dimensions(width, height) ? 'webp' : null;
+  }
+  if (bytes.length >= 4 && at(0, [0xff, 0xd8])) {
+    var offset = 2;
+    while (offset + 4 <= bytes.length) {
+      if (bytes[offset++] != 0xff) return null;
+      while (offset < bytes.length && bytes[offset] == 0xff) {
+        offset++;
+      }
+      if (offset >= bytes.length) return null;
+      final marker = bytes[offset++];
+      if (marker == 0xda || marker == 0xd9) return null;
+      if (marker == 0x01 || marker >= 0xd0 && marker <= 0xd7) continue;
+      if (offset + 2 > bytes.length) return null;
+      final length = data.getUint16(offset);
+      if (length < 2 || offset + length > bytes.length) return null;
+      if (const {
+        0xc0,
+        0xc1,
+        0xc2,
+        0xc3,
+        0xc5,
+        0xc6,
+        0xc7,
+        0xc9,
+        0xca,
+        0xcb,
+        0xcd,
+        0xce,
+        0xcf,
+      }.contains(marker)) {
+        if (length < 8) return null;
+        return dimensions(
+              data.getUint16(offset + 5),
+              data.getUint16(offset + 3),
+            )
+            ? 'jpg'
+            : null;
+      }
+      offset += length;
+    }
+  }
+  return null;
+}
