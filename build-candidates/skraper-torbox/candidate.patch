+
+final _png = base64Decode(
+  'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aF1QAAAAASUVORK5CYII=',
+);
+
+class _MemoryDatabase extends Fake implements DatabaseService {
+  final rows = <String, ({String payload, DateTime fetchedAt, bool noMatch})>{};
+  final firstWrite = Completer<void>();
+  int expirations = 0;
+
+  @override
+  Future<({String payload, DateTime fetchedAt, bool noMatch})?>
+  getGameMetadataCache(String key) async => rows[key];
+
+  @override
+  Future<void> putGameMetadataCache({
+    required String key,
+    required String payload,
+    required bool noMatch,
+  }) async {
+    rows[key] = (payload: payload, fetchedAt: DateTime.now(), noMatch: noMatch);
+    if (!firstWrite.isCompleted) firstWrite.complete();
+  }
+
+  @override
+  Future<void> expireGameMetadataCache({
+    required DateTime fetchedBefore,
+  }) async {
+    expirations++;
+  }
+}
+
+class _RemoteProvider extends GameMetadataProvider {
+  _RemoteProvider(this.result);
+  final Future<MetadataResult> Function() result;
+  final started = Completer<void>();
+  int calls = 0;
+
+  @override
+  MetadataProviderInfo get info =>
+      const MetadataProviderInfo(id: 'test_remote', name: 'Remote fixture');
+  @override
+  List<CredentialField> get credentialFields => const [];
+  @override
+  Future<String?> validateCredentials(Map<String, String> creds) async => null;
+  @override
+  Future<MetadataResult> fetch({
+    required String title,
+    required String platform,
+    required Map<String, String> creds,
+  }) {
+    calls++;
+    if (!started.isCompleted) started.complete();
+    return result();
+  }
+}
+
+RomEntry _entry(String title, {String platform = 'snes'}) => RomEntry(
+  slug: '$platform:$title',
+  title: title,
+  platform: platform,
+  regions: const ['us'],
+  links: const [],
+);
+
+void main() {
+  late Directory directory;
+  late Directory source;
+  late SkraperImportService imports;
+
+  setUp(() async {
+    directory = await Directory.systemTemp.createTemp('nomrom-import-overlay-');
+    source = await Directory(p.join(directory.path, 'source')).create();
+    imports = SkraperImportService(
+      rootDirectory: Directory(p.join(directory.path, 'owned')),
+    );
+  });
+
+  tearDown(() async {
+    await directory.delete(recursive: true);
+  });
+
+  Future<void> importGames([String? entries]) async {
+    await File(p.join(source.path, 'cover.png')).writeAsBytes(_png);
+    final file = await File(p.join(source.path, 'gamelist.xml')).writeAsString(
+      '<gameList>${entries ?? '<game><path>Game (USA).sfc</path>'
+              '<name>Game</name><desc>My local imported description</desc>'
+              '<boxart>cover.png</boxart></game>'}</gameList>',
+    );
+    await imports.importPreview(
+      await imports.previewFile(file.path, platform: 'snes'),
+    );
+  }
+
+  GameMetadataService createMetadata({
+    required _MemoryDatabase db,
+    List<GameMetadataProvider> providers = const [],
+  }) {
+    final service = GameMetadataService(
+      db: db,
+      registry: MetadataProviderRegistry(providers: providers),
+      storage: InMemorySecureStorage({}),
+      skraperImports: imports,
+    );
+    addTearDown(service.dispose);
+    return service;
+  }
+
+  test(
+    'local facts and covers return while a remote lookup is still blocked',
+    () async {
+      await importGames();
+      final remote = Completer<MetadataResult>();
+      addTearDown(() {
+        if (!remote.isCompleted) remote.complete(const MetadataNoMatch());
+      });
+      final provider = _RemoteProvider(() => remote.future);
+      final db = _MemoryDatabase();
+      final service = createMetadata(db: db, providers: [provider]);
+      final result = await service
+          .getMetadata(_entry('Game (Europe)'))
+          .timeout(const Duration(seconds: 1));
+
+      expect(result?.description, 'My local imported description');
+      expect(result?.coverUrls.single, startsWith('nomrom-skraper://artwork/'));
+      await provider.started.future.timeout(const Duration(seconds: 1));
+      expect(provider.calls, 1);
+      expect(remote.isCompleted, isFalse);
+      expect(db.rows, isEmpty);
+      remote.complete(const MetadataError('Offline fixture'));
+    },
+  );
+
+  test(
+    'remote cache excludes local fields and clearing exposes remote metadata immediately',
+    () async {
+      await importGames();
+      final db = _MemoryDatabase();
+      final provider = _RemoteProvider(
+        () async => const MetadataFound(
+          description: 'Remote description',
+          developer: 'Remote developer',
+          coverUrls: ['https://art.invalid/remote-cover.png'],
+          sourceName: 'Remote fixture',
+        ),
+      );
+      final service = createMetadata(db: db, providers: [provider]);
+      final entry = _entry('Game');
+      await service.getMetadata(entry);
+      await db.firstWrite.future.timeout(const Duration(seconds: 1));
+      final withOverlay = await service.getMetadata(entry);
+      expect(withOverlay?.description, 'My local imported description');
+      expect(withOverlay?.developer, 'Remote developer');
+      expect(withOverlay?.coverUrls.first, startsWith('nomrom-skraper://'));
+
+      final payload = db.rows[GameMetadataService.cacheKeyFor(entry)]!.payload;
+      expect(payload, contains('Remote description'));
+      expect(payload, isNot(contains('My local imported description')));
+      expect(payload, isNot(contains('nomrom-skraper:')));
+      expect(payload, isNot(contains(source.path)));
+
+      final update = service.updates.firstWhere(
+        (key) => key == GameMetadataService.cacheKeyFor(entry),
+      );
+      await imports.clearImports();
+      await service.refreshLocalImports();
+      await update.timeout(const Duration(seconds: 1));
+      final cleared = await service.getMetadata(entry);
+      expect(cleared?.description, 'Remote description');
+      expect(cleared?.coverUrls, ['https://art.invalid/remote-cover.png']);
+      expect(db.expirations, 0);
+      expect(provider.calls, 1);
+    },
+  );
+
+  test(
+    'clearing a purely local result removes it without storing a long-lived cache hit',
+    () async {
+      await importGames();
+      final db = _MemoryDatabase();
+      final service = createMetadata(db: db);
+      final entry = _entry('Game');
+      expect(
+        (await service.getMetadata(entry))?.description,
+        'My local imported description',
+      );
+      expect(db.rows, isEmpty);
+      await imports.clearImports();
+      await service.refreshLocalImports();
+      expect(await service.getMetadata(entry), isNull);
+      expect(db.rows, isEmpty);
+    },
+  );
+
+  test(
+    'original titles keep local demo and retail results apart despite shared remote cache keys',
+    () async {
+      await importGames('''
+      <game><path>Game.sfc</path><name>Game</name><desc>Retail result</desc></game>
+      <game><path>Game (Demo).sfc</path><name>Game</name><desc>Demo result</desc></game>
+    ''');
+      final service = createMetadata(db: _MemoryDatabase());
+      final retail = _entry('Game');
+      final demo = _entry('Game (Demo)');
+      expect(
+        GameMetadataService.cacheKeyFor(retail),
+        GameMetadataService.cacheKeyFor(demo),
+      );
+      expect((await service.getMetadata(retail))?.description, 'Retail result');
+      expect((await service.getMetadata(demo))?.description, 'Demo result');
+      expect(
+        await service.getMetadata(_entry('Game', platform: 'nes')),
+        isNull,
+      );
+      expect((await service.getMetadata(retail))?.description, 'Retail result');
+    },
+  );
+
+  test(
+    'artwork cache reads owned custom URIs without any HTTP request',
+    () async {
+      await importGames();
+      final metadata = await imports.lookup(title: 'Game', platform: 'snes');
+      final uri = metadata!.coverUrls.single;
+      await source.delete(recursive: true);
+      final requests = <String>[];
+      var localResolutions = 0;
+      final cache = ArtworkCacheManager(
+        Config(
+          'skraper-local-artwork-test',
+          repo: NonStoringObjectProvider(),
+          fileSystem: MemoryCacheSystem(),
+          fileService: ArtworkFileService(
+            client: MockClient((request) async {
+              requests.add(request.url.toString());
+              throw const HttpException(
+                'No network is allowed in this fixture.',
+              );
+            }),
+            localArtwork: (value) {
+              localResolutions++;
+              return imports.resolveArtwork(value);
+            },
+          ),
+        ),
+      );
+      addTearDown(cache.dispose);
+      final first = await cache.getSingleFile(uri);
+      expect(await first.readAsBytes(), _png);
+      final cached = await cache.getSingleFile(uri);
+      expect(await cached.readAsBytes(), _png);
+      expect(localResolutions, 1);
+      expect(requests, isEmpty);
