+const _summary = SkraperImportSummary(importedGames: 2, importedArtwork: 2);
+
+class _Backend implements SkraperImportBackend {
+  int games = 0;
+  int images = 0;
+  int previewCalls = 0;
+  int importCalls = 0;
+  int clearCalls = 0;
+  final requestedPlatforms = <String>[];
+  final requestedRoles = <SkraperImageRole>[];
+  final requestedMediaRoots = <String?>[];
+  Object? previewError;
+  Object? importError;
+  SkraperImportSummary summary = _summary;
+  SkraperImportPreview? preview;
+  Completer<SkraperImportPreview>? previewGate;
+  Completer<SkraperImportSummary>? importGate;
+
+  @override
+  Future<SkraperImportPreview> previewFile(
+    String path, {
+    required String platform,
+    SkraperImageRole imageRole = SkraperImageRole.artwork,
+    String? mediaRoot,
+  }) async {
+    previewCalls++;
+    requestedPlatforms.add(platform);
+    requestedRoles.add(imageRole);
+    requestedMediaRoots.add(mediaRoot);
+    if (previewError case final error?) throw error;
+    if (previewGate case final gate?) return gate.future;
+    return preview ?? _preview(imageRole: imageRole);
+  }
+
+  @override
+  Future<SkraperImportSummary> importPreview(
+    SkraperImportPreview preview,
+  ) async {
+    importCalls++;
+    if (importError case final error?) throw error;
+    final result = await (importGate?.future ?? Future.value(summary));
+    games += result.importedGames;
+    images += result.importedArtwork;
+    return result;
+  }
+
+  @override
+  Future<SkraperImportStatus> getStatus() async => SkraperImportStatus(
+    gameCount: games,
+    artworkCount: images,
+    platforms: {'nes': games},
+  );
+
+  @override
+  Future<void> clearImports() async {
+    clearCalls++;
+    games = 0;
+    images = 0;
+  }
+}
