+++ b/lib/widgets/skraper_import_backend.dart
@@ -0,0 +1,54 @@
+import '../services/skraper/skraper_import_service.dart';
+
+/// The import UI depends on this small interface so dialogs can be exercised
+/// without accessing a user's files or platform file picker.
+abstract interface class SkraperImportBackend {
+  Future<SkraperImportPreview> previewFile(
+    String path, {
+    required String platform,
+    SkraperImageRole imageRole = SkraperImageRole.artwork,
+    String? mediaRoot,
+  });
+
+  Future<SkraperImportSummary> importPreview(SkraperImportPreview preview);
+  Future<SkraperImportStatus> getStatus();
+  Future<void> clearImports();
+}
+
+class LocalSkraperImportBackend implements SkraperImportBackend {
+  LocalSkraperImportBackend({SkraperImportService? service})
+    : _service = service ?? SkraperImportService();
+
+  final SkraperImportService _service;
+
+  @override
+  Future<SkraperImportPreview> previewFile(
+    String path, {
+    required String platform,
+    SkraperImageRole imageRole = SkraperImageRole.artwork,
+    String? mediaRoot,
+  }) => _service.previewFile(
+    path,
+    platform: platform,
+    imageRole: imageRole,
+    mediaRoot: mediaRoot,
+  );
+
+  @override
+  Future<SkraperImportSummary> importPreview(SkraperImportPreview preview) =>
+      _service.importPreview(preview);
+
+  @override
+  Future<SkraperImportStatus> getStatus() => _service.getStatus();
+
+  @override
+  Future<void> clearImports() => _service.clearImports();
+}
+
+String skraperImportError(Object error, {required String fallback}) {
+  if (error is FormatException) {
+    final message = error.message.trim();
+    if (message.isNotEmpty && message.length <= 400) return message;
+  }
+  return fallback;
+}
