+  platform: 'nes',
+  imageRole: imageRole,
+  issues: issues,
+  items: [
+    for (var index = 0; index < gameCount; index++)
+      SkraperPreviewItem(
+        title: 'Game ${index + 1}',
+        romFilename: 'Game ${index + 1}.nes',
+        artworkCount: 1,
+        coverCount: imageRole == SkraperImageRole.cover ? 1 : 0,
+        screenshotCount: imageRole == SkraperImageRole.screenshot ? 1 : 0,
+      ),
+  ],
+);
