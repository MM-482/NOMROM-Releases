+  static Future<_SourceImage> _readSourceImage(
+    String reference, {
+    required String sourceDirectory,
+    required String allowedRoot,
+    required bool allowAbsolute,
+  }) async {
+    if (reference.length > 4096 || reference.contains('\u0000')) {
+      throw const FormatException('The artwork path is invalid.');
+    }
+    final normalized = reference.replaceAll('\\', '/');
+    if (normalized.startsWith('//') ||
+        RegExp(r'^[a-zA-Z][a-zA-Z0-9+.-]*:').hasMatch(normalized) &&
+            !RegExp(r'^[a-zA-Z]:/').hasMatch(normalized)) {
+      throw const FormatException(
+        'Remote artwork and file URLs are not imported.',
+      );
+    }
+    final absolute =
+        p.isAbsolute(normalized) || p.windows.isAbsolute(normalized);
+    if (absolute && !allowAbsolute) {
+      throw const FormatException(
+        'Absolute artwork paths need an explicitly selected media folder.',
+      );
+    }
+    if (p.windows.isAbsolute(normalized) && !p.isAbsolute(normalized)) {
+      throw const FormatException(
+        'The artwork path belongs to a different operating system.',
+      );
+    }
+    final path = p.normalize(
+      absolute ? normalized : p.join(sourceDirectory, normalized),
+    );
+    if (!p.isWithin(allowedRoot, path)) {
+      throw const FormatException(
+        'Artwork outside the selected media folder was skipped.',
+      );
+    }
+    final file = File(path);
+    final canonical = await file.resolveSymbolicLinks();
+    if (!p.isWithin(allowedRoot, canonical)) {
+      throw const FormatException(
+        'An artwork link points outside the selected media folder.',
+      );
+    }
+    if ((await file.stat()).type != FileSystemEntityType.file) {
+      throw const FormatException('The artwork is not a regular file.');
+    }
+    final bytes = await _limitedImageRead(file);
+    final extension = _imageExtension(bytes);
+    if (extension == null) {
+      throw const FormatException(
+        'Only valid PNG, JPEG, WebP, or GIF artwork up to 20 MB is supported.',
+      );
+    }
+    final digest = sha256.convert(bytes).toString();
+    return _SourceImage(
+      canonical,
+      allowedRoot,
+      digest,
+      extension,
+      bytes.length,
+    );
+  }
+
+  static Future<Uint8List> _limitedImageRead(File file) async {
+    final size = await file.length();
+    if (size <= 0 || size > maxImageBytes) {
+      throw const FormatException('Artwork exceeds the 20 MB image limit.');
+    }
+    return _boundedRead(
+      file,
+      maxImageBytes,
+      'Artwork exceeds the 20 MB image limit.',
+    );
+  }
+
+  static Future<Uint8List> _boundedRead(
+    File file,
+    int limit,
+    String message,
+  ) async {
+    // The read itself is capped even if a selected file grows after stat().
+    final builder = BytesBuilder(copy: false);
+    await for (final chunk in file.openRead(0, limit + 1)) {
+      if (builder.length + chunk.length > limit) {
+        throw FormatException(message);
+      }
+      builder.add(chunk);
+    }
+    return builder.takeBytes();
+  }
+
+  static String _artUri(String filename) =>
+      'nomrom-skraper://artwork/$filename';
+
+  static String? _artFilename(String value) {
+    final uri = Uri.tryParse(value);
+    if (uri == null ||
+        uri.scheme != 'nomrom-skraper' ||
+        uri.host != 'artwork' ||
+        uri.userInfo.isNotEmpty ||
+        uri.hasPort ||
+        uri.hasQuery ||
+        uri.hasFragment ||
+        uri.pathSegments.length != 1) {
+      return null;
+    }
+    final name = uri.pathSegments.single;
+    return _artName.hasMatch(name) && uri.path == '/$name' ? name : null;
+  }
+}
