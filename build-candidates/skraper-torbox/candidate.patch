+  final summary = _providerFileSummary(files);
+  final checks = <DebridDiagnosticCheck, bool>{
+    DebridDiagnosticCheck.torrentIdentityValidated: true,
+    DebridDiagnosticCheck.catalogProofAvailable:
+        proof != null && _proofMatchesRequest(proof, request),
+    DebridDiagnosticCheck.providerFileIdsUnique: summary.idsUnique,
+    if (proof != null) ...{
+      DebridDiagnosticCheck.collectionFileCountMatches:
+          files.length == proof.fileCount &&
+          files.every((file) => file is Map<String, dynamic>),
+      DebridDiagnosticCheck.collectionTotalSizeMatches:
+          summary.totalSize == proof.totalSize &&
+          _proofInteger(torrent['size']) == proof.totalSize,
+      DebridDiagnosticCheck.catalogNameAndSizeUnique: proof.uniqueFilename,
+    },
