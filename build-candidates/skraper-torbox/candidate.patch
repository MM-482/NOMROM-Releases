@@ -0,0 +1,404 @@
+import 'dart:async';
+
+import 'package:file_picker/file_picker.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../providers/metadata_provider.dart';
+import '../services/metadata/metadata_provider.dart';
+import '../services/metadata/screenscraper_systems.dart';
+import '../services/skraper/rom_identity_service.dart';
+import '../services/skraper/rom_lookup_result.dart';
+import '../utils/platform_names.dart';
+
+typedef IdentifyRomFile = Future<RomFileIdentity> Function(
+  String path, {
+  void Function(int read, int total)? onProgress,
+  bool Function()? isCancelled,
+});
+
+Future<void> showRomIdentificationDialog(BuildContext context, WidgetRef ref) {
+  final metadata = ref.read(gameMetadataServiceProvider);
+  return showDialog<void>(
+    context: context,
+    builder: (_) => RomIdentificationDialog(
+      lookup: metadata.identifyLocalRom,
+      checkLookupSetup: metadata.romIdentificationSetupError,
+    ),
+  );
+}
+
+/// An explicit one-file tool. Computing fingerprints needs no account, and
+/// only pressing Look up game can submit identifiers to ScreenScraper.
+class RomIdentificationDialog extends StatefulWidget {
+  const RomIdentificationDialog({
+    super.key,
+    required this.lookup,
+    this.checkLookupSetup,
+    this.pickFile,
+    this.identifyFile,
+  });
+
+  final Future<RomLookupResult> Function(RomFileIdentity, String) lookup;
+  final Future<String?> Function()? checkLookupSetup;
+  final Future<String?> Function()? pickFile;
+  final IdentifyRomFile? identifyFile;
+
+  @override
+  State<RomIdentificationDialog> createState() =>
+      _RomIdentificationDialogState();
+}
+
+class _RomIdentificationDialogState extends State<RomIdentificationDialog> {
+  RomFileIdentity? _identity;
+  RomLookupResult? _result;
+  String? _platform;
+  String? _operation;
+  String? _error;
+  String? _setupError;
+  bool _checkingSetup = false;
+  double _progress = 0;
+  int _generation = 0;
+
+  bool get _busy => _operation != null;
+
+  @override
+  void initState() {
+    super.initState();
+    if (widget.checkLookupSetup != null) {
+      _checkingSetup = true;
+      unawaited(_checkSetup());
+    }
+  }
+
+  Future<void> _checkSetup() async {
+    String? issue;
+    try {
+      issue = await widget.checkLookupSetup!();
+    } catch (_) {
+      issue = 'Could not check your ScreenScraper settings. Reopen this tool to try again.';
+    }
+    if (mounted) {
+      setState(() {
+        _checkingSetup = false;
+        _setupError = issue;
+      });
+    }
+  }
+
+  @override
+  void dispose() {
+    _generation++;
+    super.dispose();
+  }
+
+  Future<String?> _pickFile() async {
+    if (widget.pickFile case final picker?) return picker();
+    final selected = await FilePicker.platform.pickFiles(
+      dialogTitle: 'Choose an extracted ROM or disc image',
+      allowMultiple: false,
+      withData: false,
+      type: FileType.any,
+    );
+    return selected?.files.single.path;
+  }
+
+  Future<void> _chooseFile() async {
+    if (_busy) return;
+    final generation = ++_generation;
+    bool cancelled() => !mounted || generation != _generation;
+    setState(() {
+      _operation = 'choose';
+      _error = null;
+    });
+    try {
+      final path = await _pickFile();
+      if (path == null || cancelled()) return;
+      setState(() {
+        _operation = 'hash';
+        _identity = null;
+        _result = null;
+        _progress = 0;
+      });
+      final clock = Stopwatch()..start();
+      var lastUpdate = -100;
+      final identify = widget.identifyFile ?? RomIdentityService().identifyFile;
+      final identity = await identify(
+        path,
+        isCancelled: cancelled,
+        onProgress: (read, total) {
+          if (cancelled()) return;
+          if (read != total && clock.elapsedMilliseconds - lastUpdate < 80) {
+            return;
+          }
+          lastUpdate = clock.elapsedMilliseconds;
+          setState(
+            () => _progress = total == 0 ? 0 : (read / total).clamp(0.0, 1.0),
+          );
+        },
+      );
+      if (!cancelled()) setState(() => _identity = identity);
+    } on RomIdentificationCancelled {
+      // Closing or cancelling the tool intentionally discards this result.
+    } on RomIdentificationException catch (error) {
+      if (!cancelled()) setState(() => _error = error.message);
+    } catch (_) {
+      if (!cancelled()) {
+        setState(
+          () => _error = 'Could not read this file. Check that it exists and its download has finished.',
+        );
+      }
+    } finally {
+      if (!cancelled()) setState(() => _operation = null);
+    }
+  }
+
+  void _cancelHashing() {
+    if (_operation != 'hash') return;
+    _generation++;
+    setState(() {
+      _operation = null;
+      _progress = 0;
+    });
+  }
+
+  Future<void> _lookup() async {
+    final identity = _identity;
+    final platform = _platform;
+    if (_busy || identity == null || platform == null || _setupError != null) {
+      return;
+    }
+    final generation = ++_generation;
+    setState(() {
+      _operation = 'lookup';
+      _error = null;
+      _result = null;
+    });
+    try {
+      final result = await widget.lookup(identity, platform);
+      if (mounted && generation == _generation) {
+        setState(() => _result = result);
+      }
+    } catch (_) {
+      if (mounted && generation == _generation) {
+        setState(
+          () => _error = 'The game lookup could not finish. Try again later.',
+        );
+      }
+    } finally {
+      if (mounted && generation == _generation) {
+        setState(() => _operation = null);
+      }
+    }
+  }
+
+  Future<void> _copyIdentity() async {
+    final identity = _identity;
+    if (identity == null) return;
+    await Clipboard.setData(
+      ClipboardData(
+        text:
+            '${identity.filename}\n'
+            'Size: ${identity.size} bytes\n'
+            'CRC32: ${identity.crc32}\n'
+            'MD5: ${identity.md5}\n'
+            'SHA-1: ${identity.sha1}',
+      ),
+    );
+  }
+
+  Widget _lookupResult(RomLookupResult result) {
+    switch (result.metadata) {
+      case MetadataError(:final message):
+        return Text(message, key: const ValueKey('rom-lookup-error'));
+      case MetadataNoMatch():
+        return const Text(
+          'No verified match was found for this file and platform. '
+          'Check the platform and try the extracted ROM data file.',
+          key: ValueKey('rom-lookup-no-match'),
+        );
+      case MetadataFound metadata:
+        return Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Text(
+              result.title ?? 'Matched game',
+              key: const ValueKey('rom-lookup-title'),
+              style: Theme.of(context).textTheme.titleMedium,
+            ),
+            if (result.checksumVerified) const Text('ROM checksum verified'),
+            if (metadata.developer != null)
+              Text('Developer: ${metadata.developer}'),
+            if (metadata.publisher != null)
+              Text('Publisher: ${metadata.publisher}'),
+            if (metadata.releaseDate != null)
+              Text('Released: ${metadata.releaseDate}'),
+            if (metadata.genre != null) Text('Genre: ${metadata.genre}'),
+            if (metadata.players != null) Text('Players: ${metadata.players}'),
+            if (metadata.description != null) ...[
+              const SizedBox(height: 8),
+              Text(metadata.description!),
+            ],
+            const SizedBox(height: 8),
+            const Text(
+              'Identification result only. Your files and catalog are unchanged.',
+            ),
+          ],
+        );
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final identity = _identity;
+    final platforms = screenScraperSystemIds.keys.toList()
+      ..sort(
+        (a, b) =>
+            PlatformNames.getDisplayName(a)
+                .compareTo(PlatformNames.getDisplayName(b)),
+      );
+    return AlertDialog(
+      title: const Text('Identify a local ROM'),
+      content: SizedBox(
+        width: 600,
+        child: SingleChildScrollView(
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            children: [
+              const Text(
+                'Choose one extracted ROM or disc image. CRC32, MD5 and SHA-1 '
+                'fingerprints are calculated on this computer.',
+              ),
+              const SizedBox(height: 12),
+              Align(
+                alignment: Alignment.centerLeft,
+                child: OutlinedButton.icon(
+                  key: const ValueKey('rom-choose-file'),
+                  onPressed: _busy ? null : _chooseFile,
+                  icon: const Icon(Icons.file_open_outlined),
+                  label: const Text('Choose ROM file'),
+                ),
+              ),
+              if (_operation == 'hash') ...[
+                const SizedBox(height: 12),
+                LinearProgressIndicator(value: _progress),
+                Row(
+                  children: [
+                    Expanded(
+                      child: Text('Reading ROM… ${(_progress * 100).round()}%'),
+                    ),
+                    TextButton(
+                      onPressed: _cancelHashing,
+                      child: const Text('Cancel reading'),
+                    ),
+                  ],
+                ),
+              ],
+              if (_error != null) ...[
+                const SizedBox(height: 12),
+                Text(_error!, key: const ValueKey('rom-identify-error')),
+              ],
+              if (identity != null) ...[
+                const SizedBox(height: 12),
+                SelectableText(
+                  '${identity.filename}\n'
+                  '${identity.size} bytes\n\n'
+                  'CRC32  ${identity.crc32}\n'
+                  'MD5     ${identity.md5}\n'
+                  'SHA-1   ${identity.sha1}',
+                  key: const ValueKey('rom-fingerprints'),
+                ),
+                Align(
+                  alignment: Alignment.centerLeft,
+                  child: TextButton.icon(
+                    onPressed: _copyIdentity,
+                    icon: const Icon(Icons.copy_outlined, size: 18),
+                    label: const Text('Copy fingerprints'),
+                  ),
+                ),
+              ],
+              const SizedBox(height: 20),
+              Text(
+                'Optional online match',
+                style: Theme.of(context).textTheme.titleSmall,
+              ),
+              const SizedBox(height: 8),
+              const Text(
+                'ScreenScraper receives the filename, file size, platform and '
+                'fingerprints when you choose Look up game. ROM bytes stay on '
+                'this computer. A supported platform and configured '
+                'ScreenScraper account are required.',
+              ),
+              const SizedBox(height: 12),
+              DropdownButtonFormField<String>(
+                key: const ValueKey('rom-platform'),
+                initialValue: _platform,
+                isExpanded: true,
+                menuMaxHeight: 280,
+                decoration: const InputDecoration(
+                  labelText: 'Platform',
+                  border: OutlineInputBorder(),
+                ),
+                hint: const Text('Choose the ROM’s platform'),
+                items: [
+                  for (final platform in platforms)
+                    DropdownMenuItem(
+                      value: platform,
+                      child: Text(PlatformNames.getDisplayName(platform)),
+                    ),
+                ],
+                onChanged: _busy
+                    ? null
+                    : (value) => setState(() {
+                        _platform = value;
+                        _result = null;
+                      }),
+              ),
+              if (_checkingSetup) ...[
+                const SizedBox(height: 12),
+                const Text('Checking saved ScreenScraper settings…'),
+              ],
+              if (_setupError != null) ...[
+                const SizedBox(height: 12),
+                Text(_setupError!, key: const ValueKey('rom-setup-error')),
+              ],
+              const SizedBox(height: 12),
+              Align(
+                alignment: Alignment.centerLeft,
+                child: FilledButton.icon(
+                  key: const ValueKey('rom-lookup'),
+                  onPressed:
+                      _busy ||
+                          _checkingSetup ||
+                          _setupError != null ||
+                          identity == null ||
+                          _platform == null
+                      ? null
+                      : _lookup,
+                  icon: const Icon(Icons.search),
+                  label: Text(
+                    _operation == 'lookup'
+                        ? 'Looking up game…'
+                        : 'Look up game',
+                  ),
+                ),
+              ),
+              if (_result != null) ...[
+                const Divider(height: 28),
+                _lookupResult(_result!),
+              ],
+            ],
+          ),
+        ),
+      ),
+      actions: [
+        TextButton(
+          onPressed: () => Navigator.pop(context),
+          child: const Text('Close'),
+        ),
+      ],
+    );
+  }
+}
diff --git a/lib/widgets/skraper_import_backend.dart b/lib/widgets/skraper_import_backend.dart
new file mode 100644
--- /dev/null
+++ b/lib/widgets/skraper_import_backend.dart
@@ -0,0 +1,54 @@
+import '../services/skraper/skraper_import_service.dart';
+
+/// The import UI depends on this small interface so dialogs can be exercised
+/// without accessing a user's files or platform file picker.
+abstract interface class SkraperImportBackend {
+  Future<SkraperImportPreview> previewFile(
+    String path, {
+    required String platform,
+    SkraperImageRole imageRole = SkraperImageRole.artwork,
+    String? mediaRoot,
+  });
+
+  Future<SkraperImportSummary> importPreview(SkraperImportPreview preview);
+  Future<SkraperImportStatus> getStatus();
+  Future<void> clearImports();
+}
+
+class LocalSkraperImportBackend implements SkraperImportBackend {
+  LocalSkraperImportBackend({SkraperImportService? service})
+    : _service = service ?? SkraperImportService();
+
+  final SkraperImportService _service;
+
+  @override
+  Future<SkraperImportPreview> previewFile(
+    String path, {
+    required String platform,
+    SkraperImageRole imageRole = SkraperImageRole.artwork,
+    String? mediaRoot,
+  }) => _service.previewFile(
+    path,
+    platform: platform,
+    imageRole: imageRole,
+    mediaRoot: mediaRoot,
+  );
+
+  @override
+  Future<SkraperImportSummary> importPreview(SkraperImportPreview preview) =>
+      _service.importPreview(preview);
+
+  @override
+  Future<SkraperImportStatus> getStatus() => _service.getStatus();
+
+  @override
+  Future<void> clearImports() => _service.clearImports();
+}
+
+String skraperImportError(Object error, {required String fallback}) {
+  if (error is FormatException) {
+    final message = error.message.trim();
+    if (message.isNotEmpty && message.length <= 400) return message;
+  }
+  return fallback;
+}
