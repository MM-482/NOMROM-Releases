+Map<String, dynamic>? _collectionZipFile(
+  List<dynamic> files,
+  DebridFileRequest request,
+) {
+  if (files.length != 1 || files.single is! Map<String, dynamic>) return null;
+  final file = files.single as Map<String, dynamic>;
+  if (file['zipped'] != true) return null;
+  final proof = request.selectionProof;
