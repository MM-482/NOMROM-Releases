+import 'package:path/path.dart' as p;
+
+/// One file from the catalog's torrent member list, before validation.
+final class TorrentFileIdentity {
+  const TorrentFileIdentity({
+    required this.index,
+    required this.path,
+    required this.size,
+  });
+
+  final int index;
+  final String path;
+  final int size;
+}
+
+/// Catalog evidence for identifying a file when a provider changes its path.
+///
+/// This does not itself establish that the provider returned the same complete
+/// collection. The provider must independently check its torrent identity,
+/// member count and byte totals before using either uniqueness flag.
+final class TorrentFileSelectionProof {
+  const TorrentFileSelectionProof._({
+    required this.infohash,
+    required this.fileIndex,
+    required this.filePath,
+    required this.expectedSize,
+    required this.fileCount,
+    required this.totalSize,
+    required this.uniqueFilename,
+    required this.uniqueDecodedFilename,
+  });
+
+  final String infohash;
+  final int fileIndex;
+
+  /// Canonical catalog path, without URI decoding.
+  final String filePath;
+  final int expectedSize;
+  final int fileCount;
+  final int totalSize;
+  final bool uniqueFilename;
+  final bool uniqueDecodedFilename;
+
+  /// Returns no proof for incomplete, conflicting or malformed catalog data.
+  static TorrentFileSelectionProof? tryCreate({
+    required String infohash,
+    required int fileIndex,
+    required String filePath,
+    required int expectedSize,
+    required Iterable<TorrentFileIdentity> members,
+  }) {
+    if (!RegExp(r'^[a-fA-F0-9]{40}$').hasMatch(infohash) ||
+        !_boundedInteger(fileIndex) ||
+        !_boundedInteger(expectedSize) ||
+        expectedSize == 0 ||
+        !_safeRelativePath(filePath) ||
+        !_safeRelativePath(filePath, decode: true)) {
+      return null;
+    }
+
+    final selectedPath = normalizeTorrentFilePath(filePath);
+    final byIndex = <int, TorrentFileIdentity>{};
+    var totalSize = 0;
+    for (final member in members) {
+      if (!_boundedInteger(member.index) ||
+          !_boundedInteger(member.size) ||
+          !_safeRelativePath(member.path) ||
+          !_safeRelativePath(member.path, decode: true)) {
+        return null;
+      }
+      final path = normalizeTorrentFilePath(member.path);
+      final previous = byIndex[member.index];
+      if (previous != null) {
+        if (previous.path != path || previous.size != member.size) return null;
+        continue;
+      }
+      if (member.size > _maxExactInteger - totalSize) return null;
+      totalSize += member.size;
+      byIndex[member.index] = TorrentFileIdentity(
+        index: member.index,
+        path: path,
+        size: member.size,
+      );
+    }
+    if (byIndex.isEmpty) return null;
+    for (var index = 0; index < byIndex.length; index++) {
+      if (!byIndex.containsKey(index)) return null;
+    }
+    final selected = byIndex[fileIndex];
+    if (selected == null ||
+        selected.path != selectedPath ||
+        selected.size != expectedSize) {
+      return null;
+    }
+
+    final filename = p.posix.basename(selectedPath);
+    final decodedFilename = p.posix.basename(
+      normalizeTorrentFilePath(filePath, decode: true),
+    );
+    var rawMatches = 0;
+    var decodedMatches = 0;
+    for (final member in byIndex.values) {
+      if (member.size != expectedSize) continue;
+      if (p.posix.basename(member.path) == filename) rawMatches++;
+      if (p.posix.basename(
+            normalizeTorrentFilePath(member.path, decode: true),
+          ) ==
+          decodedFilename) {
+        decodedMatches++;
+      }
+    }
+
+    return TorrentFileSelectionProof._(
+      infohash: infohash.toLowerCase(),
+      fileIndex: fileIndex,
+      filePath: selectedPath,
+      expectedSize: expectedSize,
+      fileCount: byIndex.length,
+      totalSize: totalSize,
+      uniqueFilename: rawMatches == 1,
+      uniqueDecodedFilename: decodedMatches == 1,
+    );
+  }
+}
+
+// Keep integer comparisons exact on every Dart target, including JSON numbers.
+const _maxExactInteger = 9007199254740991;
+
+bool _boundedInteger(int value) => value >= 0 && value <= _maxExactInteger;
+
+bool _safeRelativePath(String value, {bool decode = false}) {
+  if (decode) value = _decodeOnce(value);
+  final path = value.trim().replaceAll('\\', '/');
+  if (path.isEmpty ||
+      path.startsWith('/') ||
+      path.endsWith('/') ||
+      RegExp(r'^[a-zA-Z]:').hasMatch(path) ||
+      RegExp(r'[\x00-\x1f\x7f]').hasMatch(value)) {
+    return false;
+  }
+  final parts = path.split('/');
+  if (parts.contains('..') || parts.last == '.') return false;
+  final canonical = normalizeTorrentFilePath(path);
+  return canonical != '.' && !RegExp(r'^[a-zA-Z]:').hasMatch(canonical);
+}
+
+String _decodeOnce(String value) {
+  try {
+    return Uri.decodeComponent(value);
+  } on FormatException {
+    // A literal '%' or invalid escape remains an ordinary filename.
+    return value;
+  } on ArgumentError {
+    // The VM reports malformed percent escapes as ArgumentError.
+    return value;
+  }
+}
+
+/// Shared catalog/provider comparison, preserving literal '+' characters.
+/// URI decoding is an explicit second pass, never repeated on decoded output.
+String normalizeTorrentFilePath(String value, {bool decode = false}) {
+  if (decode) value = _decodeOnce(value);
+  final normalized = value.trim().replaceAll('\\', '/');
+  if (normalized.isEmpty) return '';
+  return p.posix
+      .normalize(normalized)
+      .replaceFirst(RegExp(r'^(\./|/)+'), '')
+      .toLowerCase();
+}
