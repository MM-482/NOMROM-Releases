+        ('box', SkraperImageRole.cover),
+        ('image', imageRole),
+        ('screenshot', SkraperImageRole.screenshot),
+        ('marquee', SkraperImageRole.artwork),
+        ('thumbnail', SkraperImageRole.artwork),
