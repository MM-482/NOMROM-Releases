+  /// Fast indexed local lookup after the store has loaded once. Ambiguous
+  /// aliases intentionally return no match instead of picking an arbitrary ROM.
+  Future<MetadataFound?> lookup({
+    required String title,
+    required String platform,
+  }) async {
+    await _writes;
+    await _load();
+    final aliases = <String>{_identity(title).key};
+    final stem = _romStem(title);
+    if (stem != title) aliases.add(_identity(stem).key);
+    final owners = <String>{};
+    final platformKey = _platformKey(platform);
+    for (final alias in aliases) {
+      owners.addAll(_aliasIndex['$platformKey\u0000$alias'] ?? const {});
+    }
+    return owners.length == 1 ? _records[owners.single]?.metadata : null;
+  }
+
+  /// Clears the index and only image names referenced by this import store.
+  /// Never removes an input gamelist, source artwork, parent, or sibling folder.
+  Future<void> clearImports() => _serialize(() async {
+    try {
+      await _load();
+    } on FormatException {
+      // A damaged index cannot supply an ownership list for deletion. Replace
+      // only the index and leave any unindexed artwork files alone.
+    }
+    final artwork = _records.values.expand((record) => record.artwork).toSet();
+    await _commit({}, null);
+    for (final uri in artwork) {
+      final file = await resolveArtwork(uri);
+      if (file != null) {
+        try {
+          await file.delete();
+        } on FileSystemException {
+          // An open image may be locked on Windows. It is no longer indexed.
+        }
+      }
+    }
+  });
+
+  /// Resolves only strict content-addressed filenames inside the owned store.
+  /// No source paths or arbitrary file:// URLs can pass this boundary.
+  Future<File?> resolveArtwork(String value) async {
+    final name = _artFilename(value);
+    if (name == null) return null;
+    try {
+      final root = await _directory();
+      final artDirectory = Directory(p.join(root.path, 'artwork'));
+      if (await FileSystemEntity.type(artDirectory.path, followLinks: false) !=
+          FileSystemEntityType.directory) {
+        return null;
+      }
+      final file = File(p.join(artDirectory.path, name));
+      if (await FileSystemEntity.type(file.path, followLinks: false) !=
+          FileSystemEntityType.file) {
+        return null;
+      }
+      final canonicalDirectory = await artDirectory.resolveSymbolicLinks();
+      final canonicalFile = await file.resolveSymbolicLinks();
+      if (!p.isWithin(root.path, canonicalDirectory) ||
+          !p.isWithin(canonicalDirectory, canonicalFile)) {
+        return null;
+      }
+      final size = await file.length();
+      return size > 0 && size <= maxImageBytes ? File(canonicalFile) : null;
+    } on FileSystemException {
+      return null;
+    } on FormatException {
+      return null;
+    }
+  }
+
+  Future<T> _serialize<T>(Future<T> Function() action) {
+    final operation = _writes.then((_) => action());
+    _writes = operation.then<void>(
+      (_) {},
+      onError: (Object _, StackTrace _) {},
+    );
+    return operation;
+  }
+
+  Future<Directory> _directory() async {
+    if (_root != null) return _root!;
+    final root =
+        _rootOverride ??
+        Directory(
+          p.join((await getApplicationSupportDirectory()).path, 'skraper'),
+        );
+    final type = await FileSystemEntity.type(root.path, followLinks: false);
+    if (type != FileSystemEntityType.notFound &&
+        type != FileSystemEntityType.directory) {
+      throw const FormatException(
+        'The local Skraper store is not a regular directory.',
+      );
+    }
+    await root.create(recursive: true);
+    _root = Directory(await root.resolveSymbolicLinks());
+    return _root!;
+  }
+
+  Future<void> _load() {
+    if (_loading != null) return _loading!;
+    late final Future<void> operation;
+    operation = _readIndex().onError((Object error, StackTrace stack) {
+      // A temporary disk/platform-directory failure must remain retryable.
+      // Do not erase a newer successful load or commit that replaced this one.
+      if (identical(_loading, operation)) _loading = null;
+      Error.throwWithStackTrace(error, stack);
+    });
+    _loading = operation;
+    return operation;
+  }
+
+  Future<void> _readIndex() async {
+    final root = await _directory();
+    final index = File(p.join(root.path, 'index.json'));
+    final type = await FileSystemEntity.type(index.path, followLinks: false);
+    if (type == FileSystemEntityType.notFound) return;
+    if (type != FileSystemEntityType.file ||
+        await index.length() > _maxIndexBytes) {
+      throw const FormatException(
+        'The local Skraper index cannot be read safely.',
+      );
+    }
+    try {
+      final content = await _boundedRead(
+        index,
+        _maxIndexBytes,
+        'The local Skraper index exceeds its size limit.',
+      );
+      final decoded = jsonDecode(utf8.decode(content));
+      if (decoded is! Map ||
+          decoded['version'] != 1 ||
+          decoded['games'] is! List) {
+        throw const FormatException();
+      }
+      final entries = decoded['games'] as List;
+      if (entries.length > 100000) throw const FormatException();
+      final records = <String, _Record>{};
+      for (final entry in entries) {
+        final record = _Record.fromJson(entry);
+        records[record.id] = record;
+      }
+      _records = records;
+      _lastImportAt = DateTime.tryParse(
+        decoded['last_import_at'] as String? ?? '',
+      );
+      _reindex();
+    } on Object {
+      throw const FormatException(
+        'The local Skraper index is damaged; clear imports before importing again.',
+      );
+    }
+  }
+
+  Future<void> _commit(
+    Map<String, _Record> records,
+    DateTime? importedAt,
+  ) async {
+    final root = await _directory();
+    final bytes = utf8.encode(
+      jsonEncode({
+        'version': 1,
+        'last_import_at': importedAt?.toIso8601String(),
+        'games': records.values.map((record) => record.toJson()).toList(),
+      }),
+    );
+    if (bytes.length > _maxIndexBytes) {
+      throw const FormatException(
+        'The local Skraper index exceeds its size limit.',
+      );
+    }
+    final index = File(p.join(root.path, 'index.json'));
+    if (await FileSystemEntity.type(index.path, followLinks: false) ==
+        FileSystemEntityType.link) {
+      throw const FormatException(
+        'The local Skraper index cannot be replaced safely.',
+      );
+    }
+    final temporary = File(
+      p.join(root.path, '.index-$pid-${_temporarySequence++}.tmp'),
+    );
+    try {
+      await temporary.writeAsBytes(bytes, flush: true);
+      // Same-directory rename replaces the index as one filesystem operation.
+      // Do not delete the old index as a fallback if the rename fails.
+      await temporary.rename(index.path);
+    } finally {
+      if (await temporary.exists()) await temporary.delete();
+    }
+    _records = records;
+    _lastImportAt = importedAt;
+    _loading = Future.value();
+    _reindex();
+  }
+
+  void _reindex() {
+    final index = <String, Set<String>>{};
+    for (final record in _records.values) {
+      for (final alias in record.aliases) {
+        index
+            .putIfAbsent('${record.platform}\u0000$alias', () => {})
+            .add(record.id);
+      }
+    }
+    _aliasIndex = index;
+  }
+
+  Future<bool> _copyArtwork(_SourceImage image) async {
+    final root = await _directory();
+    final directory = Directory(p.join(root.path, 'artwork'));
+    final type = await FileSystemEntity.type(
+      directory.path,
+      followLinks: false,
+    );
+    if (type != FileSystemEntityType.notFound &&
+        type != FileSystemEntityType.directory) {
+      throw const FormatException(
+        'The local artwork store is not a regular directory.',
+      );
+    }
+    await directory.create();
+    if (!p.isWithin(root.path, await directory.resolveSymbolicLinks())) {
+      throw const FormatException(
+        'The local artwork directory is outside the import store.',
+      );
+    }
+    final target = File(p.join(directory.path, image.filename));
+    final targetType = await FileSystemEntity.type(
+      target.path,
+      followLinks: false,
+    );
+    if (targetType != FileSystemEntityType.notFound) {
+      if (targetType != FileSystemEntityType.file) {
+        throw const FormatException(
+          'An artwork destination is not a regular file.',
+        );
+      }
+      final bytes = await _limitedImageRead(target);
+      if (sha256.convert(bytes).toString() != image.digest) {
+        throw const FormatException(
+          'An existing artwork copy failed its checksum check.',
+        );
+      }
+      return false;
+    }
+    final source = File(image.path);
+    final canonical = await source.resolveSymbolicLinks();
+    if (!p.isWithin(image.allowedRoot, canonical)) {
+      throw const FormatException('Artwork moved outside the selected folder.');
+    }
+    final bytes = await _limitedImageRead(source);
+    if (sha256.convert(bytes).toString() != image.digest) {
+      throw const FormatException(
+        'Artwork changed after preview; preview it again.',
+      );
+    }
+    final temporary = File(
+      p.join(directory.path, '.art-$pid-${_temporarySequence++}.tmp'),
+    );
+    try {
+      await temporary.writeAsBytes(bytes, flush: true);
+      await temporary.rename(target.path);
+    } finally {
+      if (await temporary.exists()) await temporary.delete();
+    }
+    return true;
+  }
