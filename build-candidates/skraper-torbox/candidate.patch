+import 'dart:async';
+import 'dart:io';
+
+import 'package:dio/dio.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:romgi/models/models.dart';
+import 'package:romgi/services/debrid/debrid_provider.dart';
+import 'package:romgi/services/debrid_service.dart';
+import 'package:romgi/services/download_service.dart';
+import 'package:romgi/services/host_adapter.dart';
+import 'package:romgi/services/link_resolver.dart';
+
+import '../download_integrity_test.dart' as fixture;
+import 'debrid_test_utils.dart';
+
+class _ControlledDebrid extends Fake implements DebridService {
+  final failures = <String, DebridError>{};
+  final started = <String, Completer<void>>{};
+  final release = <String, Completer<void>>{};
+  final calls = <String, int>{};
+  final progress = <String, double>{};
+  final ignoreCancellation = <String>{};
+  final cachingCallbacks = <String, void Function(DebridCaching)>{};
+  final failureCallbacks = <String, void Function(DebridError)>{};
+  Completer<void>? configurationGate;
+  final configurationStarted = Completer<void>();
+
+  void plan(String name, DebridError failure) {
+    failures[name] = failure;
+    started[name] = Completer<void>();
+    release[name] = Completer<void>();
+  }
+
+  @override
+  Future<bool> isConfigured({String? providerId}) async {
+    final gate = configurationGate;
+    if (gate != null) {
+      if (!configurationStarted.isCompleted) configurationStarted.complete();
+      await gate.future;
+    }
+    return true;
+  }
+
+  @override
+  Future<DownloadLink?> resolveTorrentLink(
+    DownloadLink link, {
+    void Function(DebridCaching status)? onCaching,
+    void Function(DebridError failure)? onFailure,
+    bool Function()? isCancelled,
+    Duration overallTimeout = const Duration(minutes: 3),
+    Duration pollInterval = const Duration(seconds: 2),
+  }) async {
+    final name = link.filename;
+    final failure = failures[name]!;
+    final gate = release[name]!;
+    calls.update(name, (value) => value + 1, ifAbsent: () => 1);
+    if (onCaching != null) cachingCallbacks[name] = onCaching;
+    if (onFailure != null) failureCallbacks[name] = onFailure;
+    if (progress[name] != null) {
+      onCaching?.call(DebridCaching(progress: progress[name]));
+    }
+    started[name]!.complete();
+    await gate.future;
+    if (ignoreCancellation.contains(name) || !(isCancelled?.call() ?? false)) {
+      onFailure?.call(failure);
+    }
+    return null;
+  }
+}
+
+class _Database extends fixture.FakeDatabaseService {
+  Completer<void>? pausedWriteGate;
+  final pausedWriteStarted = Completer<void>();
+
+  @override
+  Future<void> updateDownload(DownloadTask task) async {
+    if (task.waitingForDebrid && pausedWriteGate != null) {
+      if (!pausedWriteStarted.isCompleted) pausedWriteStarted.complete();
+      await pausedWriteGate!.future;
+    }
+    await super.updateDownload(task);
+  }
+}
+
+class _Torrents extends fixture.RecordingTorrentService {
+  int cancellations = 0;
+
+  @override
+  Future<void> cancel(String infohash) async {
+    cancellations++;
+  }
+
+  @override
+  Future<void> pauseAll() async {}
+
+  @override
+  Future<void> resumeAll() async {}
+}
+
+const _cachingTimeout = DebridError(
+  'TorBox is still preparing this torrent.',
+  code: 'CACHING_TIMEOUT',
+);
+
+DownloadTask _task(String id) => DownloadTask(
+  id: id,
+  slug: id,
+  title: id,
+  platform: 'psx',
+  createdAt: DateTime(2026),
+  link: DownloadLink(
+    name: id,
+    type: 'Game',
+    format: 'rom',
+    url: '',
+    filename: '$id.rom',
+    host: 'MiNERVA',
+    size: 1000,
+    sizeStr: '1000',
+    sourceUrl: '',
+    torrentInfohash: 'abcdef0123456789abcdef0123456789abcdef01',
+    torrentFileIndex: 0,
+    torrentFilePath: '$id.rom',
+  ),
+);
+
+Future<void> _until(bool Function() condition) async {
+  final end = DateTime.now().add(const Duration(seconds: 3));
+  while (!condition()) {
+    if (DateTime.now().isAfter(end)) fail('Download fixture did not settle');
+    await Future<void>.delayed(const Duration(milliseconds: 5));
+  }
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  late Directory temp;
+  late _Database db;
+  late _Torrents torrents;
+  late _ControlledDebrid debrid;
