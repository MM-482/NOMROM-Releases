+import '../metadata/metadata_provider.dart';
+import 'skraper_import_service.dart';
+
+/// Supplies only user-imported local results. No account, executable, or remote
+/// ScreenScraper application credentials are needed by this provider.
+class SkraperMetadataProvider extends GameMetadataProvider {
+  SkraperMetadataProvider({SkraperImportService? service})
+    : _service = service ?? SkraperImportService();
+
+  final SkraperImportService _service;
+
+  @override
+  MetadataProviderInfo get info =>
+      const MetadataProviderInfo(id: 'skraper_local', name: 'Skraper imports');
+
+  @override
+  List<CredentialField> get credentialFields => const [];
+
+  @override
+  String? get setupHelp =>
+      'Import an existing Skraper gamelist and its local artwork.';
+
+  @override
+  Future<String?> validateCredentials(Map<String, String> creds) async => null;
+
+  @override
+  Future<MetadataResult> fetch({
+    required String title,
+    required String platform,
+    required Map<String, String> creds,
+  }) async {
+    try {
+      return await _service.lookup(title: title, platform: platform) ??
+          const MetadataNoMatch();
+    } on Object {
+      return const MetadataError(
+        'Local Skraper imports are unavailable. Review them in Settings.',
+      );
+    }
+  }
+
+  @override
+  Stream<MetadataResult> fetchUpdatesWithContext({
+    required String title,
+    required String platform,
+    required Map<String, String> creds,
+    String? originalTitle,
+    List<String> regions = const [],
+  }) async* {
+    yield await fetch(
+      title: originalTitle ?? title,
+      platform: platform,
+      creds: creds,
+    );
+  }
+}
