+
+Future<(DebridResult, StubAdapter)> _resolve(
+  List<Object?> files, {
+  DebridFileRequest? request,
+  Object? totalSize = _total,
+  String? returnedHash,
+  bool downloadFails = false,
+}) async {
+  final req = request ?? _request();
+  final dio = stubbedDio('https://api.torbox.app/v1/api', {
+    '/v1/api/torrents/createtorrent': (_) => jsonBody(
+      jsonEncode({
+        'success': true,
+        'data': {'torrent_id': 42, 'hash': req.infohash},
+      }),
+    ),
+    '/v1/api/torrents/mylist': (_) => jsonBody(
+      jsonEncode({
+        'success': true,
+        'data': {
+          'id': 42,
+          'hash': returnedHash ?? req.infohash,
+          'name': 'An account-chosen name is not file-identity proof',
+          'download_path': '/private-provider-directory/not-for-diagnostics',
+          'size': totalSize,
+          'download_present': true,
+          'download_finished': true,
+          'files': files,
+        },
+      }),
+    ),
+    '/v1/api/torrents/requestdl': (_) => downloadFails
+        ? jsonBody('{"success":false,"error":"DOWNLOAD_SERVER_ERROR"}')
+        : jsonBody(
+            '{"success":true,"data":"https://download.example/selected"}',
+          ),
+  });
+  final result = await TorboxProvider(
+    dio: dio,
+  ).resolveFile(req, apiKey: 'fixture-key');
+  return (result, dio.httpClientAdapter as StubAdapter);
+}
+
+void _expectRefused(DebridResult result, StubAdapter adapter) {
+  expect(result, isA<DebridError>());
+  expect(
+    adapter.calls.where((call) => call.uri.path.endsWith('/requestdl')),
+    isEmpty,
+  );
+}
