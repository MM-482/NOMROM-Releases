+      var sent = 0;
+      var peerClosed = false;
+      h.handler = (request, start, end) async {
+        // HttpServerResponse can discard add/flush calls after the peer leaves.
+        // Observe the actual socket's EOF instead of counting those calls as
+        // network traffic, and keep the body open until the client stops it.
+        final socket = await request.response.detachSocket(writeHeaders: false);
+        socket.listen(
+          (_) {},
+          onDone: () => peerClosed = true,
+          onError: (Object _) => peerClosed = true,
+        );
+        try {
+          socket.write(
+            'HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n'
+            'Connection: close\r\n\r\n',
+          );
+          await socket.flush();
+          for (var i = 0; i < 100 && !peerClosed; i++) {
+            socket.write('1000\r\n');
+            socket.add(Uint8List(4096));
+            socket.write('\r\n');
+            sent += 4096;
+            await socket.flush();
+            await Future<void>.delayed(const Duration(milliseconds: 5));
+          }
+          if (!peerClosed) {
+            socket.write('0\r\n\r\n');
+            await socket.flush();
+            await Future<void>.delayed(const Duration(milliseconds: 25));
+          }
+        } on SocketException {
+          // A peer reset is also an observable upstream connection abort.
+          peerClosed = true;
+        } finally {
+          socket.destroy();
+          finished.complete();
+        }
+        return true;
+      };
+      final taskToken = CancelToken();
