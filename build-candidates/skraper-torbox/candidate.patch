+bool _proofMatchesRequest(
+  TorrentFileSelectionProof proof,
+  DebridFileRequest request,
+) =>
+    proof.infohash == request.infohash.trim().toLowerCase() &&
+    proof.fileIndex == request.fileIndex &&
+    proof.filePath == _normalPath(request.filePath ?? '') &&
+    proof.expectedSize == request.expectedSize &&
+    request.expectedSize > 0;
+
+// Keep proof comparisons exact across every Dart target and JSON number form.
+const _maxProofInteger = 9007199254740991;
+
+int? _proofInteger(Object? value) {
+  final number = _asInt(value);
+  return number != null && number >= 0 && number <= _maxProofInteger
+      ? number
+      : null;
+}
