+import 'dart:convert';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:romgi/models/debrid_failure_details.dart';
+import 'package:romgi/models/download_link.dart';
+import 'package:romgi/models/download_task.dart';
+
+DebridFailureDetails _details({
+  String? path =
+      'Redump/Microsoft - Xbox/Halo - Combat Evolved (USA) (Rev 2).zip',
+  Iterable<DebridDiagnosticFile>? files,
+  String code = 'FILE_NOT_FOUND',
+}) => DebridFailureDetails.torbox(
+  stage: DebridFailureStage.fileSelection,
+  code: code,
+  requestedPath: path,
+  expectedSize: 6884752659,
+  providerFileCount: 2780,
+  files:
+      files ??
+      [
+        DebridDiagnosticFile(
+          name:
+              '/srv/private-account/storage/Halo - Combat Evolved (USA) (Rev 2).zip',
+          shortName: 'Halo - Combat Evolved (USA) (Rev 2).zip',
+          size: 6884752659,
+          zipped: false,
+        ),
+      ],
+  downloadPresent: true,
+  downloadFinished: true,
+  downloadState: 'cached',
+  checks: const {
+    DebridDiagnosticCheck.torrentIdentityValidated: true,
+    DebridDiagnosticCheck.catalogProofAvailable: false,
+  },
+);
+
+DownloadTask _task(DebridFailureDetails? details) => DownloadTask(
+  id: 'example',
+  slug: 'example',
+  title: 'Example',
+  platform: 'xbox',
+  createdAt: DateTime(2026),
+  status: DownloadStatus.failed,
+  error: 'The requested pack file was not found. (FILE_NOT_FOUND)',
+  diagnostics: details,
+  link: const DownloadLink(
+    name: 'Halo',
+    type: 'Game',
+    format: 'zip',
+    url: '',
+    filename: 'Halo.zip',
+    host: 'MiNERVA',
+    size: 6884752659,
+    sizeStr: '6.88 GB',
+    sourceUrl: '',
+    torrentInfohash: 'abcdef0123456789abcdef0123456789abcdef01',
+    torrentFileIndex: 893,
+    torrentFilePath: 'Redump/Halo.zip',
+  ),
+);
+
+void main() {
+  test(
+    'captures exact public selection and bounded basename-only evidence',
+    () {
+      final details = _details().sanitized('example-api-key')!;
+      final report = details.toReport(appVersion: '1.10.4+25');
+      expect(report, contains('NOMROM download diagnostics v1'));
+      expect(report, contains('App version: 1.10.4+25'));
+      expect(report, contains('Stage: file selection'));
+      expect(report, contains('Expected bytes: 6884752659'));
+      expect(report, contains('Provider files: 2780'));
+      expect(report, contains('zipped: false'));
+      expect(report, contains('name had directories: true'));
+      expect(report, isNot(contains('/srv/')));
+      expect(report, isNot(contains('private-account')));
+      expect(report, isNot(contains('storage/')));
+      expect(
+        details.candidates.single.name,
+        'Halo - Combat Evolved (USA) (Rev 2).zip',
+      );
+    },
+  );
+
+  test(
+    'redacts credentials, nested URI forms and unsafe provider text before persistence',
+    () {
+      const key = 'API_SECRET_0123456789';
+      final filename = 'Halo $key.zip';
+      final details = _details(
+        path: 'Redump/$filename',
+        code: key,
+        files: [
+          DebridDiagnosticFile(
+            name: '/srv/private-account/\x1b[31m$filename\u202e',
+            shortName: Uri.encodeComponent(Uri.encodeComponent(filename)),
+            size: 100,
+          ),
+          DebridDiagnosticFile(
+            name: 'https://host.invalid/file?token=$key',
+            zipped: true,
+          ),
+          DebridDiagnosticFile(
+            name: Uri.encodeComponent('magnet:?xt=secret'),
+            zipped: true,
+          ),
+          DebridDiagnosticFile(name: 'Bearer $key', zipped: true),
+          DebridDiagnosticFile(
+            name: Uri.encodeComponent(
+              Uri.encodeComponent(r'C:\Users\private-account\Halo.zip'),
+            ),
+            zipped: true,
+          ),
+        ],
+      ).sanitized(key)!;
+      final encoded = DownloadFailureStorage.encode(
+        'Matching failed.',
+        details,
+      )!;
+      final report = details.toReport();
+      for (final value in [encoded, report]) {
+        for (final forbidden in [
+          key,
+          Uri.encodeComponent(key),
+          'https:',
+          'magnet:',
+          'Bearer ',
+          'private-account',
+          '/srv/',
+          r'C:\Users',
+          '\x1b',
+          '\u202e',
+        ]) {
+          expect(value, isNot(contains(forbidden)), reason: forbidden);
+        }
+        expect(value, contains('[redacted]'));
+      }
+      expect(details.code, 'UNKNOWN_ERROR');
+    },
+  );
+
+  test(
+    'rejects absolute, traversal, URI and encoded backend catalog paths',
+    () {
+      for (final path in [
+        '/srv/private-account/Halo.zip',
+        r'C:\Users\name\Halo.zip',
+        r'\\server\share\Halo.zip',
+        '../Halo.zip',
+        'a/../Halo.zip',
+        'https://example.invalid/Halo.zip',
+        'magnet:?xt=secret',
+        Uri.encodeComponent(
+          Uri.encodeComponent('/srv/private-account/Halo.zip'),
+        ),
+      ]) {
+        final details = _details(path: path).sanitized('key')!;
+        expect(details.requestedPath, isNull, reason: path);
+        expect(details.toReport(), isNot(contains('private-account')));
+      }
+    },
+  );
+
+  test(
+    'redacts literal-percent and separator-containing key representations',
+    () {
+      for (final key in [
+        'literal%20percent-key',
+        'private-part/final-secret',
+      ]) {
+        final details = _details(
+          path: 'Catalog/Halo $key.zip',
+          files: [
+            DebridDiagnosticFile(
+              name: '/provider/Halo $key.zip',
+              shortName: Uri.encodeComponent('Halo $key.zip'),
+              size: 10,
+              zipped: true,
+            ),
+          ],
+        ).sanitized(key)!;
+        final output =
+            '${details.toReport()}${DownloadFailureStorage.encode('Failed.', details)}';
+        expect(output, isNot(contains(key)));
+        expect(output, isNot(contains(Uri.decodeComponent(key))));
+        expect(output, isNot(contains('final-secret')));
+      }
+    },
+  );
+
+  test(
+    'mixed malformed and valid escapes cannot conceal a partially encoded key',
+    () {
+      final key = 'SYNTHETIC_${List.filled(54, 'A').join()}';
+      final disguised =
+          'Halo bad%ZZ %53YNTHETIC_${List.filled(54, 'A').join()}.zip';
+      final details = _details(
+        path: disguised,
+        files: [
+          DebridDiagnosticFile(
+            name: disguised,
+            shortName: disguised,
+            size: 10,
+            zipped: true,
+          ),
+        ],
+      ).sanitized(key)!;
+      final encoded = DownloadFailureStorage.encode('Failed.', details)!;
+      final restored = DownloadFailureStorage.decode(encoded).diagnostics!;
+      for (final value in [details.toReport(), encoded, restored.toReport()]) {
+        expect(value, isNot(contains('SYNTHETIC_')));
+        expect(value, isNot(contains('%53YNTHETIC_')));
+        expect(value, isNot(contains(List.filled(54, 'A').join())));
+      }
+      expect(details.requestedPath, isNull);
+      expect(details.candidates, isEmpty);
+    },
+  );
+
+  test(
+    'large lists and unicode names fit both four KiB limits with explicit omissions',
+    () {
+      final details = _details(
+        files: List.generate(
+          1000,
+          (index) => DebridDiagnosticFile(
+            name: 'Halo Combat ${List.filled(70, '界').join()} $index.zip',
+            shortName: 'Halo Combat ${List.filled(70, '界').join()} $index.zip',
+            size: index + 1,
+            zipped: index.isEven,
+          ),
+        ),
+      ).sanitized('key')!;
+      expect(details.candidates.length, lessThanOrEqualTo(5));
+      expect(details.omittedCandidateCount, greaterThan(0));
+      expect(details.usableFileCount, 1000);
+      expect(details.zippedFileCount, 500);
+      final serialized = DownloadFailureStorage.encode(
+        List.filled(500, '界').join(),
+        details,
+      )!;
+      expect(utf8.encode(serialized).length, lessThanOrEqualTo(4096));
+      expect(utf8.encode(details.toReport()).length, lessThanOrEqualTo(4096));
+      expect(DownloadFailureStorage.decode(serialized).diagnostics, isNotNull);
+    },
+  );
+
+  test(
+    'does not sample unrelated collection files or invent unknown state',
+    () {
+      final details = DebridFailureDetails.torbox(
+        stage: DebridFailureStage.downloadLink,
+        code: 'FILE_NOT_FOUND',
+        requestedPath: 'Halo.zip',
+        expectedSize: 10,
+        providerFileCount: 100,
+        downloadState: 'https://secret.invalid/state',
+        files: [DebridDiagnosticFile(name: 'Unrelated Game.zip', size: 10)],
+      ).sanitized('key')!;
+      expect(details.candidates, isEmpty);
+      expect(details.downloadState, 'other');
+      expect(details.toReport(), contains('Stage: download link'));
+      expect(details.toReport(), isNot(contains('Unrelated')));
+    },
+  );
+
+  test(
+    'existing error column roundtrips details while keeping public error plain',
+    () {
+      final original = _task(_details().sanitized('key'));
+      final stored = original.toMap();
+      expect(stored['error'], startsWith(DownloadFailureStorage.prefix));
+      expect(stored.containsKey('diagnostics'), isFalse);
+      final restored = DownloadTask.fromMap(stored);
+      expect(restored.error, original.error);
+      expect(
+        restored.diagnostics!.toReport(),
+        original.diagnostics!.toReport(),
+      );
+      expect(restored.error, isNot(contains('NOMROM_DOWNLOAD_ERROR')));
+      final legacy = DownloadTask.fromMap(_task(null).toMap());
+      expect(legacy.error, original.error);
+      expect(legacy.diagnostics, isNull);
+    },
+  );
+
+  test(
+    'invalid and unknown envelopes fail closed without exposing their contents',
+    () {
+      for (final raw in [
+        '${DownloadFailureStorage.prefix}{not-json-secret',
+        'NOMROM_DOWNLOAD_ERROR_V2\n{"secret":"do-not-display"}',
+        '${DownloadFailureStorage.prefix}${jsonEncode({'version': 1, 'message': 123})}',
+        '${DownloadFailureStorage.prefix}${List.filled(5000, 's').join()}',
+      ]) {
+        final decoded = DownloadFailureStorage.decode(raw);
+        expect(decoded.message, 'Download failed. Please retry.');
+        expect(decoded.diagnostics, isNull);
+      }
+    },
+  );
+
+  test(
+    'envelope summary filtering cannot reveal encoded or split URLs and Bearer text',
+    () {
+      final raw =
+          '${DownloadFailureStorage.prefix}${jsonEncode({'version': 1, 'message': 'http\u200bs://secret.invalid/path Bearer\nsecret-token magnet:?xt=hidden', 'diagnostics': null})}';
+      final message = DownloadFailureStorage.decode(raw).message!;
+      expect(message, isNot(contains('secret.invalid')));
+      expect(message, isNot(contains('secret-token')));
+      expect(message, isNot(contains('magnet:')));
+      expect(message, contains('[link omitted]'));
+      expect(message, contains('Bearer [redacted]'));
+    },
+  );
+
+  test(
+    'transitions clear prior diagnostics and preserve the waiting marker when encoded',
+    () {
+      final task = _task(_details().sanitized('key'));
+      for (final next in [
+        task.copyWith(status: DownloadStatus.pending),
+        task.copyWith(status: DownloadStatus.completed),
+        task.copyWith(error: 'A different failure.'),
+        task.copyWith(error: null, diagnostics: task.diagnostics),
+      ]) {
+        expect(next.diagnostics, isNull);
+      }
+      final waiting = task.copyWith(
+        status: DownloadStatus.paused,
+        error: 'Still preparing. (CACHING_TIMEOUT)',
+        diagnostics: task.diagnostics,
+      );
+      final restored = DownloadTask.fromMap(waiting.toMap());
+      expect(restored.waitingForDebrid, isTrue);
+      expect(restored.error, 'Still preparing. (CACHING_TIMEOUT)');
+      expect(restored.statusText, 'Waiting for debrid');
+    },
+  );
+}
