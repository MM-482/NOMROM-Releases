+  bool ignoreCancellation = false;
+  Object? failure;
+  List<int> bytes = _member;
+  late File destination;
+  late CancelToken token;
+  late RemoteZipTarget target;
+}
+
+class _RemoteZip extends Fake implements RemoteZipService {
+  final plans = <_Transfer>[];
+  final calls = <_Transfer>[];
+
+  _Transfer plan({Object? failure, bool releaseImmediately = false}) {
+    final transfer = _Transfer()..failure = failure;
+    if (releaseImmediately) transfer.release.complete();
+    plans.add(transfer);
+    return transfer;
+  }
+
+  @override
+  Future<void> download({
+    required RemoteZipTarget target,
+    required File destination,
+    required CancelToken cancelToken,
+    required ProgressCallback onReceiveProgress,
+  }) async {
+    final transfer = plans[calls.length]
+      ..destination = destination
+      ..token = cancelToken
+      ..target = target;
+    calls.add(transfer);
+    try {
+      await destination.writeAsBytes([80]);
+      onReceiveProgress(1, target.selectionProof.expectedSize);
+      transfer.started.complete();
+      if (transfer.ignoreCancellation) {
+        await transfer.release.future;
+      } else {
+        await Future.any([
+          transfer.release.future,
+          cancelToken.whenCancel.then<void>((_) {}),
+        ]);
+        if (cancelToken.isCancelled) throw cancelToken.cancelError!;
+      }
+      if (transfer.failure != null) throw transfer.failure!;
+      await destination.writeAsBytes(transfer.bytes);
+      onReceiveProgress(
+        transfer.bytes.length,
+        target.selectionProof.expectedSize,
+      );
+    } finally {
+      transfer.finished.complete();
+    }
+  }
+}
