+List<Map<String, dynamic>> _provenFilenameCandidates(
+  List<dynamic> files,
+  DebridFileRequest request,
+  Map<String, dynamic> torrent, {
+  bool decode = false,
+}) {
+  final proof = request.selectionProof;
+  if (proof == null ||
+      !_proofMatchesRequest(proof, request) ||
+      !(decode ? proof.uniqueDecodedFilename : proof.uniqueFilename) ||
+      files.length != proof.fileCount ||
+      _proofInteger(torrent['size']) != proof.totalSize) {
+    return const [];
+  }
+  final summary = _providerFileSummary(files);
+  if (!summary.idsUnique || summary.totalSize != proof.totalSize) {
+    return const [];
+  }
+
+  // The complete catalog index proves this filename/size identifies the
+  // selected member. A complete, consistent provider list must independently
+  // identify one file. Provider folder names may be changed by the account;
+  // neither those names nor positional provider-array indexes are identities.
+  final target = p.posix.basename(
+    _normalPath(request.filePath ?? '', decode: decode),
+  );
+  return files.whereType<Map<String, dynamic>>().where((file) {
+    if (_proofInteger(file['size']) != request.expectedSize) return false;
+    String basename(Object? value) {
+      if (value is! String) return '';
+      final path = _normalPath(value, decode: decode);
+      return path.isEmpty ? '' : p.posix.basename(path);
+    }
