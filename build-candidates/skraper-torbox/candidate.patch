@@ -0,0 +1,95 @@
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:path/path.dart' as p;
+import 'package:romgi/services/metadata/metadata_provider.dart';
+import 'package:romgi/services/skraper/skraper_import_service.dart';
+import 'package:romgi/services/skraper/skraper_metadata_provider.dart';
+
+void main() {
+  late Directory directory;
+  late SkraperImportService service;
+  late SkraperMetadataProvider provider;
+
+  setUp(() async {
+    directory = await Directory.systemTemp.createTemp(
+      'nomrom-skraper-provider-',
+    );
+    service = SkraperImportService(
+      rootDirectory: Directory(p.join(directory.path, 'owned')),
+    );
+    provider = SkraperMetadataProvider(service: service);
+  });
+  tearDown(() => directory.delete(recursive: true));
+
+  test(
+    'account-free local provider reports a no-match without credentials',
+    () async {
+      expect(provider.info.id, 'skraper_local');
+      expect(provider.info.name, 'Skraper imports');
+      expect(provider.credentialFields, isEmpty);
+      expect(provider.isConfigured(null), isTrue);
+      expect(await provider.validateCredentials({}), isNull);
+      expect(
+        await provider.fetch(title: 'Unknown', platform: 'snes', creds: {}),
+        isA<MetadataNoMatch>(),
+      );
+    },
+  );
+
+  test(
+    'provider returns imported facts and observes removal immediately',
+    () async {
+      final file = await File(p.join(directory.path, 'gamelist.xml'))
+          .writeAsString(
+            '<gameList><game><name>Game</name><path>Game.zip</path><desc>Local facts</desc></game></gameList>',
+          );
+      await service.importPreview(
+        await service.previewFile(file.path, platform: 'snes'),
+      );
+      final found = await provider.fetch(
+        title: 'Game',
+        platform: 'snes',
+        creds: {},
+      );
+      expect(found, isA<MetadataFound>());
+      expect((found as MetadataFound).description, 'Local facts');
+      expect(found.sourceName, 'Skraper import');
+      expect(
+        await provider.fetch(title: 'Game', platform: 'nes', creds: {}),
+        isA<MetadataNoMatch>(),
+      );
+      await service.clearImports();
+      expect(
+        await provider.fetch(title: 'Game', platform: 'snes', creds: {}),
+        isA<MetadataNoMatch>(),
+      );
+    },
+  );
+
+  test(
+    'context lookup retains demo qualifiers instead of using retail cleanup',
+    () async {
+      final file = await File(p.join(directory.path, 'gamelist.xml'))
+          .writeAsString(
+            '<gameList><game><name>Game</name><path>Game (Demo).zip</path><desc>Demo facts</desc></game></gameList>',
+          );
+      await service.importPreview(
+        await service.previewFile(file.path, platform: 'snes'),
+      );
+      expect(
+        await provider.fetch(title: 'Game', platform: 'snes', creds: {}),
+        isA<MetadataNoMatch>(),
+      );
+      final result = await provider
+          .fetchUpdatesWithContext(
+            title: 'Game',
+            originalTitle: 'Game (Demo)',
+            platform: 'snes',
+            creds: {},
+          )
+          .single;
+      expect((result as MetadataFound).description, 'Demo facts');
+    },
+  );
+}
