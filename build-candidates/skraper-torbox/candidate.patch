+        'nomrom-skraper://elsewhere/${'a' * 64}.png',
+      ]) {
+        await expectLater(
+          artwork.get(uri),
+          throwsA(isA<HttpExceptionWithStatus>()),
+        );
+      }
+      expect(requests, isEmpty);
+    },
+  );
+}
