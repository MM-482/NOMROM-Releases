+      expect(found.sourceName, 'Skraper import');
+      expect(
+        await provider.fetch(title: 'Game', platform: 'nes', creds: {}),
+        isA<MetadataNoMatch>(),
+      );
+      await service.clearImports();
+      expect(
+        await provider.fetch(title: 'Game', platform: 'snes', creds: {}),
+        isA<MetadataNoMatch>(),
