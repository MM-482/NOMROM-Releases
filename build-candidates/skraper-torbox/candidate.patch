+
+  test(
+    'missing or malformed local artwork fails locally without network fallback',
+    () async {
+      final requests = <String>[];
+      final artwork = ArtworkFileService(
+        localArtwork: imports.resolveArtwork,
+        client: MockClient((request) async {
+          requests.add(request.url.toString());
+          return http.Response('unexpected network', 500);
+        }),
+      );
+      for (final uri in [
+        'nomrom-skraper://artwork/${'a' * 64}.png',
