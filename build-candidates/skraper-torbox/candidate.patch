+    final name = basename(file['name']);
+    final shortName = basename(file['short_name']);
+    // A short-name alias cannot override a conflicting filename/revision.
+    if (name.isNotEmpty && shortName.isNotEmpty && name != shortName) {
+      return false;
+    }
+    return (name.isNotEmpty ? name : shortName) == target;
+  }).toList();
