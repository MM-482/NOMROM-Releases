+  Future<SkraperImportSummary> importPreview(
+    SkraperImportPreview preview,
+  ) => _serialize(() async {
+    if (!identical(preview._issuer, _issuer) || preview._drafts == null) {
+      throw const FormatException(
+        'Preview this gamelist again before importing it.',
+      );
+    }
+    await _load();
+    final next = Map<String, _Record>.from(_records);
+    final issues = List<String>.from(preview.issues);
+    final importedImages = <String, String?>{};
+    final newArtwork = <String>{};
+    var added = 0;
+    var updated = 0;
+    var unchanged = 0;
+    for (final draft in preview._drafts) {
+      final covers = <String>{};
+      final screenshots = <String>{};
+      final artwork = <String>{};
+      for (final entry in draft.images) {
+        if (!importedImages.containsKey(entry.image.path)) {
+          try {
+            // Re-resolve and re-hash: a source or symlink may have changed
+            // while the user was reviewing the preview.
+            final source = entry.image;
+            final current = await _readSourceImage(
+              source.path,
+              sourceDirectory: source.allowedRoot,
+              allowedRoot: source.allowedRoot,
+              allowAbsolute: true,
+            );
+            if (current.filename != source.filename) {
+              throw const FormatException(
+                'Artwork changed after preview; preview it again.',
+              );
+            }
+            final wasAdded = await _copyArtwork(current);
+            if (wasAdded) newArtwork.add(current.filename);
+            importedImages[source.path] = _artUri(current.filename);
+          } on FileSystemException {
+            importedImages[entry.image.path] = null;
+            if (issues.length < _maxIssues) {
+              issues.add(
+                '${draft.title}: artwork became unavailable and was skipped.',
+              );
+            }
+          } on FormatException catch (error) {
+            importedImages[entry.image.path] = null;
+            if (issues.length < _maxIssues) {
+              issues.add('${draft.title}: ${error.message}');
+            }
+          }
+        }
+        final uri = importedImages[entry.image.path];
+        if (uri == null) continue;
+        switch (entry.role) {
+          case SkraperImageRole.cover:
+            covers.add(uri);
+          case SkraperImageRole.screenshot:
+            screenshots.add(uri);
+          case SkraperImageRole.artwork:
+            artwork.add(uri);
+        }
+      }
+      final incoming = _Record(
+        id: draft.id,
+        platform: draft.platform,
+        title: draft.title,
+        aliases: draft.aliases,
+        metadata: _withImages(draft.metadata, covers, screenshots, artwork),
+      );
+      final previous = next[draft.id];
+      final record = previous == null ? incoming : previous.merge(incoming);
+      if (previous == null) {
+        added++;
+      } else if (jsonEncode(previous.toJson()) == jsonEncode(record.toJson())) {
+        unchanged++;
+      } else {
+        updated++;
+      }
+      next[draft.id] = record;
+    }
+    if (next.length > 100000) {
+      throw const FormatException(
+        'The local import store is limited to 100,000 games.',
+      );
+    }
+    final importedAt = DateTime.now().toUtc();
+    await _commit(next, importedAt);
+    return SkraperImportSummary(
+      importedGames: added,
+      importedArtwork: newArtwork.length,
+      updatedGames: updated,
+      unchangedGames: unchanged,
+      skippedCount: preview.skippedCount,
+      issues: List.unmodifiable(issues),
+    );
+  });
+
+  Future<SkraperImportStatus> getStatus() async {
+    await _writes;
+    await _load();
+    final platforms = <String, int>{};
+    final artwork = <String>{};
+    for (final record in _records.values) {
+      platforms.update(
+        record.platform,
+        (count) => count + 1,
+        ifAbsent: () => 1,
+      );
+      artwork.addAll(record.artwork);
+    }
+    return SkraperImportStatus(
+      gameCount: _records.length,
+      artworkCount: artwork.length,
+      platforms: Map.unmodifiable(platforms),
+      lastImportAt: _lastImportAt,
+    );
+  }
