+({bool idsUnique, int? totalSize}) _providerFileSummary(List<dynamic> files) {
+  final ids = <int>{};
+  var idsUnique = true;
+  var sizesValid = true;
+  var totalSize = 0;
+  for (final file in files) {
+    if (file is! Map<String, dynamic>) {
+      idsUnique = false;
+      sizesValid = false;
+      continue;
+    }
+    final id = _proofInteger(file['id']);
+    if (id == null || !ids.add(id)) idsUnique = false;
+    final size = _proofInteger(file['size']);
+    if (size == null || size > _maxProofInteger - totalSize) {
+      sizesValid = false;
+    } else {
+      totalSize += size;
+    }
+  }
+  return (idsUnique: idsUnique, totalSize: sizesValid ? totalSize : null);
+}
