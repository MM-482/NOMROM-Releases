+
+  SkraperImportPreview._validated({
+    required this.platform,
+    required this.sourceName,
+    required this.imageRole,
+    required List<SkraperPreviewItem> items,
+    required List<String> issues,
+    required this.skippedCount,
+    required this.ambiguousAliasCount,
+    required List<_Draft> drafts,
