+      if (previous == null) {
+        added++;
+      } else if (jsonEncode(previous.toJson()) == jsonEncode(record.toJson())) {
+        unchanged++;
+      } else {
+        updated++;
+      }
+      next[draft.id] = record;
+    }
+    if (next.length > 100000) {
+      throw const FormatException(
+        'The local import store is limited to 100,000 games.',
+      );
+    }
+    final importedAt = DateTime.now().toUtc();
+    await _commit(next, importedAt);
+    return SkraperImportSummary(
+      importedGames: added,
+      importedArtwork: newArtwork.length,
+      updatedGames: updated,
+      unchangedGames: unchanged,
+      skippedCount: preview.skippedCount,
+      issues: List.unmodifiable(issues),
+    );
+  });
+
+  Future<SkraperImportStatus> getStatus() async {
+    await _writes;
+    await _load();
+    final platforms = <String, int>{};
+    final artwork = <String>{};
+    for (final record in _records.values) {
+      platforms.update(
+        record.platform,
+        (count) => count + 1,
+        ifAbsent: () => 1,
+      );
+      artwork.addAll(record.artwork);
+    }
+    return SkraperImportStatus(
+      gameCount: _records.length,
+      artworkCount: artwork.length,
+      platforms: Map.unmodifiable(platforms),
+      lastImportAt: _lastImportAt,
+    );
+  }
