+++ b/lib/models/debrid_failure_details.dart
@@ -0,0 +1,596 @@
+import 'dart:convert';
+
+enum DebridFailureStage { fileSelection, downloadLink, archiveMember }
+
+enum DebridDiagnosticCheck {
+  torrentIdentityValidated,
+  catalogProofAvailable,
+  collectionFileCountMatches,
+  collectionTotalSizeMatches,
+  providerFileIdsUnique,
+  catalogNameAndSizeUnique,
+}
+
+/// An allowlisted file description. Provider directories never leave this DTO.
+class DebridDiagnosticFile {
+  final String? name;
+  final String? shortName;
+  final int? size;
+  final bool? zipped;
+  final bool nameHadDirectories;
+
+  factory DebridDiagnosticFile({
+    String? name,
+    String? shortName,
+    int? size,
+    bool? zipped,
+  }) => DebridDiagnosticFile._(
+    name: _basename(name),
+    shortName: _basename(shortName),
+    size: _positive(size),
+    zipped: zipped,
+    nameHadDirectories:
+        name != null && _decoded(name).contains(RegExp(r'[/\\]')),
+  );
+
+  const DebridDiagnosticFile._({
+    this.name,
+    this.shortName,
+    this.size,
+    this.zipped,
+    this.nameHadDirectories = false,
+  });
+
+  DebridDiagnosticFile _sanitized(String key) => DebridDiagnosticFile._(
+    name: _basename(name, key: key),
+    shortName: _basename(shortName, key: key),
+    size: size,
+    zipped: zipped,
+    nameHadDirectories: nameHadDirectories,
+  );
+
+  Map<String, Object?> _toJson() => {
+    'name': name,
+    'shortName': shortName,
+    'size': size,
+    'zipped': zipped,
+    'nameHadDirectories': nameHadDirectories,
+  };
+}
+
+/// Small local evidence, never a response dump. The resolver must additionally
+/// call sanitized(apiKey) before a failure reaches persistence or the UI.
+class DebridFailureDetails {
+  static const schemaVersion = 1;
+  static const maxEncodedBytes = 4096;
+  static const maxCandidates = 5;
+  // Leaves room for the existing 500-character message and storage envelope.
+  static const _detailsBudget = 2000;
+
+  final DebridFailureStage stage;
+  final String code;
+  final String? requestedPath;
+  final int? expectedSize;
+  final int providerFileCount;
+  final int usableFileCount;
+  final int zippedFileCount;
+  final bool? downloadPresent;
+  final bool? downloadFinished;
+  final String? downloadState;
+  final Map<DebridDiagnosticCheck, bool> checks;
+  final List<DebridDiagnosticFile> candidates;
+  final int omittedCandidateCount;
+
+  const DebridFailureDetails._({
+    required this.stage,
+    required this.code,
+    required this.requestedPath,
+    required this.expectedSize,
+    required this.providerFileCount,
+    required this.usableFileCount,
+    required this.zippedFileCount,
+    required this.downloadPresent,
+    required this.downloadFinished,
+    required this.downloadState,
+    required this.checks,
+    required this.candidates,
+    required this.omittedCandidateCount,
+  });
+
+  factory DebridFailureDetails.torbox({
+    required DebridFailureStage stage,
+    required String code,
+    required String? requestedPath,
+    required int expectedSize,
+    required int providerFileCount,
+    required Iterable<DebridDiagnosticFile> files,
+    bool? downloadPresent,
+    bool? downloadFinished,
+    String? downloadState,
+    Map<DebridDiagnosticCheck, bool> checks = const {},
+  }) {
+    final path = _relativePath(requestedPath);
+    final selectedName = _basename(path);
+    final sample = <({int rank, int order, DebridDiagnosticFile file})>[];
+    var order = 0;
+    var usable = 0;
+    var zipped = 0;
+    var nearby = 0;
+    for (final file in files) {
+      if ((file.name != null || file.shortName != null) && file.size != null) {
+        usable++;
+      }
+      if (file.zipped == true) zipped++;
+      final rank = _candidateRank(selectedName, file);
+      if (rank != null) {
+        nearby++;
+        sample.add((rank: rank, order: order, file: file));
+        sample.sort((a, b) {
+          final rank = a.rank.compareTo(b.rank);
+          return rank != 0 ? rank : a.order.compareTo(b.order);
+        });
+        if (sample.length > maxCandidates) sample.removeLast();
+      }
+      order++;
+    }
+    return DebridFailureDetails._(
+      stage: stage,
+      code: _code(code),
+      requestedPath: path,
+      expectedSize: _positive(expectedSize),
+      providerFileCount: _count(providerFileCount),
+      usableFileCount: usable,
+      zippedFileCount: zipped,
+      downloadPresent: downloadPresent,
+      downloadFinished: downloadFinished,
+      downloadState: _state(downloadState),
+      checks: Map.unmodifiable(checks),
+      candidates: List.unmodifiable(sample.map((item) => item.file)),
+      omittedCandidateCount: nearby - sample.length,
+    )._bounded();
+  }
+
+  /// Called by the central resolver using the credential for this exact attempt.
+  DebridFailureDetails? sanitized(String apiKey) => _copy(
+    code: _code(_redact(code, apiKey)),
+    requestedPath: _relativePath(requestedPath, key: apiKey),
+    candidates: candidates.map((file) => file._sanitized(apiKey)).toList(),
+  )._bounded();
+
+  /// Keeps the already-sanitized provider evidence for an archive transfer.
+  DebridFailureDetails forArchiveFailure(String failureCode) =>
+      DebridFailureDetails._(
+        stage: DebridFailureStage.archiveMember,
+        code: _code(failureCode),
+        requestedPath: requestedPath,
+        expectedSize: expectedSize,
+        providerFileCount: providerFileCount,
+        usableFileCount: usableFileCount,
+        zippedFileCount: zippedFileCount,
+        downloadPresent: downloadPresent,
+        downloadFinished: downloadFinished,
+        downloadState: downloadState,
+        checks: checks,
+        candidates: candidates,
+        omittedCandidateCount: omittedCandidateCount,
+      )._bounded();
+
+  DebridFailureDetails _copy({
+    String? code,
+    required String? requestedPath,
+    required List<DebridDiagnosticFile> candidates,
+    int? omittedCandidateCount,
+  }) => DebridFailureDetails._(
+    stage: stage,
+    code: code ?? this.code,
+    requestedPath: requestedPath,
+    expectedSize: expectedSize,
+    providerFileCount: providerFileCount,
+    usableFileCount: usableFileCount,
+    zippedFileCount: zippedFileCount,
+    downloadPresent: downloadPresent,
+    downloadFinished: downloadFinished,
+    downloadState: downloadState,
+    checks: checks,
+    candidates: List.unmodifiable(candidates),
+    omittedCandidateCount: omittedCandidateCount ?? this.omittedCandidateCount,
+  );
+
+  DebridFailureDetails _bounded() {
+    var result = this;
+    while (utf8.encode(jsonEncode(result._toJson())).length > _detailsBudget) {
+      if (result.candidates.isNotEmpty) {
+        result = result._copy(
+          requestedPath: result.requestedPath,
+          candidates: result.candidates.sublist(
+            0,
+            result.candidates.length - 1,
+          ),
+          omittedCandidateCount: result.omittedCandidateCount + 1,
+        );
+      } else {
+        result = result._copy(requestedPath: null, candidates: const []);
+        break;
+      }
+    }
+    return result;
+  }
+
+  Map<String, Object?> _toJson() => {
+    'version': schemaVersion,
+    'provider': 'torbox',
+    'stage': stage.name,
+    'code': code,
+    'requestedPath': requestedPath,
+    'expectedSize': expectedSize,
+    'providerFileCount': providerFileCount,
+    'usableFileCount': usableFileCount,
+    'zippedFileCount': zippedFileCount,
+    'downloadPresent': downloadPresent,
+    'downloadFinished': downloadFinished,
+    'downloadState': downloadState,
+    'checks': {for (final check in checks.entries) check.key.name: check.value},
+    'candidates': candidates.map((file) => file._toJson()).toList(),
+    'omittedCandidateCount': omittedCandidateCount,
+  };
+
+  static DebridFailureDetails? _fromJson(Object? value) {
+    if (value is! Map<String, dynamic> ||
+        value['version'] != schemaVersion ||
+        value['provider'] != 'torbox') {
+      return null;
+    }
+    final stages = DebridFailureStage.values.where(
+      (stage) => stage.name == value['stage'],
+    );
+    if (stages.length != 1 ||
+        value['code'] is! String ||
+        _code(value['code'] as String) != value['code'] ||
+        value['candidates'] is! List ||
+        (value['candidates'] as List).length > maxCandidates) {
+      return null;
+    }
+    final candidates = <DebridDiagnosticFile>[];
+    for (final raw in value['candidates'] as List) {
+      if (raw is! Map<String, dynamic>) return null;
+      candidates.add(
+        DebridDiagnosticFile._(
+          name: _basename(raw['name'] is String ? raw['name'] as String : null),
+          shortName: _basename(
+            raw['shortName'] is String ? raw['shortName'] as String : null,
+          ),
+          size: _positive(raw['size'] is int ? raw['size'] as int : null),
+          zipped: raw['zipped'] is bool ? raw['zipped'] as bool : null,
+          nameHadDirectories: raw['nameHadDirectories'] == true,
+        ),
+      );
+    }
+    final checks = <DebridDiagnosticCheck, bool>{};
+    final rawChecks = value['checks'];
+    if (rawChecks is Map<String, dynamic>) {
+      for (final check in DebridDiagnosticCheck.values) {
+        if (rawChecks[check.name] is bool) {
+          checks[check] = rawChecks[check.name] as bool;
+        }
+      }
+    }
+    return DebridFailureDetails._(
+      stage: stages.single,
+      code: value['code'] as String,
+      requestedPath: _relativePath(
+        value['requestedPath'] is String
+            ? value['requestedPath'] as String
+            : null,
+      ),
+      expectedSize: _positive(
+        value['expectedSize'] is int ? value['expectedSize'] as int : null,
+      ),
+      providerFileCount: _count(value['providerFileCount']),
+      usableFileCount: _count(value['usableFileCount']),
+      zippedFileCount: _count(value['zippedFileCount']),
+      downloadPresent: value['downloadPresent'] is bool
+          ? value['downloadPresent'] as bool
+          : null,
+      downloadFinished: value['downloadFinished'] is bool
+          ? value['downloadFinished'] as bool
+          : null,
+      downloadState: _state(
+        value['downloadState'] is String
+            ? value['downloadState'] as String
+            : null,
+      ),
+      checks: Map.unmodifiable(checks),
+      candidates: List.unmodifiable(candidates),
+      omittedCandidateCount: _count(value['omittedCandidateCount']),
+    )._bounded();
+  }
+
+  /// Human-readable, bounded text only; no raw API object or source URL.
+  String toReport({String? appVersion}) {
+    final version =
+        appVersion != null &&
+            RegExp(r'^[0-9A-Za-z.+_-]{1,40}$').hasMatch(appVersion)
+        ? '\nApp version: $appVersion'
+        : '\nApp version: unknown';
+    String yesNo(bool? value) => value == null ? 'unknown' : '$value';
+    final lines = <String>[
+      'NOMROM download diagnostics v$schemaVersion$version',
+      'Provider: TorBox',
+      'Stage: ${switch (stage) {
+        DebridFailureStage.fileSelection => 'file selection',
+        DebridFailureStage.downloadLink => 'download link',
+        DebridFailureStage.archiveMember => 'archive member',
+      }}',
+      'Code: $code',
+      'Selected catalog path: ${requestedPath ?? '[unavailable]'}',
+      'Expected bytes: ${expectedSize ?? 'unknown'}',
+      'Provider files: $providerFileCount; usable: $usableFileCount; marked zipped: $zippedFileCount',
+      'Present: ${yesNo(downloadPresent)}; finished: ${yesNo(downloadFinished)}; state: ${downloadState ?? 'unknown'}',
+      for (final check in checks.entries) '${check.key.name}: ${check.value}',
+      'Nearby file sample: ${candidates.length}; additional matches omitted: $omittedCandidateCount',
+      for (var i = 0; i < candidates.length; i++)
+        '${i + 1}. name: ${candidates[i].name ?? '[unavailable]'}; short name: ${candidates[i].shortName ?? '[unavailable]'}; bytes: ${candidates[i].size ?? 'unknown'}; zipped: ${yesNo(candidates[i].zipped)}; name had directories: ${candidates[i].nameHadDirectories}',
+      'Provider directories, account details, links and credentials are omitted.',
+    ];
+    return _utf8Bound(lines.join('\n'), maxEncodedBytes);
+  }
+}
+
+/// Stores optional details in the existing error TEXT column. Callers still see
+/// a normal error message, including the existing CACHING_TIMEOUT marker.
+class DownloadFailureStorage {
+  static const prefix = 'NOMROM_DOWNLOAD_ERROR_V1\n';
+
+  static String? encode(String? message, DebridFailureDetails? diagnostics) {
+    if (message == null || diagnostics == null) return message;
+    final safeMessage = _safeMessage(message);
+    final value =
+        '$prefix${jsonEncode({'version': 1, 'message': safeMessage, 'diagnostics': diagnostics._bounded()._toJson()})}';
+    return utf8.encode(value).length <= DebridFailureDetails.maxEncodedBytes
+        ? value
+        : safeMessage;
+  }
+
+  static ({String? message, DebridFailureDetails? diagnostics}) decode(
+    String? value,
+  ) {
+    if (value == null || !value.startsWith('NOMROM_DOWNLOAD_ERROR_')) {
+      return (message: value, diagnostics: null);
+    }
+    const invalid = (
+      message: 'Download failed. Please retry.',
+      diagnostics: null,
+    );
+    if (!value.startsWith(prefix) ||
+        value.length > DebridFailureDetails.maxEncodedBytes ||
+        utf8.encode(value).length > DebridFailureDetails.maxEncodedBytes) {
+      return invalid;
+    }
+    try {
+      final decoded = jsonDecode(value.substring(prefix.length));
+      if (decoded is! Map<String, dynamic> ||
+          decoded['version'] != 1 ||
+          decoded['message'] is! String) {
+        return invalid;
+      }
+      return (
+        message: _safeMessage(decoded['message'] as String),
+        diagnostics: DebridFailureDetails._fromJson(decoded['diagnostics']),
+      );
+    } catch (_) {
+      return invalid;
+    }
+  }
+}
+
+final _controls = RegExp(
+  r'[\x00-\x1f\x7f-\x9f\u200b-\u200f\u202a-\u202e\u2060-\u206f\ufeff]',
+);
+final _unsafeText = RegExp(
+  r'[a-z][a-z0-9+.-]*://|(?:magnet|file|s3):|bearer\s|[?&#](?:token|auth|key|api_key)=',
+  caseSensitive: false,
+);
+
+String _redact(String value, String key) {
+  var result = value
+      .replaceAll(RegExp(r'\x1b\[[0-?]*[ -/]*[@-~]'), '')
+      .replaceAll(_controls, '');
+  if (key.isNotEmpty) {
+    final decodedKey = _decodedForSafety(key);
+    final values = {key};
+    if (decodedKey != null) values.add(decodedKey);
+    // A provider basename can retain only a credential's last path component.
+    // Over-redact those components too if a synthetic/unusual key contains a
+    // separator; ordinary API keys remain one value.
+    final parts = values.expand((value) => value.split(RegExp(r'[/\\]')));
+    final secrets = {
+      for (final value in [...values, ...parts])
+        if (value.isNotEmpty) ...{
+          value,
+          Uri.encodeComponent(value),
+          Uri.encodeQueryComponent(value),
+        },
+    }.toList()..sort((a, b) => b.length.compareTo(a.length));
+    for (final secret in secrets) {
+      result = result.replaceAll(
+        RegExp(RegExp.escape(secret), caseSensitive: false),
+        '[redacted]',
+      );
+    }
+  }
+  return result;
+}
+
+String? _basename(String? value, {String key = ''}) {
+  if (value == null || value.length > 16384) return null;
+  final decoded = _decodedForSafety(value);
+  if (decoded == null) return null;
+  final clean = _redact(decoded, key).trim();
+  if (_unsafeText.hasMatch(clean)) return null;
+  final base = clean.replaceAll('\\', '/').split('/').last.trim();
+  if (base.isEmpty ||
+      base == '.' ||
+      base == '..' ||
+      base.contains(':') ||
+      base.runes.length > 160) {
+    return null;
+  }
+  return base;
+}
+
+String? _relativePath(String? value, {String key = ''}) {
+  if (value == null || value.length > 16384) return null;
+  final decodedValue = _decodedForSafety(value);
+  if (decodedValue == null) return null;
+  final clean = _redact(decodedValue, key).trim().replaceAll('\\', '/');
+  if (clean.isEmpty ||
+      clean.startsWith('/') ||
+      clean.contains(':') ||
+      _unsafeText.hasMatch(clean)) {
+    return null;
+  }
+  final pieces = clean.split('/');
+  if (pieces.any((piece) => piece.isEmpty || piece == '.' || piece == '..')) {
+    return null;
+  }
+  if (clean.runes.length > 300) return _basename(clean, key: key);
+  return clean;
+}
+
+int? _positive(int? value) =>
+    value != null && value > 0 && value <= 0x1fffffffffffff ? value : null;
+int _count(Object? value) =>
+    value is int && value >= 0 && value <= 0x1fffffffffffff ? value : 0;
+String _code(String value) =>
+    RegExp(r'^[A-Z0-9_]{1,64}$').hasMatch(value) ? value : 'UNKNOWN_ERROR';
+String? _state(String? value) {
+  if (value == null) return null;
+  final normalized = value.toLowerCase();
+  return const {
+        'cached',
+        'completed',
+        'downloading',
+        'uploading',
+        'seeding',
+        'paused',
+        'stalled',
+        'queued',
+        'checking',
+        'processing',
+        'failed',
+        'error',
+        'metadl',
+        'checkingdl',
+        'checkingup',
+        'stalleddl',
+        'stalledup',
+        'queueddl',
+        'queuedup',
+      }.contains(normalized)
+      ? normalized
+      : 'other';
+}
+
+String _decoded(String value) {
+  try {
+    return Uri.decodeComponent(value);
+  } catch (_) {
+    return value;
+  }
+}
+
+// Only for privacy filtering, never for choosing a torrent member. Nested
+// escaping must not smuggle a URL, absolute path or credential into a report.
+String? _decodedForSafety(String value) {
+  var current = value;
+  for (var i = 0; i < 4; i++) {
+    final String next;
+    try {
+      next = Uri.decodeComponent(current);
+    } on FormatException {
+      return RegExp(r'%[0-9a-fA-F]{2}').hasMatch(current) ? null : current;
+    } on ArgumentError {
+      return RegExp(r'%[0-9a-fA-F]{2}').hasMatch(current) ? null : current;
+    }
+    if (next == current) return current;
+    current = next;
+  }
+  // Unfinished escaping is not useful enough to risk an obscured credential.
+  return RegExp(r'%[0-9a-fA-F]{2}').hasMatch(current) ? null : current;
+}
+
+int? _candidateRank(String? selected, DebridDiagnosticFile file) {
+  if (selected != null) {
+    final expected = selected.toLowerCase();
+    final decoded = _decoded(expected);
+    for (final name in [file.name, file.shortName].whereType<String>()) {
+      if (name.toLowerCase() == expected) return 0;
+      if (_decoded(name.toLowerCase()) == decoded) return 1;
+      Set<String> words(String text) => RegExp(r'[a-z0-9]{3,}')
+          .allMatches(text)
+          .map((m) => m.group(0)!)
+          .where(
+            (word) => !const {
+              'zip',
+              'iso',
+              'bin',
+              'rom',
+              'rvz',
+              'nkit',
+              'usa',
+              'europe',
+              'japan',
+              'rev',
+              'disc',
+              'game',
+            }.contains(word),
+          )
+          .toSet();
+      final wanted = words(decoded);
+      if (wanted.isNotEmpty &&
+          wanted.intersection(words(_decoded(name.toLowerCase()))).length >=
+              (wanted.length == 1 ? 1 : 2)) {
+        return 2;
+      }
+    }
+  }
+  return file.zipped == true && (file.name != null || file.shortName != null)
+      ? 3
+      : null;
+}
+
+String _safeMessage(String value) {
+  final message = (_decodedForSafety(value) ?? 'Download failed. Please retry.')
+      .replaceAll(RegExp(r'\x1b\[[0-?]*[ -/]*[@-~]'), '')
+      .replaceAll(RegExp(r'[\t\n\r\f\v]'), ' ')
+      .replaceAll(_controls, '')
+      .replaceAll(
+        RegExp(
+          r'(?:[a-z][a-z0-9+.-]*://|magnet:)[^\s<>]+',
+          caseSensitive: false,
+        ),
+        '[link omitted]',
+      )
+      .replaceAll(
+        RegExp(r'Bearer\s+[^\s,;]+', caseSensitive: false),
+        'Bearer [redacted]',
+      )
+      .trim();
+  return message.isEmpty
+      ? 'Download failed. Please retry.'
+      : _utf8Bound(message, 1500);
+}
+
+String _utf8Bound(String value, int limit) {
+  if (utf8.encode(value).length <= limit) return value;
+  final out = StringBuffer();
+  var length = 0;
+  for (final rune in value.runes) {
+    final next = String.fromCharCode(rune);
+    final bytes = utf8.encode(next).length;
+    if (length + bytes > limit - 3) break;
+    out.write(next);
+    length += bytes;
+  }
+  return '$out…';
+}
