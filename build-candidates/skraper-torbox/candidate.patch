@@ -0,0 +1,138 @@
+import 'dart:io';
+
+import 'package:crypto/crypto.dart';
+import 'package:path/path.dart' as p;
+
+/// The bytes of one selected, extracted ROM. Hashes are identifiers, not a
+/// claim that a file is safe or an assertion that a database knows the game.
+class RomFileIdentity {
+  const RomFileIdentity({
+    required this.filename,
+    required this.size,
+    required this.crc32,
+    required this.md5,
+    required this.sha1,
+  });
+
+  final String filename;
+  final int size;
+  final String crc32;
+  final String md5;
+  final String sha1;
+
+  Map<String, Object> toScreenScraperParameters(int systemId) => {
+    'systemeid': systemId,
+    'romtype': 'rom',
+    'romnom': filename,
+    'romtaille': size,
+    'crc': crc32,
+    'md5': md5,
+    'sha1': sha1,
+  };
+}
+
+class RomIdentificationCancelled implements Exception {
+  const RomIdentificationCancelled();
+}
+
+class RomIdentificationException implements Exception {
+  const RomIdentificationException(this.message);
+  final String message;
+  @override
+  String toString() => message;
+}
+
+class RomIdentityService {
+  static const _archives = {'.zip', '.7z', '.rar', '.gz', '.bz2', '.xz'};
+  static const _sidecars = {'.cue', '.m3u', '.m3u8', '.ccd', '.sub'};
+  static final _crcTable = List<int>.generate(256, (index) {
+    var value = index;
+    for (var bit = 0; bit < 8; bit++) {
+      value = (value & 1) != 0 ? 0xedb88320 ^ (value >>> 1) : value >>> 1;
+    }
+    return value;
+  }, growable: false);
+
+  /// Reads bounded chunks; never loads a disc image into memory in one piece.
+  /// Hashes refer to exactly the selected file, with no implicit header
+  /// stripping or concatenation of unrelated archive/sidecar contents.
+  Future<RomFileIdentity> identifyFile(
+    String path, {
+    void Function(int read, int total)? onProgress,
+    bool Function()? isCancelled,
+  }) async {
+    void checkCancelled() {
+      if (isCancelled?.call() ?? false) {
+        throw const RomIdentificationCancelled();
+      }
+    }
+
+    checkCancelled();
+    final extension = p.extension(path).toLowerCase();
+    if (_archives.contains(extension)) {
+      throw const RomIdentificationException(
+        'Extract the archive first, then choose the ROM inside it.',
+      );
+    }
+    if (_sidecars.contains(extension)) {
+      throw const RomIdentificationException(
+        'Choose the ROM or disc image instead of its playlist or cue file.',
+      );
+    }
+    final file = File(path);
+    final before = await file.stat();
+    if (before.type != FileSystemEntityType.file || before.size == 0) {
+      throw const RomIdentificationException('Choose a nonempty ROM file.');
+    }
+    final md5Result = _DigestSink();
+    final sha1Result = _DigestSink();
+    final md5Input = md5.startChunkedConversion(md5Result);
+    final sha1Input = sha1.startChunkedConversion(sha1Result);
+    var crc = 0xffffffff;
+    var read = 0;
+    onProgress?.call(0, before.size);
+    try {
+      await for (final chunk in file.openRead()) {
+        checkCancelled();
+        md5Input.add(chunk);
+        sha1Input.add(chunk);
+        for (final byte in chunk) {
+          crc = _crcTable[(crc ^ byte) & 0xff] ^ (crc >>> 8);
+        }
+        read += chunk.length;
+        onProgress?.call(read, before.size);
+      }
+    } finally {
+      md5Input.close();
+      sha1Input.close();
+    }
+    checkCancelled();
+    final after = await file.stat();
+    if (read != before.size ||
+        after.size != before.size ||
+        after.modified != before.modified ||
+        after.type != FileSystemEntityType.file) {
+      throw const RomIdentificationException(
+        'The ROM changed while it was being read. Wait for its download to finish.',
+      );
+    }
+    return RomFileIdentity(
+      filename: p.basename(path),
+      size: read,
+      crc32: ((crc ^ 0xffffffff) & 0xffffffff)
+          .toRadixString(16)
+          .padLeft(8, '0')
+          .toUpperCase(),
+      md5: md5Result.value!.toString(),
+      sha1: sha1Result.value!.toString(),
+    );
+  }
+}
+
+class _DigestSink implements Sink<Digest> {
+  Digest? value;
+  @override
+  void add(Digest data) => value = data;
+  @override
+  void close() {}
+}
