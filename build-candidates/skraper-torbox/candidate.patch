+({String key, String semantic}) _identity(String raw) {
+  final identity = catalogTitleIdentity(raw.trim());
+  // cleanMetadataTitle is safe only after catalog identity has removed known
+  // release tags and no meaningful bracketed edition remains.
+  final base = RegExp(r'[\[\]()]').hasMatch(identity.title)
+      ? identity.title
+      : cleanMetadataTitle(identity.title);
+  final extras =
+      identity.qualifiers
+          .where(_extraQualifier.hasMatch)
+          .map((value) => value.toLowerCase().replaceAll(RegExp(r'\s+'), ' '))
+          .toSet()
+          .toList()
+        ..sort();
+  final meaningful = RegExp(r'\([^()]*\)|\[[^\[\]]*\]')
+      .allMatches(identity.title)
+      .map((match) => match[0]!.toLowerCase())
+      .join('|');
+  final extra = extras.isNotEmpty
+      ? extras.join('|')
+      : (identity.extra ? 'extra' : '');
+  final key = base.toLowerCase().trim();
+  return (
+    key: extra.isEmpty ? key : '$key\u001f$extra',
+    semantic: '$meaningful\u001f$extra',
+  );
+}
