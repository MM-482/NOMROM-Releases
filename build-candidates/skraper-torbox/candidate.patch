+      platform: platformKey,
+      sourceName: p.basename(gamelistPath),
+      imageRole: imageRole,
+      items: items,
+      issues: issues,
+      skippedCount: skipped,
+      ambiguousAliasCount: ambiguous,
+      drafts: drafts,
+      issuer: _issuer,
+    );
+  }
