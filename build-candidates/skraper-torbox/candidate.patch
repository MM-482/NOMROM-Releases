+        'A late provider failure.',
+        code: 'ACTIVE_LIMIT',
+        permanent: true,
+      ),
+    );
+    db.rows['paused'] = _task('paused');
+    downloads.setMaxConcurrentDownloads(1);
+    await debrid.started['paused.rom']!.future;
+    await downloads.pauseDownload('paused');
+    debrid.release['paused.rom']!.complete();
+    await Future<void>.delayed(const Duration(milliseconds: 30));
+    expect(db.rows['paused']!.status, DownloadStatus.paused);
+    expect(db.rows['paused']!.error, isNull);
+    expect(torrents.added, isEmpty);
+    expect(transport.calls, isEmpty);
