+  final List<int> extra;
+  final List<int>? localExtra;
+}
+
+class _LeBytes {
+  final bytes = BytesBuilder(copy: false);
+  void u16(int value) {
+    final d = ByteData(2)..setUint16(0, value, Endian.little);
+    bytes.add(d.buffer.asUint8List());
+  }
+
+  void u32(int value) {
+    final d = ByteData(4)..setUint32(0, value, Endian.little);
+    bytes.add(d.buffer.asUint8List());
+  }
+
+  void u64(int value) {
+    final d = ByteData(8)..setUint64(0, value, Endian.little);
+    bytes.add(d.buffer.asUint8List());
+  }
+
+  void add(List<int> value) => bytes.add(value);
+  Uint8List take() => bytes.takeBytes();
+}
+
+// Deliberately independent, bit-at-a-time fixture CRC. The standard check value
+// for ASCII '123456789' is also asserted below.
+int _crc(List<int> bytes) {
+  var crc = 0xffffffff;
+  for (final byte in bytes) {
+    crc ^= byte;
+    for (var bit = 0; bit < 8; bit++) {
+      crc = crc & 1 == 1 ? (crc >>> 1) ^ 0xedb88320 : crc >>> 1;
+    }
+  }
+  return (crc ^ 0xffffffff) & 0xffffffff;
+}
+
+class _Segment {
+  _Segment(this.offset, this.bytes);
+  final int offset;
+  final Uint8List bytes;
+}
+
+class _Zip {
+  _Zip(
+    this.entries, {
+    bool zip64 = false,
+    int localBase = 0,
+    int gap = 70000,
+    int? exactLength,
+    List<int> comment = const [],
+  }) {
+    var cursor = localBase;
+    final central = _LeBytes();
+    for (final entry in entries) {
+      final name = entry.rawName ?? utf8.encode(entry.name);
+      final localName = entry.localName == null
+          ? name
+          : utf8.encode(entry.localName!);
+      final compressed =
+          entry.compressedOverride ??
+          (entry.method == 8
+              ? ZLibEncoder(raw: true).convert(entry.bytes)
+              : entry.bytes);
+      final size = entry.sizeOverride ?? entry.bytes.length;
+      final crc = entry.crcOverride ?? _crc(entry.bytes);
+      final flags = entry.flags | (entry.descriptor ? 8 : 0);
+      final localFlags = entry.localFlags ?? flags;
+      final needed = zip64 ? 45 : 20;
+      final localZip64 = _LeBytes();
+      final centralZip64 = _LeBytes();
+      if (zip64) {
+        localZip64.u16(1);
+        localZip64.u16(16);
+        localZip64.u64(entry.localSize ?? size);
+        localZip64.u64(compressed.length);
+        centralZip64.u16(1);
+        centralZip64.u16(24);
+        centralZip64.u64(size);
+        centralZip64.u64(compressed.length);
+        centralZip64.u64(cursor);
+      }
+      final localExtra = [
+        ...localZip64.take(),
+        ...entry.localExtra ?? entry.extra,
+      ];
+      final centralExtra = [...centralZip64.take(), ...entry.extra];
+      final local = _LeBytes();
+      local.u32(0x04034b50);
+      local.u16(needed);
+      local.u16(localFlags);
+      local.u16(entry.localMethod ?? entry.method);
+      local.u16(0);
+      local.u16(0);
+      local.u32(entry.descriptor ? 0 : crc);
+      local.u32(
+        zip64
+            ? 0xffffffff
+            : entry.descriptor
+            ? 0
+            : compressed.length,
+      );
+      local.u32(
+        zip64
+            ? 0xffffffff
+            : entry.descriptor
+            ? 0
+            : entry.localSize ?? size,
+      );
+      local.u16(localName.length);
+      local.u16(localExtra.length);
+      local.add(localName);
+      local.add(localExtra);
+      final localBytes = local.take();
+      localOffsets.add(cursor);
+      dataOffsets.add(cursor + localBytes.length);
+      compressedSizes.add(compressed.length);
+      segments.add(_Segment(cursor, localBytes));
+      segments.add(
+        _Segment(cursor + localBytes.length, Uint8List.fromList(compressed)),
+      );
+
+      central.u32(0x02014b50);
+      central.u16((entry.creator << 8) | needed);
+      central.u16(needed);
+      central.u16(flags);
+      central.u16(entry.method);
+      central.u16(0);
+      central.u16(0);
+      central.u32(crc);
+      central.u32(zip64 ? 0xffffffff : compressed.length);
+      central.u32(zip64 ? 0xffffffff : size);
+      central.u16(name.length);
+      central.u16(centralExtra.length);
+      central.u16(0);
+      central.u16(0);
+      central.u16(0);
+      central.u32(entry.attributes);
+      central.u32(zip64 ? 0xffffffff : cursor);
+      central.add(name);
+      central.add(centralExtra);
+      cursor += localBytes.length + compressed.length;
+      if (entry.descriptor) {
+        final descriptor = _LeBytes();
+        if (entry.signedDescriptor) descriptor.u32(0x08074b50);
+        descriptor.u32(crc);
+        if (zip64) {
+          descriptor.u64(compressed.length);
+          descriptor.u64(size);
+        } else {
+          descriptor.u32(compressed.length);
+          descriptor.u32(size);
+        }
+        final bytes = descriptor.take();
+        segments.add(_Segment(cursor, bytes));
+        cursor += bytes.length;
+      }
+    }
+    final centralBytes = central.take();
+    final endLength = 22 + comment.length + (zip64 ? 76 : 0);
+    directoryOffset = exactLength == null
+        ? cursor + gap
+        : exactLength - endLength - centralBytes.length;
+    if (directoryOffset < cursor) {
+      throw StateError('Invalid synthetic ZIP layout');
+    }
+    directorySize = centralBytes.length;
+    segments.add(_Segment(directoryOffset, centralBytes));
+    cursor = directoryOffset + centralBytes.length;
+    final end = _LeBytes();
+    if (zip64) {
+      end.u32(0x06064b50);
+      end.u64(44);
+      end.u16(45);
+      end.u16(45);
+      end.u32(0);
+      end.u32(0);
+      end.u64(entries.length);
+      end.u64(entries.length);
+      end.u64(centralBytes.length);
+      end.u64(directoryOffset);
+      end.u32(0x07064b50);
+      end.u32(0);
+      end.u64(cursor);
+      end.u32(1);
+    }
+    end.u32(0x06054b50);
+    end.u16(0);
+    end.u16(0);
+    end.u16(zip64 ? 0xffff : entries.length);
+    end.u16(zip64 ? 0xffff : entries.length);
+    end.u32(zip64 ? 0xffffffff : centralBytes.length);
+    end.u32(zip64 ? 0xffffffff : directoryOffset);
+    end.u16(comment.length);
+    end.add(comment);
+    final endBytes = end.take();
+    segments.add(_Segment(cursor, endBytes));
+    length = cursor + endBytes.length;
+  }
+
+  final List<_Entry> entries;
+  final segments = <_Segment>[];
+  final localOffsets = <int>[];
+  final dataOffsets = <int>[];
+  final compressedSizes = <int>[];
+  late final int directoryOffset;
+  late final int directorySize;
+  late final int length;
+
+  Uint8List range(int start, int end) {
+    final bytes = Uint8List(end - start + 1);
+    for (final segment in segments) {
+      final from = math.max(start, segment.offset);
+      final to = math.min(end + 1, segment.offset + segment.bytes.length);
+      if (from < to) {
+        bytes.setRange(
+          from - start,
+          to - start,
+          segment.bytes,
+          from - segment.offset,
+        );
+      }
+    }
+    return bytes;
+  }
+
+  void patch32(int offset, int value) {
+    final bytes = ByteData(4)..setUint32(0, value, Endian.little);
+    segments.add(_Segment(offset, bytes.buffer.asUint8List()));
+  }
+
+  void patch16(int offset, int value) {
+    final bytes = ByteData(2)..setUint16(0, value, Endian.little);
+    segments.add(_Segment(offset, bytes.buffer.asUint8List()));
+  }
+}
+
+typedef _Handler =
+    Future<bool> Function(HttpRequest request, int start, int end);
+
+class _Harness {
+  _Harness(this.zip, this.folder, this.server, this.dio);
+  final _Zip zip;
+  final Directory folder;
+  final HttpServer server;
+  final Dio dio;
+  final requests = <(int, int)>[];
+  final seenIfMatch = <String?>[];
+  final seenIdentity = <String?>[];
+  final seenCredentials = <String?>[];
+  String? etag = '"synthetic-v1"';
+  String? lastModified;
+  _Handler? handler;
+  int bytesSent = 0;
+  File get destination => File(p.join(folder.path, 'selected.zip'));
+  String get url => 'http://127.0.0.1:${server.port}/archive';
+
+  static Future<_Harness> start(_Zip zip) async {
+    final folder = await Directory.systemTemp.createTemp('nomrom-remote-zip-');
+    final server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+    final dio = Dio();
+    final result = _Harness(zip, folder, server, dio);
+    server.listen((request) async {
+      try {
+        final range = RegExp(
+          r'^bytes=(\d+)-(\d+)$',
+        ).firstMatch(request.headers.value('range') ?? '');
+        if (range == null) {
+          request.response.statusCode = 400;
+          await request.response.close();
+          return;
+        }
+        final start = int.parse(range[1]!);
+        final end = int.parse(range[2]!);
+        result.requests.add((start, end));
+        result.seenIfMatch.add(request.headers.value('if-match'));
+        result.seenIdentity.add(request.headers.value('accept-encoding'));
+        result.seenCredentials.add(request.headers.value('authorization'));
+        result.seenCredentials.add(request.headers.value('cookie'));
+        if (result.handler != null &&
+            await result.handler!(request, start, end)) {
+          return;
+        }
+        request.response.statusCode = 206;
+        request.response.headers.set(
+          'Content-Range',
+          'bytes $start-$end/${zip.length}',
+        );
+        request.response.headers.contentLength = end - start + 1;
+        if (result.etag != null) {
+          request.response.headers.set('ETag', result.etag!);
+        }
+        if (result.lastModified != null) {
+          request.response.headers.set('Last-Modified', result.lastModified!);
+        }
+        final bytes = zip.range(start, end);
+        request.response.add(bytes);
+        result.bytesSent += bytes.length;
+        await request.response.close();
+      } on HttpException {
+        // Client may reject a response before reading its body.
+      } on SocketException {
+        // Explicit cancellation closes the task's range connection.
+      }
+    });
+    addTearDown(() async {
+      dio.close(force: true);
+      await server.close(force: true);
+      await folder.delete(recursive: true);
+    });
+    return result;
+  }
+
+  TorrentFileSelectionProof proof({
+    String? selectedPath,
+    int? expectedSize,
+    List<TorrentFileIdentity>? members,
+  }) => TorrentFileSelectionProof.tryCreate(
+    infohash: _hash,
+    fileIndex: 0,
+    filePath: selectedPath ?? zip.entries.first.name,
+    expectedSize: expectedSize ?? zip.entries.first.bytes.length,
+    members:
+        members ??
+        [
+          for (var i = 0; i < zip.entries.length; i++)
+            if (!zip.entries[i].name.endsWith('/'))
+              TorrentFileIdentity(
+                index: i,
+                path: i == 0
+                    ? selectedPath ?? zip.entries[i].name
+                    : zip.entries[i].name,
+                size: i == 0
+                    ? expectedSize ?? zip.entries[i].bytes.length
+                    : zip.entries[i].bytes.length,
+              ),
+        ],
+  )!;
+
+  Future<void> download({
+    TorrentFileSelectionProof? selection,
+    CancelToken? cancelToken,
+    ProgressCallback? onProgress,
+  }) => RemoteZipService(dio: dio).download(
+    target: RemoteZipTarget(
+      url: url,
+      archiveSize: zip.length,
+      selectionProof: selection ?? proof(),
+    ),
+    destination: destination,
+    cancelToken: cancelToken ?? CancelToken(),
+    onReceiveProgress: onProgress ?? (_, _) {},
+  );
+
+  Future<void> expectPreservedFailure(
+    Object matcher, {
+    TorrentFileSelectionProof? selection,
+    CancelToken? cancelToken,
+  }) async {
+    await destination.writeAsString('existing selected file');
+    await expectLater(
+      download(selection: selection, cancelToken: cancelToken),
+      throwsA(matcher),
+    );
+    expect(await destination.readAsString(), 'existing selected file');
+    expect((await folder.list().toList()).map((f) => p.basename(f.path)), [
+      'selected.zip',
+    ]);
+  }
+}
+
+Matcher _code(String code) =>
+    isA<RemoteZipException>().having((e) => e.code, 'code', code);
