+}
+
+class SkraperImportPreview {
+  /// Public presentation DTO; only previews produced by
+  /// [SkraperImportService.previewFile] can be
+  /// committed. Tests/UI adapters can use this constructor without file I/O.
+  const SkraperImportPreview({
+    required this.platform,
+    this.sourceName = 'gamelist.xml',
+    this.imageRole = SkraperImageRole.artwork,
+    this.items = const [],
+    this.issues = const [],
