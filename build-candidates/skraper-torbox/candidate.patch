+import 'dart:convert';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:romgi/services/debrid/debrid_provider.dart';
+import 'package:romgi/services/debrid/torbox_provider.dart';
+
+import 'debrid_test_utils.dart';
+
+// Catalog metadata only; no ROM bytes or authenticated provider responses.
+// Halo Rev 2 is from caprado/romgi catalog 20261101, commit d209b51a9cc8050e62b80390415f9295c23e0dec.
+const _hash = '068a566699b1136a64dca807286b3bdb5403458d';
+const _filename = 'Halo - Combat Evolved (USA) (Rev 2).zip';
+const _path = 'Redump/Microsoft - Xbox/$_filename';
+const _size = 6884752659;
+const _request = DebridFileRequest(
+  infohash: _hash,
+  magnet: 'magnet:?xt=urn:btih:$_hash',
+  fileIndex: 893,
+  filePath: _path,
+  expectedSize: _size,
+);
+
+void main() {
+  Future<(DebridResult, StubAdapter)> resolve(
+    List<Map<String, Object?>> files, {
+    DebridFileRequest request = _request,
+  }) async {
+    final dio = stubbedDio('https://api.torbox.app/v1/api', {
+      '/v1/api/torrents/createtorrent': (_) => jsonBody(
+        jsonEncode({
+          'success': true,
+          'data': {'torrent_id': 42, 'hash': _hash},
+        }),
+      ),
+      '/v1/api/torrents/mylist': (_) => jsonBody(
+        jsonEncode({
+          'success': true,
+          'data': {
+            'id': 42,
+            'hash': _hash,
+            'download_present': true,
+            'download_finished': true,
+            'files': files,
+          },
+        }),
+      ),
+      '/v1/api/torrents/requestdl': (_) => jsonBody(
+        jsonEncode({
+          'success': true,
+          'data': 'https://download.example/selected-file',
+        }),
+      ),
+    });
+    final result = await TorboxProvider(
+      dio: dio,
+    ).resolveFile(request, apiKey: 'fixture-key');
+    return (result, dio.httpClientAdapter as StubAdapter);
+  }
+
+  test('documented short_name works when name is absent or blank', () async {
+    for (final name in [null, '', '  ']) {
+      final (result, adapter) = await resolve([
+        {
+          'id': 7,
+          'short_name': 'Halo - Combat Evolved (USA).zip',
+          'size': _size,
+        },
+        {'id': 906, 'name': name, 'short_name': _filename, 'size': _size},
+      ]);
+      expect(result, isA<DebridReady>());
+      expect((result as DebridReady).filename, _filename);
+      expect(adapter.calls.last.uri.queryParameters['file_id'], '906');
+    }
+  });
+
+  test('encoded provider path matches the exact selected revision', () async {
+    final (result, adapter) = await resolve([
+      {'id': 5, 'name': _path.replaceAll(' (Rev 2)', ''), 'size': _size},
+      {
+        'id': 99,
+        'name': _path.split('/').map(Uri.encodeComponent).join('/'),
+        'size': _size,
+      },
+    ]);
+    expect(result, isA<DebridReady>());
+    expect(adapter.calls.last.uri.queryParameters['file_id'], '99');
+  });
+
+  test(
+    'raw literal percent filename wins before decoded alternatives',
+    () async {
+      final (result, adapter) = await resolve(
+        [
+          {'id': 11, 'name': 'Game Name.zip', 'size': 1000},
+          {'id': 14, 'name': 'Game%20Name.zip', 'size': 1000},
+        ],
+        request: const DebridFileRequest(
+          infohash: _hash,
+          magnet: 'magnet:?xt=urn:btih:$_hash',
+          fileIndex: 0,
+          filePath: 'Game%20Name.zip',
+          expectedSize: 1000,
+        ),
+      );
+      expect(result, isA<DebridReady>());
+      expect(adapter.calls.last.uri.queryParameters['file_id'], '14');
+    },
+  );
+
+  test('percent decoding preserves literal plus signs', () async {
+    final (result, adapter) = await resolve(
+      [
+        {'id': 12, 'name': 'Game+Plus%20%28Rev%202%29.zip', 'size': 1000},
+        {'id': 13, 'name': 'Game Plus (Rev 2).zip', 'size': 1000},
+      ],
+      request: const DebridFileRequest(
+        infohash: _hash,
+        magnet: 'magnet:?xt=urn:btih:$_hash',
+        fileIndex: 0,
+        filePath: 'Game+Plus (Rev 2).zip',
+        expectedSize: 1000,
+      ),
+    );
+    expect(result, isA<DebridReady>());
+    expect(adapter.calls.last.uri.queryParameters['file_id'], '12');
+  });
+
+  test(
+    'a short_name cannot erase conflicting explicit game directories',
+    () async {
+      final (result, adapter) = await resolve(
+        [
+          {
+            'id': 12,
+            'name': 'Other Game/disc1.bin',
+            'short_name': 'disc1.bin',
+            'size': 1000,
+          },
+        ],
+        request: const DebridFileRequest(
+          infohash: _hash,
+          magnet: 'magnet:?xt=urn:btih:$_hash',
+          fileIndex: 0,
+          filePath: 'Selected Game/disc1.bin',
+          expectedSize: 1000,
+        ),
+      );
+      expect((result as DebridError).code, 'FILE_NOT_FOUND');
+      expect(adapter.calls.length, 2);
+    },
+  );
+
+  test('duplicate short names with the same size remain ambiguous', () async {
+    final (result, adapter) = await resolve([
+      {'id': 1, 'short_name': _filename, 'size': _size},
+      {'id': 2, 'short_name': _filename, 'size': _size},
+    ]);
+    expect((result as DebridError).code, 'FILE_AMBIGUOUS');
+    expect(adapter.calls.length, 2);
+  });
+
+  test(
+    'completed torrent with empty file metadata can become ready on a later poll',
+    () async {
+      var lists = 0;
+      final dio = stubbedDio('https://api.torbox.app/v1/api', {
+        '/v1/api/torrents/createtorrent': (_) => jsonBody(
+          jsonEncode({
+            'success': true,
+            'data': {'torrent_id': 42, 'hash': _hash},
+          }),
+        ),
+        '/v1/api/torrents/mylist': (_) => jsonBody(
+          jsonEncode({
+            'success': true,
+            'data': {
+              'id': 42,
+              'hash': _hash,
+              'download_present': true,
+              'download_finished': true,
+              'progress': 1.0,
+              'files': lists++ == 0
+                  ? []
+                  : [
+                      {'id': 77, 'name': _path, 'size': _size},
+                    ],
+            },
+          }),
+        ),
+        '/v1/api/torrents/requestdl': (_) => jsonBody(
+          jsonEncode({
+            'success': true,
+            'data': 'https://download.example/selected-file',
+          }),
+        ),
+      });
+      final provider = TorboxProvider(dio: dio);
+      expect(
+        await provider.resolveFile(_request, apiKey: 'fixture-key'),
+        isA<DebridCaching>(),
+      );
+      expect(
+        await provider.resolveFile(_request, apiKey: 'fixture-key'),
+        isA<DebridReady>(),
+      );
+      final calls = (dio.httpClientAdapter as StubAdapter).calls;
+      expect(
+        calls.where((call) => call.uri.path.endsWith('/createtorrent')).length,
+        1,
+      );
+      expect(calls.last.uri.queryParameters['file_id'], '77');
+    },
+  );
+}
