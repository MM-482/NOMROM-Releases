@@ -0,0 +1,274 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:romgi/models/torrent_file_selection_proof.dart';
+
+const _hash = '0123456789abcdef0123456789abcdef01234567';
+const _maxInteger = 9007199254740991;
+const _members = [
+  TorrentFileIdentity(index: 0, path: 'Collection/Game.zip', size: 42),
+  TorrentFileIdentity(index: 1, path: 'Collection/Other.zip', size: 10),
+];
+
+TorrentFileSelectionProof? _proof({
+  String infohash = _hash,
+  int fileIndex = 0,
+  String filePath = 'Collection/Game.zip',
+  int expectedSize = 42,
+  Iterable<TorrentFileIdentity> members = _members,
+}) => TorrentFileSelectionProof.tryCreate(
+  infohash: infohash,
+  fileIndex: fileIndex,
+  filePath: filePath,
+  expectedSize: expectedSize,
+  members: members,
+);
+
+void main() {
+  test('complete unordered members produce canonical immutable evidence', () {
+    final mutable = [
+      _members[1],
+      _members[0],
+      const TorrentFileIdentity(
+        index: 0,
+        path: r'./COLLECTION\Game.ZIP',
+        size: 42,
+      ),
+    ];
+    final proof = _proof(
+      infohash: _hash.toUpperCase(),
+      filePath: r'./COLLECTION\Game.ZIP',
+      members: mutable,
+    )!;
+    mutable.clear();
+    expect(proof.infohash, _hash);
+    expect(proof.fileIndex, 0);
+    expect(proof.filePath, 'collection/game.zip');
+    expect(proof.expectedSize, 42);
+    expect(proof.fileCount, 2);
+    expect(proof.totalSize, 52);
+    expect(proof.uniqueFilename, isTrue);
+    expect(proof.uniqueDecodedFilename, isTrue);
+  });
+
+  test('missing members and conflicting duplicate indices give no proof', () {
+    expect(_proof(members: []), isNull);
+    expect(_proof(members: [_members[1]]), isNull);
+    expect(
+      _proof(
+        members: [
+          _members[0],
+          const TorrentFileIdentity(index: 2, path: 'Third.zip', size: 1),
+        ],
+      ),
+      isNull,
+    );
+    for (final conflicting in [
+      const TorrentFileIdentity(index: 0, path: 'Wrong.zip', size: 42),
+      const TorrentFileIdentity(
+        index: 0,
+        path: 'Collection/Game.zip',
+        size: 43,
+      ),
+    ]) {
+      expect(_proof(members: [..._members, conflicting]), isNull);
+    }
+  });
+
+  test('the selected index path and positive size must agree exactly', () {
+    expect(_proof(fileIndex: 1), isNull);
+    expect(_proof(fileIndex: 2), isNull);
+    expect(_proof(filePath: 'Wrong/Game.zip'), isNull);
+    expect(_proof(expectedSize: 41), isNull);
+    expect(_proof(expectedSize: 0), isNull);
+    expect(
+      _proof(
+        filePath: 'Collection/Game%20One.zip',
+        members: [
+          const TorrentFileIdentity(
+            index: 0,
+            path: 'Collection/Game One.zip',
+            size: 42,
+          ),
+        ],
+      ),
+      isNull,
+    );
+  });
+
+  test('basename and exact size uniqueness are independent of directories', () {
+    final ambiguous = _proof(
+      members: [
+        _members[0],
+        const TorrentFileIdentity(index: 1, path: 'Other/GAME.zip', size: 42),
+      ],
+    )!;
+    expect(ambiguous.uniqueFilename, isFalse);
+    expect(ambiguous.uniqueDecodedFilename, isFalse);
+    final differentSize = _proof(
+      members: [
+        _members[0],
+        const TorrentFileIdentity(index: 1, path: 'Other/GAME.zip', size: 43),
+      ],
+    )!;
+    expect(differentSize.uniqueFilename, isTrue);
+    expect(differentSize.uniqueDecodedFilename, isTrue);
+  });
+
+  test('decoding can make a literal unique filename ambiguous', () {
+    final proof = _proof(
+      filePath: 'A/Game%20One.zip',
+      members: [
+        const TorrentFileIdentity(index: 0, path: 'A/Game%20One.zip', size: 42),
+        const TorrentFileIdentity(index: 1, path: 'B/Game One.zip', size: 42),
+      ],
+    )!;
+    expect(proof.filePath, 'a/game%20one.zip');
+    expect(proof.uniqueFilename, isTrue);
+    expect(proof.uniqueDecodedFilename, isFalse);
+  });
+
+  test('decoding is once only and plus is a literal filename character', () {
+    final proof = _proof(
+      filePath: 'A/Game%2520+One.zip',
+      members: [
+        const TorrentFileIdentity(
+          index: 0,
+          path: 'A/Game%2520+One.zip',
+          size: 42,
+        ),
+        const TorrentFileIdentity(index: 1, path: 'B/Game +One.zip', size: 42),
+        const TorrentFileIdentity(
+          index: 2,
+          path: 'B/Game%20 One.zip',
+          size: 42,
+        ),
+      ],
+    )!;
+    expect(proof.uniqueDecodedFilename, isTrue);
+    expect(
+      normalizeTorrentFilePath(r'  ./Root\Game%20+One.ZIP  ', decode: true),
+      'root/game +one.zip',
+    );
+    expect(
+      normalizeTorrentFilePath('Root/Game%2520.zip', decode: true),
+      'root/game%20.zip',
+    );
+    expect(
+      normalizeTorrentFilePath('Root/100% Game.zip', decode: true),
+      'root/100% game.zip',
+    );
+  });
+
+  test('shared comparison keeps existing leading-root normalization', () {
+    expect(normalizeTorrentFilePath('  /A//./B/../Game.ZIP '), 'a/game.zip');
+    expect(normalizeTorrentFilePath('  '), '');
+    expect(normalizeTorrentFilePath('A/Game%20One.zip'), 'a/game%20one.zip');
+  });
+
+  for (final path in [
+    '',
+    '.',
+    '/',
+    '..',
+    '../Game.zip',
+    'A/../Game.zip',
+    '/Root/Game.zip',
+    r'C:\Games\Game.zip',
+    'C:Game.zip',
+    './C:/Game.zip',
+    r'\\server\Game.zip',
+    'A/\u0000Game.zip',
+    'A/\nGame.zip',
+    'A/Game.zip\n',
+    'A/Game.zip/',
+    'A/.',
+    '%2fRoot/Game.zip',
+    'A/%2e%2e/Game.zip',
+    'A/%00Game.zip',
+  ]) {
+    test('unsafe member or selected path ${path.codeUnits} gives no proof', () {
+      expect(_proof(filePath: path), isNull);
+      expect(
+        _proof(
+          members: [
+            _members[0],
+            TorrentFileIdentity(index: 1, path: path, size: 0),
+          ],
+        ),
+        isNull,
+      );
+    });
+  }
+
+  test('hash must contain exactly forty hexadecimal characters', () {
+    for (final hash in [
+      '',
+      '${_hash}0',
+      _hash.substring(1),
+      'g$_hash',
+      ' $_hash',
+    ]) {
+      expect(_proof(infohash: hash), isNull);
+    }
+  });
+
+  test('negative and imprecisely representable integers give no proof', () {
+    for (final number in [-1, _maxInteger + 1]) {
+      expect(_proof(fileIndex: number), isNull);
+      expect(_proof(expectedSize: number), isNull);
+      expect(
+        _proof(
+          members: [
+            _members[0],
+            TorrentFileIdentity(index: number, path: 'Other.zip', size: 0),
+          ],
+        ),
+        isNull,
+      );
+      expect(
+        _proof(
+          members: [
+            _members[0],
+            TorrentFileIdentity(index: 1, path: 'Other.zip', size: number),
+          ],
+        ),
+        isNull,
+      );
+    }
+  });
+
+  test('zero-byte other members count and sums cannot overflow the bound', () {
+    final proof = _proof(
+      members: [
+        _members[0],
+        const TorrentFileIdentity(index: 1, path: 'Empty.txt', size: 0),
+      ],
+    )!;
+    expect(proof.fileCount, 2);
+    expect(proof.totalSize, 42);
+    final maximum = _proof(
+      expectedSize: _maxInteger,
+      members: [
+        const TorrentFileIdentity(
+          index: 0,
+          path: 'Collection/Game.zip',
+          size: _maxInteger,
+        ),
+      ],
+    )!;
+    expect(maximum.totalSize, _maxInteger);
+    expect(
+      _proof(
+        expectedSize: _maxInteger,
+        members: [
+          const TorrentFileIdentity(
+            index: 0,
+            path: 'Collection/Game.zip',
+            size: _maxInteger,
+          ),
+          const TorrentFileIdentity(index: 1, path: 'Other.zip', size: 1),
+        ],
+      ),
+      isNull,
+    );
+  });
+}
