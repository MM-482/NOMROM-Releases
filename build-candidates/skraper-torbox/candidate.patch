+  ) async {
+    final backend = _Backend()..importError = StateError('test disk failure');
+    var refreshes = 0;
+    await _mount(tester, backend, onChanged: () async => refreshes++);
+    await _openPreview(tester);
+    await tester.tap(find.byKey(const ValueKey('skraper-confirm-import')));
+    await tester.pumpAndSettle();
+    expect(refreshes, 0);
+    expect(find.text('0 imported games · 0 saved images'), findsOneWidget);
+    expect(find.textContaining('Could not finish the import.'), findsOneWidget);
+  });
+
+  testWidgets('a refresh failure does not misreport a saved import as failed', (
+    tester,
+  ) async {
+    final backend = _Backend();
+    await _mount(
+      tester,
+      backend,
+      onChanged: () async => throw StateError('refresh is unavailable'),
+    );
+    await _openPreview(tester);
+    await tester.tap(find.byKey(const ValueKey('skraper-confirm-import')));
+    await tester.pumpAndSettle();
+    expect(find.text('Imported 2 games and 2 images.'), findsOneWidget);
+    expect(find.text('2 imported games · 2 saved images'), findsOneWidget);
+    await tester.tap(find.text('1 import notice'));
+    await tester.pumpAndSettle();
+    expect(find.textContaining('The import was saved'), findsOneWidget);
+    expect(find.textContaining('Could not finish the import'), findsNothing);
+  });
+
+  testWidgets(
+    'reimport reports unchanged games without claiming new additions',
+    (tester) async {
+      final backend = _Backend()
+        ..games = 2
+        ..images = 2
+        ..summary = const SkraperImportSummary(unchangedGames: 2);
+      await _mount(tester, backend);
+      await _openPreview(tester);
+      await tester.tap(find.byKey(const ValueKey('skraper-confirm-import')));
+      await tester.pumpAndSettle();
+      expect(find.text('Already imported. 2 games unchanged.'), findsOneWidget);
+      expect(find.text('2 imported games · 2 saved images'), findsOneWidget);
+    },
+  );
+
+  testWidgets('remove action requires confirmation scoped to NOMROM copies', (
+    tester,
+  ) async {
+    final backend = _Backend()
+      ..games = 3
+      ..images = 4;
+    var refreshes = 0;
+    await _mount(tester, backend, onChanged: () async => refreshes++);
+    await tester.tap(find.byKey(const ValueKey('skraper-remove-imports')));
+    await tester.pumpAndSettle();
+    expect(
+      find.textContaining('Remove 3 imported games and 4 copied images'),
+      findsOneWidget,
+    );
+    expect(find.textContaining('Your original game lists'), findsOneWidget);
+    await tester.tap(find.text('Cancel'));
+    await tester.pumpAndSettle();
+    expect(backend.clearCalls, 0);
+    await tester.tap(find.byKey(const ValueKey('skraper-remove-imports')));
+    await tester.pumpAndSettle();
+    await tester.tap(find.byKey(const ValueKey('skraper-confirm-remove')));
+    await tester.pumpAndSettle();
+    expect(backend.clearCalls, 1);
+    expect(refreshes, 1);
+    expect(find.text('0 imported games · 0 saved images'), findsOneWidget);
+  });
+
+  testWidgets(
+    'finishing import after Settings closes still refreshes metadata',
+    (tester) async {
+      final gate = Completer<SkraperImportSummary>();
+      final backend = _Backend()..importGate = gate;
+      var refreshes = 0;
+      await _mount(tester, backend, onChanged: () async => refreshes++);
+      await _openPreview(tester);
+      await tester.tap(find.byKey(const ValueKey('skraper-confirm-import')));
+      await tester.pump();
+      await tester.pump(const Duration(milliseconds: 300));
+      expect(backend.importCalls, 1);
+      await tester.pumpWidget(const SizedBox.shrink());
+      gate.complete(_summary);
+      await tester.pump();
+      expect(refreshes, 1);
+      expect(tester.takeException(), isNull);
+    },
+  );
+
+  testWidgets('cancelled preview ignores its later result', (tester) async {
+    final gate = Completer<SkraperImportPreview>();
+    final backend = _Backend()..previewGate = gate;
+    await _mount(tester, backend);
+    await tester.tap(find.byKey(const ValueKey('skraper-choose-file')));
+    await tester.pumpAndSettle();
+    await _choosePlatform(tester, 'Nintendo — NES (nes)');
+    await tester.tap(find.byKey(const ValueKey('skraper-preview-button')));
+    await tester.pump();
+    await tester.tap(find.text('Cancel'));
+    await tester.pumpAndSettle();
+    gate.complete(_preview());
+    await tester.pump();
+    expect(backend.importCalls, 0);
+    expect(tester.takeException(), isNull);
+  });
+
+  testWidgets('catalog failure keeps offline platform selection available', (
+    tester,
+  ) async {
+    final backend = _Backend();
+    await _mount(
+      tester,
+      backend,
+      loadPlatforms: () async => throw StateError('catalog is unavailable'),
+    );
+    await tester.tap(find.byKey(const ValueKey('skraper-choose-file')));
+    await tester.pumpAndSettle();
+    await _choosePlatform(tester, 'NES (nes)');
+    await tester.tap(find.byKey(const ValueKey('skraper-preview-button')));
+    await tester.pumpAndSettle();
+    expect(backend.requestedPlatforms, ['nes']);
+  });
+
+  testWidgets('preview remains usable at desktop width with 1.5x text', (
+    tester,
+  ) async {
+    final backend = _Backend()
+      ..preview = _preview(
+        issues: const [
+          'One missing local image will be skipped; its game details can still be imported.',
+        ],
+      );
+    await _mount(tester, backend, textScale: 1.5);
+    await _openPreview(tester);
+    final importButton = find.byKey(const ValueKey('skraper-confirm-import'));
+    expect(tester.widget<FilledButton>(importButton).onPressed, isNotNull);
+    expect(tester.getRect(importButton).bottom, lessThan(900));
+    expect(tester.takeException(), isNull);
+  });
+
+  testWidgets('ROM identification uses its own action without importing', (
+    tester,
+  ) async {
+    final backend = _Backend();
+    var identifications = 0;
+    await _mount(
+      tester,
+      backend,
+      identifyRom: () async => identifications++,
+      textScale: 1.5,
+    );
+    await tester.tap(find.byKey(const ValueKey('skraper-identify-rom')));
+    await tester.pumpAndSettle();
+    expect(identifications, 1);
+    expect(backend.importCalls, 0);
+    expect(backend.previewCalls, 0);
+    expect(tester.takeException(), isNull);
+  });
+}
