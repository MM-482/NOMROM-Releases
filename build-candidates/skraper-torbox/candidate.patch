+
+class _Service extends InertDownloadService {
+  final List<DownloadTask> failed;
+  final actions = <String>[];
+  _Service(this.failed);
+
+  @override
+  Future<List<DownloadTask>> getFailedDownloads() async => failed;
+  @override
+  Future<void> retryDownload(String id) async => actions.add('retry:$id');
+  @override
+  Future<void> cancelDownload(String id) async => actions.add('cancel:$id');
+}
+
+DownloadTask _task({bool details = true}) => DownloadTask.fromMap(
+  DownloadTask(
+    id: 'halo',
+    slug: 'halo',
+    title: 'Halo',
+    platform: 'xbox',
+    status: DownloadStatus.failed,
+    createdAt: DateTime(2026),
+    error: 'The requested pack file was not found. (FILE_NOT_FOUND)',
+    diagnostics: details
+        ? DebridFailureDetails.torbox(
+            stage: DebridFailureStage.fileSelection,
+            code: 'FILE_NOT_FOUND',
+            requestedPath: 'Redump/Halo.zip',
+            expectedSize: 100,
+            providerFileCount: 200,
+            files: [
+              DebridDiagnosticFile(
+                name: '/srv/private-account/Halo.zip',
+                size: 100,
+              ),
+            ],
+          ).sanitized('dummy-private-key')
+        : null,
+    link: const DownloadLink(
+      name: 'Halo',
+      type: 'Game',
+      format: 'zip',
+      url: '',
+      filename: 'Halo.zip',
+      host: 'MiNERVA',
+      size: 100,
+      sizeStr: '100',
+      sourceUrl: '',
+    ),
+  ).toMap(),
+);
+
+Future<void> _mount(
+  WidgetTester tester,
+  _Service service, {
+  double scale = 1,
+}) async {
+  SharedPreferences.setMockInitialValues({});
+  await tester.pumpWidget(
+    ProviderScope(
+      overrides: [downloadServiceProvider.overrideWithValue(service)],
+      child: MaterialApp(
+        theme: buildRomgiTheme(AppDesign.native),
+        builder: (context, child) => MediaQuery(
+          data: MediaQuery.of(
+            context,
+          ).copyWith(textScaler: TextScaler.linear(scale)),
+          child: child!,
+        ),
+        home: const DownloadsScreen(),
+      ),
+    ),
+  );
+  await tester.pumpAndSettle();
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  setUp(() {
+    PackageInfo.setMockInitialValues(
+      appName: 'NOMROM',
+      packageName: 'nomrom',
+      version: '1.10.4',
+      buildNumber: '25',
+      buildSignature: '',
+    );
+  });
+
+  tearDown(() {
+    TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger
+        .setMockMethodCallHandler(SystemChannels.platform, null);
+  });
+
+  testWidgets('copies persisted safe details with version without retrying', (
+    tester,
+  ) async {
+    String? copied;
+    TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger
+        .setMockMethodCallHandler(SystemChannels.platform, (call) async {
+          if (call.method == 'Clipboard.setData') {
+            copied = (call.arguments as Map)['text'] as String;
+          }
+          return null;
+        });
+    final service = _Service([_task()]);
+    await _mount(tester, service);
+    await tester.tap(find.byTooltip('Copy details'));
+    await tester.pumpAndSettle();
+    expect(copied, contains('App version: 1.10.4+25'));
+    expect(copied, contains('Stage: file selection'));
+    expect(copied, contains('FILE_NOT_FOUND'));
+    expect(copied, contains('Selected catalog path: Redump/Halo.zip'));
+    expect(copied, isNot(contains('private-account')));
+    expect(copied, isNot(contains('dummy-private-key')));
+    expect(utf8.encode(copied!).length, lessThanOrEqualTo(4096));
+    expect(find.text('Details copied'), findsOneWidget);
+    expect(service.actions, isEmpty);
+    expect(tester.takeException(), isNull);
+  });
+
+  testWidgets('plain legacy failure has no copy action', (tester) async {
+    await _mount(tester, _Service([_task(details: false)]));
+    expect(find.byTooltip('Copy details'), findsNothing);
+    expect(find.byTooltip('Retry'), findsOneWidget);
+    expect(find.byTooltip('Remove'), findsOneWidget);
+  });
+
+  testWidgets(
+    'clipboard failure is recoverable without leaking platform error',
+    (tester) async {
+      TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger
+          .setMockMethodCallHandler(SystemChannels.platform, (call) async {
+            if (call.method == 'Clipboard.setData') {
+              throw PlatformException(
+                code: 'unavailable',
+                message: 'private-platform-detail',
+              );
+            }
+            return null;
+          });
+      final service = _Service([_task()]);
+      await _mount(tester, service);
+      await tester.tap(find.byTooltip('Copy details'));
+      await tester.pumpAndSettle();
+      expect(
+        find.text('Could not copy details. Please try again.'),
+        findsOneWidget,
+      );
+      expect(find.textContaining('private-platform-detail'), findsNothing);
+      expect(service.actions, isEmpty);
+      expect(tester.takeException(), isNull);
+    },
+  );
+
+  testWidgets(
+    'copy action fits narrow scaled layout and survives disposal while copying',
+    (tester) async {
+      tester.view.physicalSize = const Size(420, 900);
+      tester.view.devicePixelRatio = 1;
+      addTearDown(tester.view.resetPhysicalSize);
+      addTearDown(tester.view.resetDevicePixelRatio);
+      final copied = Completer<void>();
+      TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger
+          .setMockMethodCallHandler(SystemChannels.platform, (call) async {
+            if (call.method == 'Clipboard.setData') await copied.future;
+            return null;
+          });
+      await _mount(tester, _Service([_task()]), scale: 1.8);
+      expect(tester.takeException(), isNull);
+      await tester.tap(find.byTooltip('Copy details'));
+      await tester.pump();
+      await tester.pumpWidget(const SizedBox.shrink());
+      copied.complete();
+      await tester.pumpAndSettle();
+      expect(tester.takeException(), isNull);
+    },
+  );
+}
