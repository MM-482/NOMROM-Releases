+          'hash': returnedHash,
+          'size': _containerSize,
+          'download_present': true,
+          'download_finished': finished,
+          'download_state': 'cached',
+          'files': files ?? [_container()],
+        },
+      }),
+    ),
+    '/v1/api/torrents/requestdl': (_) => failLink
+        ? jsonBody('{"success":false,"error":"FILE_NOT_FOUND"}')
