+              status: DownloadStatus.paused,
+              link: base.link.copyWith(debridResolved: true),
+              error: 'Still preparing. (CACHING_TIMEOUT)',
+            )
+            .waitingForDebrid,
+        isFalse,
+      );
+    },
+  );
+
+  test('pausing a resolving task does not record a debrid failure', () async {
