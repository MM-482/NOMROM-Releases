+  Stream<Uint8List> stream(int start, int length) async* {
+    final requests = _RangeCancellation(cancelToken);
+    try {
+      yield* _stream(start, length, requests);
+    } finally {
+      // Pinned Dio's response wrapper does not propagate a subscription cancel
+      // to the adapter. Abort our private request, including when a consumer
+      // rejects a chunk. The caller's token is reserved for task stop intent.
+      requests.stop();
+    }
+  }
+
+  Stream<Uint8List> _stream(
+    int start,
+    int length,
+    _RangeCancellation requests,
+  ) async* {
+    _checkCancelled(cancelToken);
+    if (length <= 0 || !_inBounds(start, length, size)) _invalid();
+    final end = start + length - 1;
+    Response<ResponseBody>? response;
+    for (var redirects = 0; redirects <= 5; redirects++) {
+      if (++_requests > 32) {
+        throw const RemoteZipException(
+          'ZIP_RANGE_LIMIT',
+          'The ZIP exceeded its range-request limit.',
+        );
+      }
+      final uri = Uri.tryParse(_url);
+      if (uri == null ||
+          !uri.hasAuthority ||
+          uri.userInfo.isNotEmpty ||
+          (uri.scheme != 'https' &&
+              !(uri.scheme == 'http' &&
+                  (uri.host == '127.0.0.1' ||
+                      uri.host == '::1' ||
+                      uri.host == 'localhost')))) {
+        throw const RemoteZipException(
+          'ZIP_URL_INVALID',
+          'The ZIP download address is not supported.',
+        );
+      }
+      final strongEtag = _strongEtag(_etag);
+      response = await dio.get<ResponseBody>(
+        _url,
+        cancelToken: requests.next(),
+        options: Options(
+          connectTimeout: const Duration(seconds: 20),
+          sendTimeout: const Duration(seconds: 20),
+          receiveTimeout: const Duration(seconds: 30),
+          responseType: ResponseType.stream,
+          followRedirects: false,
+          receiveDataWhenStatusError: false,
+          validateStatus: (status) =>
+              status != null &&
+              ((status >= 200 && status < 400) || status == 412),
+          headers: {
+            'Range': 'bytes=$start-$end',
+            'Accept-Encoding': 'identity',
+            // The signed URL is the only download authority. Do not inherit
+            // unrelated account headers from a shared Dio instance.
+            'Authorization': null,
+            'Cookie': null,
+            if (strongEtag) 'If-Match': _etag,
+            if (!strongEtag && _lastModified != null)
+              'If-Unmodified-Since': _lastModified,
+          },
+        ),
+      );
+      if (![301, 302, 303, 307, 308].contains(response.statusCode)) break;
+      Uri? next;
+      try {
+        final location = _header(response, 'location');
+        next = location == null ? null : uri.resolve(location);
+      } on FormatException {
+        throw const RemoteZipException(
+          'ZIP_REDIRECT_INVALID',
+          'The ZIP download redirect could not be followed safely.',
+        );
+      } finally {
+        requests.stop();
+        await response.data?.stream
+            .listen(null, onError: (Object _) {})
+            .cancel();
+      }
+      if (redirects == 5 ||
+          next == null ||
+          next.userInfo.isNotEmpty ||
+          (uri.scheme == 'https' && next.scheme != 'https')) {
+        throw const RemoteZipException(
+          'ZIP_REDIRECT_INVALID',
+          'The ZIP download redirect could not be followed safely.',
+        );
+      }
+      _url = next.toString();
+      _checkCancelled(cancelToken);
+    }
+    final reply = response!;
+    final body = reply.data;
+    try {
+      if (reply.statusCode == 412) {
+        throw const RemoteZipException(
+          'ZIP_CHANGED',
+          'The cached ZIP changed while it was being read. Please retry.',
+        );
+      }
+      if (reply.statusCode != 206 || body == null) {
+        throw const RemoteZipException(
+          'ZIP_RANGE_UNSUPPORTED',
+          'The download server does not support bounded ZIP ranges. The collection was not downloaded.',
+        );
+      }
+      final range = RegExp(
+        r'^bytes (\d+)-(\d+)/(\d+)$',
+        caseSensitive: false,
+      ).firstMatch(_header(reply, 'content-range')?.trim() ?? '');
+      final contentLength = _header(reply, 'content-length');
+      final encoding = _header(reply, 'content-encoding')?.trim().toLowerCase();
+      final type = _header(reply, 'content-type')?.toLowerCase();
+      if (range == null ||
+          int.tryParse(range[1]!) != start ||
+          int.tryParse(range[2]!) != end ||
+          int.tryParse(range[3]!) != size ||
+          (contentLength != null && int.tryParse(contentLength) != length) ||
+          (encoding != null && encoding != 'identity') ||
+          (type != null && type.startsWith('multipart/'))) {
+        throw const RemoteZipException(
+          'ZIP_RANGE_INVALID',
+          'The download server returned an inconsistent ZIP byte range.',
+        );
+      }
+      final etag = _header(reply, 'etag');
+      final modified = _header(reply, 'last-modified');
+      if ((etag != null && etag.length > 1024) ||
+          (_strongEtag(_etag) && etag != _etag) ||
+          (_etag != null && etag != null && _etag != etag) ||
+          (_lastModified != null &&
+              modified != null &&
+              _lastModified != modified)) {
+        throw const RemoteZipException(
+          'ZIP_CHANGED',
+          'The cached ZIP changed while it was being read. Please retry.',
+        );
+      }
+      _etag ??= etag;
+      if (modified != null) {
+        try {
+          HttpDate.parse(modified);
+          _lastModified ??= modified;
+        } on HttpException {
+          // An invalid optional date must never become a request header.
+        }
+      }
+    } catch (_) {
+      requests.stop();
+      await body?.stream.listen(null, onError: (Object _) {}).cancel();
+      rethrow;
+    }
+    var received = 0;
+    final boundedStream = body.stream.timeout(
+      const Duration(seconds: 30),
+      onTimeout: (sink) {
+        sink.addError(
+          DioException.receiveTimeout(
+            timeout: const Duration(seconds: 30),
+            requestOptions: reply.requestOptions,
+          ),
+        );
+        sink.close();
+      },
+    );
+    await for (final chunk in boundedStream) {
+      _checkCancelled(cancelToken);
+      if (chunk.length > length - received) {
+        throw const RemoteZipException(
+          'ZIP_RANGE_INVALID',
+          'A ZIP byte range exceeded its declared length.',
+        );
+      }
+      received += chunk.length;
+      yield chunk;
+    }
+    _checkCancelled(cancelToken);
+    if (received != length) {
+      throw const RemoteZipException(
+        'ZIP_RANGE_INVALID',
+        'A ZIP byte range ended before its declared length.',
+      );
+    }
+  }
+}
+
+final class _RangeCancellation {
+  _RangeCancellation(CancelToken parent) {
+    unawaited(
+      parent.whenCancel.then<void>((reason) {
+        _current?.cancel(reason);
+      }),
+    );
+  }
+
+  CancelToken? _current;
+
+  CancelToken next() {
+    stop();
+    return _current = CancelToken();
+  }
+
+  void stop() {
+    final token = _current;
+    _current = null;
+    token?.cancel('ZIP byte range closed');
+  }
+}
+
+bool _strongEtag(String? value) =>
+    value != null && RegExp(r'^"[\x21\x23-\x7e\x80-\xff]*"$').hasMatch(value);
+
+String? _header(Response<ResponseBody> response, String name) {
+  final values = response.headers[name];
+  if (values == null || values.isEmpty) return null;
+  if (values.length != 1 || RegExp(r'[\r\n]').hasMatch(values.single)) {
+    throw const RemoteZipException(
+      'ZIP_RANGE_INVALID',
+      'The ZIP response contains conflicting headers.',
+    );
+  }
+  return values.single;
+}
+
+Stream<List<int>> _smallChunks(Stream<Uint8List> source) async* {
+  await for (final chunk in source) {
+    for (var start = 0; start < chunk.length; start += 4096) {
+      yield Uint8List.sublistView(
+        chunk,
+        start,
+        math.min(start + 4096, chunk.length),
+      );
+    }
+  }
+}
+
+Stream<List<int>> _inflate(Stream<List<int>> input) async* {
+  try {
+    // await-for turns decoder error events into exceptions handled here.
+    // yield* would forward them directly, bypassing the safe failure mapping.
+    await for (final chunk in ZLibDecoder(raw: true).bind(input)) {
+      yield chunk;
+    }
+  } on DioException {
+    rethrow;
+  } on RemoteZipException {
+    rethrow;
+  } catch (_) {
+    throw const RemoteZipException(
+      'ZIP_DEFLATE_INVALID',
+      'The selected ZIP member could not be decompressed.',
+    );
+  }
+}
+
+final class _Crc32 {
+  static final _table = List<int>.generate(256, (value) {
+    var crc = value;
+    for (var bit = 0; bit < 8; bit++) {
+      crc = (crc & 1) != 0 ? 0xedb88320 ^ (crc >>> 1) : crc >>> 1;
+    }
+    return crc;
+  }, growable: false);
+
+  var _crc = 0xffffffff;
+  void add(List<int> bytes) {
+    for (final byte in bytes) {
+      _crc = _table[(_crc ^ byte) & 0xff] ^ (_crc >>> 8);
+    }
+  }
+
+  int get value => (_crc ^ 0xffffffff) & 0xffffffff;
+}
