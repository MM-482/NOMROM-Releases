+import 'package:path/path.dart' as p;
+
+import '../models/platform.dart' as catalog;
+import '../services/skraper/skraper_import_service.dart';
+import 'skraper_import_backend.dart';
+
+class SkraperImportDialog extends StatefulWidget {
+  const SkraperImportDialog({
+    super.key,
+    required this.path,
+    required this.platforms,
+    required this.backend,
+    this.pickImageFolder,
+  });
+
+  final String path;
+  final List<catalog.Platform> platforms;
+  final SkraperImportBackend backend;
+  final Future<String?> Function()? pickImageFolder;
+
+  @override
+  State<SkraperImportDialog> createState() => _SkraperImportDialogState();
+}
+
+class _SkraperImportDialogState extends State<SkraperImportDialog> {
+  String? _platform;
+  SkraperImageRole _imageRole = SkraperImageRole.artwork;
+  SkraperImportPreview? _preview;
+  String? _error;
+  bool _loading = false;
+  bool _choosingFolder = false;
+  String? _mediaRoot;
+  bool get _busy => _loading || _choosingFolder;
+
+  Future<void> _loadPreview() async {
+    final platform = _platform;
+    if (_busy || platform == null) return;
+    setState(() {
+      _loading = true;
+      _preview = null;
+      _error = null;
+    });
+    try {
+      final result = await widget.backend.previewFile(
+        widget.path,
+        platform: platform,
+        imageRole: _imageRole,
+        mediaRoot: _mediaRoot,
+      );
+      if (mounted) setState(() => _preview = result);
+    } catch (error) {
+      if (mounted) {
+        setState(() {
+          _error = skraperImportError(
+            error,
+            fallback:
+                'Could not read this game list. Choose a Skraper gamelist.xml '
+                'and check that its images are accessible.',
+          );
+        });
+      }
+    } finally {
+      if (mounted) setState(() => _loading = false);
+    }
+  }
+
+  Future<void> _chooseImageFolder() async {
+    if (_busy) return;
+    setState(() => _choosingFolder = true);
+    try {
+      final folder =
+          await (widget.pickImageFolder?.call() ??
+              FilePicker.platform.getDirectoryPath(
+                dialogTitle: 'Choose the folder containing Skraper images',
+              ));
+      if (!mounted || folder == null) return;
+      setState(() {
+        _mediaRoot = folder;
+        _preview = null;
+        _error = null;
+      });
+    } catch (_) {
+      if (mounted) {
+        setState(() => _error = 'Could not open the image folder. Try again.');
+      }
+    } finally {
+      if (mounted) setState(() => _choosingFolder = false);
+    }
+  }
+
+  void _resetImageFolder() {
+    setState(() {
+      _mediaRoot = null;
+      _preview = null;
+      _error = null;
+    });
+  }
+
+  void _changePlatform(String? value) {
+    setState(() {
+      _platform = value;
+      _preview = null;
+      _error = null;
+    });
+  }
+
+  void _changeImageRole(SkraperImageRole? value) {
+    if (value == null) return;
+    setState(() {
+      _imageRole = value;
+      _preview = null;
+      _error = null;
+    });
+  }
+
+  String _platformLabel(catalog.Platform platform) {
+    final brand = platform.brand.trim();
+    final name = platform.name.trim();
+    final label = brand.isEmpty ? name : '$brand — $name';
+    return '$label (${platform.id})';
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final preview = _preview;
+    final theme = Theme.of(context);
+    return AlertDialog(
+      title: const Text('Import from Skraper'),
+      content: SizedBox(
+        width: 560,
+        child: SingleChildScrollView(
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            crossAxisAlignment: CrossAxisAlignment.stretch,
+            children: [
+              Text(
+                p.basename(widget.path),
+                style: theme.textTheme.titleSmall,
+                maxLines: 2,
+                overflow: TextOverflow.ellipsis,
+              ),
+              const SizedBox(height: 8),
+              const Text(
+                'Choose the matching NOMROM platform, then review the games '
+                'and images before importing.',
+              ),
+              const SizedBox(height: 20),
+              DropdownButtonFormField<String>(
+                key: const ValueKey('skraper-platform'),
+                initialValue: _platform,
+                isExpanded: true,
+                menuMaxHeight: 320,
+                decoration: const InputDecoration(
+                  labelText: 'Platform',
+                  border: OutlineInputBorder(),
+                ),
+                hint: const Text('Choose a platform'),
+                items: [
+                  for (final platform in widget.platforms)
+                    DropdownMenuItem(
+                      value: platform.id,
+                      child: Text(
+                        _platformLabel(platform),
+                        overflow: TextOverflow.ellipsis,
+                      ),
+                    ),
+                ],
+                onChanged: _busy ? null : _changePlatform,
+              ),
+              const SizedBox(height: 16),
+              DropdownButtonFormField<SkraperImageRole>(
+                key: const ValueKey('skraper-image-role'),
+                initialValue: _imageRole,
+                isExpanded: true,
+                decoration: const InputDecoration(
+                  labelText: 'Skraper image type',
+                  border: OutlineInputBorder(),
+                ),
+                items: const [
+                  DropdownMenuItem(
+                    value: SkraperImageRole.artwork,
+                    child: Text('Artwork / image mixes'),
+                  ),
+                  DropdownMenuItem(
+                    value: SkraperImageRole.cover,
+                    child: Text('Box covers'),
+                  ),
+                  DropdownMenuItem(
+                    value: SkraperImageRole.screenshot,
+                    child: Text('Screenshots'),
+                  ),
+                ],
+                onChanged: _busy ? null : _changeImageRole,
+              ),
+              const SizedBox(height: 8),
+              Text(
+                _imageRole == SkraperImageRole.cover
+                    ? 'Use Box covers only for front-cover images. Their full '
+                          'aspect ratio is preserved.'
+                    : 'Image mixes and screenshots appear as artwork in game '
+                          'details. Existing box covers keep their own role.',
+                style: theme.textTheme.bodySmall,
+              ),
+              const SizedBox(height: 16),
+              Text('Image folder', style: theme.textTheme.titleSmall),
+              const SizedBox(height: 4),
+              Text(
+                _mediaRoot ?? 'Same folder as gamelist.xml',
+                key: const ValueKey('skraper-image-folder-path'),
+                maxLines: 2,
+                overflow: TextOverflow.ellipsis,
+                style: theme.textTheme.bodySmall,
+              ),
+              const SizedBox(height: 4),
+              Wrap(
+                spacing: 8,
+                children: [
+                  OutlinedButton.icon(
+                    key: const ValueKey('skraper-choose-image-folder'),
+                    onPressed: _busy ? null : _chooseImageFolder,
+                    icon: const Icon(Icons.folder_open_outlined, size: 18),
+                    label: Text(
+                      _choosingFolder ? 'Choosing…' : 'Choose image folder',
+                    ),
+                  ),
+                  if (_mediaRoot != null)
+                    TextButton(
+                      key: const ValueKey('skraper-reset-image-folder'),
+                      onPressed: _busy ? null : _resetImageFolder,
+                      child: const Text('Use game list folder'),
+                    ),
+                ],
+              ),
+              Text(
+                'Choose a folder when Skraper saved its images separately. '
+                'Only images inside that folder are included.',
+                style: theme.textTheme.bodySmall,
+              ),
+              if (_loading) ...[
+                const SizedBox(height: 20),
+                const LinearProgressIndicator(),
+                const SizedBox(height: 8),
+                const Text('Checking games and local images…'),
+              ],
+              if (_error != null) ...[
+                const SizedBox(height: 16),
+                Text(
+                  _error!,
+                  key: const ValueKey('skraper-preview-error'),
+                  style: TextStyle(color: theme.colorScheme.error),
+                ),
+              ],
+              if (preview != null) ...[
+                const SizedBox(height: 20),
+                _PreviewDetails(preview: preview),
+              ],
+            ],
+          ),
+        ),
+      ),
+      actions: [
+        TextButton(
+          onPressed: () => Navigator.of(context).pop(),
+          child: const Text('Cancel'),
+        ),
+        if (preview == null)
+          FilledButton(
+            key: const ValueKey('skraper-preview-button'),
+            onPressed: _busy || _platform == null ? null : _loadPreview,
+            child: Text(_loading ? 'Checking…' : 'Preview import'),
+          )
+        else
+          FilledButton(
+            key: const ValueKey('skraper-confirm-import'),
+            onPressed: _busy || preview.gameCount == 0
+                ? null
+                : () => Navigator.of(context).pop(preview),
+            child: Text('Import ${preview.gameCount} games'),
+          ),
+      ],
+    );
+  }
+}
+
+class _PreviewDetails extends StatelessWidget {
+  const _PreviewDetails({required this.preview});
+
+  final SkraperImportPreview preview;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        Text('Import preview', style: theme.textTheme.titleSmall),
+        const SizedBox(height: 8),
+        Wrap(
+          spacing: 8,
+          runSpacing: 4,
+          children: [
+            Chip(label: Text('${preview.gameCount} games')),
+            Chip(label: Text('${preview.coverCount} covers')),
+            Chip(label: Text('${preview.screenshotCount} screenshots')),
+            Chip(label: Text('${preview.artworkCount} image references')),
+          ],
+        ),
+        if (preview.skippedCount > 0)
+          Text('${preview.skippedCount} entries will be skipped.'),
+        if (preview.ambiguousAliasCount > 0)
+          Text(
+            '${preview.ambiguousAliasCount} ambiguous names will not be matched '
+            'automatically.',
+          ),
+        if (preview.gameCount == 0)
+          const Padding(
+            padding: EdgeInsets.only(top: 8),
+            child: Text('No valid game entries are ready to import.'),
+          ),
+        const SizedBox(height: 8),
+        for (final item in preview.items.take(5))
+          Padding(
+            padding: const EdgeInsets.symmetric(vertical: 4),
+            child: Text(
+              item.title,
+              maxLines: 2,
+              overflow: TextOverflow.ellipsis,
+            ),
+          ),
+        if (preview.gameCount > 5)
+          Text(
+            'Showing 5 of ${preview.gameCount} games.',
+            style: theme.textTheme.bodySmall,
+          ),
+        if (preview.issues.isNotEmpty)
+          ExpansionTile(
+            tilePadding: EdgeInsets.zero,
+            childrenPadding: const EdgeInsets.only(bottom: 8),
+            initiallyExpanded: true,
+            title: Text(
+              '${preview.issues.length} import '
+              '${preview.issues.length == 1 ? 'notice' : 'notices'}',
+            ),
+            children: [
+              for (final issue in preview.issues)
+                Padding(
+                  padding: const EdgeInsets.symmetric(vertical: 4),
+                  child: Align(
+                    alignment: Alignment.centerLeft,
+                    child: Text(issue, style: theme.textTheme.bodySmall),
+                  ),
+                ),
+            ],
+          ),
+        const SizedBox(height: 8),
+        Text(
+          'NOMROM saves shared images once in its own storage. Importing '
+          'works offline.',
+          style: theme.textTheme.bodySmall,
+        ),
+      ],
+    );
+  }
+}
diff --git a/lib/widgets/skraper_integration_tile.dart b/lib/widgets/skraper_integration_tile.dart
new file mode 100644
--- /dev/null
+++ b/lib/widgets/skraper_integration_tile.dart
@@ -0,0 +1,449 @@
+import 'dart:async';
+
+import 'package:file_picker/file_picker.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../models/platform.dart' as catalog;
+import '../providers/metadata_provider.dart';
+import '../providers/platforms_provider.dart';
+import '../services/skraper/skraper_import_service.dart';
+import '../utils/platform_names.dart';
+import 'rom_identification_dialog.dart';
+import 'skraper_import_backend.dart';
+import 'skraper_import_dialog.dart';
+
+/// Explicit local imports are independent of network metadata jobs and downloads.
+class SkraperIntegrationTile extends ConsumerStatefulWidget {
+  const SkraperIntegrationTile({
+    super.key,
+    this.backend,
+    this.pickGamelist,
+    this.pickImageFolder,
+    this.loadPlatforms,
+    this.onImportsChanged,
+    this.identifyRom,
+  });
+
+  final SkraperImportBackend? backend;
+  final Future<String?> Function()? pickGamelist;
+  final Future<String?> Function()? pickImageFolder;
+  final Future<List<catalog.Platform>> Function()? loadPlatforms;
+  final Future<void> Function()? onImportsChanged;
+  final Future<void> Function()? identifyRom;
+
+  @override
+  ConsumerState<SkraperIntegrationTile> createState() =>
+      _SkraperIntegrationTileState();
+}
+
+class _SkraperIntegrationTileState
+    extends ConsumerState<SkraperIntegrationTile> {
+  late final SkraperImportBackend _backend =
+      widget.backend ?? LocalSkraperImportBackend();
+  SkraperImportStatus? _status;
+  String? _operation;
+  String? _message;
+  String? _statusError;
+  List<String> _notices = const [];
+  int _statusRequest = 0;
+  bool get _busy => _operation != null;
+
+  @override
+  void initState() {
+    super.initState();
+    unawaited(_refreshStatus());
+  }
+
+  Future<void> _refreshStatus() async {
+    final request = ++_statusRequest;
+    try {
+      final status = await _backend.getStatus();
+      if (!mounted || request != _statusRequest) return;
+      setState(() {
+        _status = status;
+        _statusError = null;
+      });
+    } catch (_) {
+      if (!mounted || request != _statusRequest) return;
+      setState(
+        () => _statusError = 'Could not read the current import history.',
+      );
+    }
+  }
+
+  Future<String?> _pickFile() async {
+    if (widget.pickGamelist case final picker?) return picker();
+    final result = await FilePicker.platform.pickFiles(
+      dialogTitle: 'Choose a Skraper gamelist.xml',
+      type: FileType.custom,
+      allowedExtensions: const ['xml'],
+      allowMultiple: false,
+      withData: false,
+    );
+    return result?.files.single.path;
+  }
+
+  Future<List<catalog.Platform>> _platforms() async {
+    List<catalog.Platform> options = const [];
+    try {
+      final loader = widget.loadPlatforms;
+      final Future<List<catalog.Platform>> request = loader != null
+          ? loader()
+          : ref.read(platformsProvider.future);
+      options = await request.timeout(const Duration(seconds: 5));
+    } catch (_) {
+      // A downloaded catalog is not required for an offline metadata import.
+    }
+    if (options.isEmpty) options = _fallbackPlatforms;
+    final unique = {for (final option in options) option.id: option};
+    return unique.values.toList()..sort(
+      (a, b) => '${a.brand} ${a.name}'.compareTo('${b.brand} ${b.name}'),
+    );
+  }
+
+  Future<void> Function() _captureRefresh() {
+    if (widget.onImportsChanged case final callback?) return callback;
+    final metadata = ref.read(gameMetadataServiceProvider);
+    // Capture the service while mounted: an in-flight import can finish after
+    // Settings closes and still notify metadata consumers without reading ref.
+    return metadata.refreshLocalImports;
+  }
+
+  Future<void> _chooseFile() async {
+    if (_busy) return;
+    setState(() {
+      _operation = 'choose';
+      _message = null;
+      _notices = const [];
+    });
+    try {
+      final path = await _pickFile();
+      if (path == null || !mounted) return;
+      final platforms = await _platforms();
+      if (!mounted) return;
+      final preview = await showDialog<SkraperImportPreview>(
+        context: context,
+        builder: (context) => SkraperImportDialog(
+          path: path,
+          platforms: platforms,
+          backend: _backend,
+          pickImageFolder: widget.pickImageFolder,
+        ),
+      );
+      if (preview == null || !mounted) return;
+      final refresh = _captureRefresh();
+      setState(() => _operation = 'import');
+      final result = await _backend.importPreview(preview);
+      var refreshFailed = false;
+      try {
+        await refresh();
+      } catch (_) {
+        refreshFailed = true;
+      }
+      if (!mounted) return;
+      await _refreshStatus();
+      if (!mounted) return;
+      setState(() {
+        if (result.importedGames == 0 && result.updatedGames > 0) {
+          _message =
+              'Updated ${result.updatedGames} games and saved '
+              '${result.importedArtwork} new images.';
+        } else if (result.importedGames == 0 && result.unchangedGames > 0) {
+          _message =
+              'Already imported. ${result.unchangedGames} games unchanged.';
+        } else {
+          _message =
+              'Imported ${result.importedGames} games and '
+              '${result.importedArtwork} images.';
+          if (result.updatedGames > 0) {
+            _message =
+                '$_message ${result.updatedGames} existing entries updated.';
+          }
+        }
+        if (result.unchangedGames > 0 &&
+            (result.importedGames > 0 || result.updatedGames > 0)) {
+          _message =
+              '$_message ${result.unchangedGames} games already imported.';
+        }
+        if (result.skippedCount > 0) {
+          _message = '$_message ${result.skippedCount} entries skipped.';
+        }
+        _notices = [
+          ...result.issues,
+          if (refreshFailed)
+            'The import was saved, but game details could not refresh. '
+                'Reopen NOMROM to load the saved import.',
+        ];
+      });
+    } catch (error) {
+      if (mounted) {
+        setState(() {
+          _message = skraperImportError(
+            error,
+            fallback: _operation == 'import'
+                ? 'Could not finish the import. Check access to the game list '
+                      'and its images, then try again.'
+                : 'Could not open the game list. Try choosing the file again.',
+          );
+        });
+      }
+    } finally {
+      if (mounted) setState(() => _operation = null);
+    }
+  }
+
+  Future<void> _identifyRom() async {
+    if (_busy) return;
+    setState(() => _operation = 'identify');
+    try {
+      if (widget.identifyRom case final action?) {
+        await action();
+      } else {
+        await showRomIdentificationDialog(context, ref);
+      }
+    } catch (_) {
+      if (mounted) {
+        setState(
+          () => _message = 'Could not open ROM identification. Try again.',
+        );
+      }
+    } finally {
+      if (mounted) setState(() => _operation = null);
+    }
+  }
+
+  Future<void> _removeImports() async {
+    final status = _status;
+    if (_busy || status == null || status.gameCount == 0) return;
+    final confirmed = await showDialog<bool>(
+      context: context,
+      builder: (context) => AlertDialog(
+        title: const Text('Remove Skraper imports?'),
+        content: Text(
+          'Remove ${status.gameCount} imported games and '
+          '${status.artworkCount} copied images from NOMROM?\n\n'
+          'Your original game lists, images and ROM files stay where they are.',
+        ),
+        actions: [
+          TextButton(
+            onPressed: () => Navigator.of(context).pop(false),
+            child: const Text('Cancel'),
+          ),
+          FilledButton(
+            key: const ValueKey('skraper-confirm-remove'),
+            style: FilledButton.styleFrom(
+              backgroundColor: Theme.of(context).colorScheme.error,
+              foregroundColor: Theme.of(context).colorScheme.onError,
+            ),
+            onPressed: () => Navigator.of(context).pop(true),
+            child: const Text('Remove imports'),
+          ),
+        ],
+      ),
+    );
+    if (confirmed != true || !mounted) return;
+    final refresh = _captureRefresh();
+    setState(() {
+      _operation = 'clear';
+      _message = null;
+      _notices = const [];
+    });
+    try {
+      await _backend.clearImports();
+      var refreshFailed = false;
+      try {
+        await refresh();
+      } catch (_) {
+        refreshFailed = true;
+      }
+      if (!mounted) return;
+      await _refreshStatus();
+      if (!mounted) return;
+      setState(() {
+        _message = 'Skraper imports removed from NOMROM.';
+        if (refreshFailed) {
+          _notices = const [
+            'Reopen NOMROM to refresh any details still on screen.',
+          ];
+        }
+      });
+    } catch (_) {
+      if (mounted) {
+        setState(() {
+          _message =
+              'Could not remove the imported files. '
+              'Check folder access and try again.';
+        });
+      }
+    } finally {
+      if (mounted) setState(() => _operation = null);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final status = _status;
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        const ListTile(
+          leading: Icon(Icons.image_search_outlined),
+          title: Text('Skraper'),
+          subtitle: Text(
+            'Import game details and local images from a Skraper gamelist.xml. '
+            'Imports work offline.',
+          ),
+        ),
+        Padding(
+          padding: const EdgeInsets.fromLTRB(16, 0, 16, 12),
+          child: Text(
+            _statusError ??
+                (status == null
+                    ? 'Checking imported games…'
+                    : '${status.gameCount} imported games · '
+                          '${status.artworkCount} saved images'),
+            key: const ValueKey('skraper-import-status'),
+            style: theme.textTheme.bodySmall,
+          ),
+        ),
+        Padding(
+          padding: const EdgeInsets.symmetric(horizontal: 16),
+          child: Wrap(
+            spacing: 8,
+            runSpacing: 8,
+            children: [
+              FilledButton.icon(
+                key: const ValueKey('skraper-choose-file'),
+                onPressed: _busy ? null : _chooseFile,
+                icon: const Icon(Icons.file_open_outlined, size: 18),
+                label: Text(switch (_operation) {
+                  'import' => 'Importing…',
+                  'choose' => 'Choosing game list…',
+                  _ => 'Choose gamelist.xml',
+                }),
+              ),
+              OutlinedButton.icon(
+                key: const ValueKey('skraper-identify-rom'),
+                onPressed: _busy ? null : _identifyRom,
+                icon: const Icon(Icons.fingerprint, size: 18),
+                label: const Text('Identify local ROM'),
+              ),
+              TextButton(
+                key: const ValueKey('skraper-remove-imports'),
+                onPressed: _busy || (status?.gameCount ?? 0) == 0
+                    ? null
+                    : _removeImports,
+                child: Text(
+                  _operation == 'clear' ? 'Removing…' : 'Remove imports',
+                ),
+              ),
+            ],
+          ),
+        ),
+        if (_operation == 'import' || _operation == 'clear')
+          const Padding(
+            padding: EdgeInsets.fromLTRB(16, 12, 16, 0),
+            child: LinearProgressIndicator(),
+          ),
+        if (_message != null)
+          Padding(
+            padding: const EdgeInsets.fromLTRB(16, 12, 16, 0),
+            child: Text(
+              _message!,
+              key: const ValueKey('skraper-import-message'),
+            ),
+          ),
+        if (_notices.isNotEmpty)
+          Padding(
+            padding: const EdgeInsets.symmetric(horizontal: 16),
+            child: ExpansionTile(
+              tilePadding: EdgeInsets.zero,
+              title: Text(
+                '${_notices.length} import '
+                '${_notices.length == 1 ? 'notice' : 'notices'}',
+              ),
+              children: [
+                for (final notice in _notices)
+                  Padding(
+                    padding: const EdgeInsets.only(bottom: 8),
+                    child: Align(
