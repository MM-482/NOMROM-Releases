+import 'package:flutter_test/flutter_test.dart';
+import 'package:romgi/models/torrent_file_selection_proof.dart';
+import 'package:romgi/services/rom_database_service.dart';
+import 'package:sqflite_common_ffi/sqflite_ffi.dart';
+
+const _hash = '0123456789abcdef0123456789abcdef01234567';
+const _otherHash = 'abcdef0123456789abcdef0123456789abcdef01';
+
+class _Catalog extends RomDatabaseService {
+  _Catalog(this.handle);
+  final Database handle;
+  int opens = 0;
+
+  @override
+  Future<Database> get database async {
+    opens++;
+    return handle;
+  }
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  sqfliteFfiInit();
+  late Database database;
+  late _Catalog service;
+
+  Future<void> insert(
+    int index,
+    String path,
+    int size, {
+    String hash = _hash,
+  }) => database
+      .insert('links', {
+        'torrent_infohash': hash,
+        'torrent_file_index': index,
+        'torrent_file_path': path,
+        'size': size,
+      })
+      .then((_) {});
+
+  Future<TorrentFileSelectionProof?> proof({String hash = _hash}) =>
+      service.getTorrentFileSelectionProof(
+        infohash: hash,
+        fileIndex: 0,
+        filePath: 'Collection/Game.zip',
+        expectedSize: 42,
+      );
+
+  setUp(() async {
+    database = await databaseFactoryFfi.openDatabase(inMemoryDatabasePath);
+    // No affinity on the member fields so malformed SQLite values stay visible.
+    await database.execute('''CREATE TABLE links (
+      torrent_infohash TEXT, torrent_file_index, torrent_file_path, size)''');
+    await database.execute(
+      'CREATE INDEX idx_links_torrent ON links(torrent_infohash)',
+    );
+    await insert(0, 'Collection/Game.zip', 42);
+    await insert(1, 'Collection/Other.zip', 10);
+    service = _Catalog(database);
+  });
+
+  tearDown(() async => database.close());
+
+  test(
+    'read uses complete same-hash members and deduplicates catalog links',
+    () async {
+      await insert(0, r'./COLLECTION\GAME.ZIP', 42);
+      await insert(0, 'Wrong/Game.zip', 999, hash: _otherHash);
+      final before = await database.rawQuery('SELECT total_changes() AS count');
+      final result = (await proof(hash: _hash.toUpperCase()))!;
+      final after = await database.rawQuery('SELECT total_changes() AS count');
+      expect(result.infohash, _hash);
+      expect(result.fileCount, 2);
+      expect(result.totalSize, 52);
+      expect(result.uniqueFilename, isTrue);
+      expect(after, before);
+    },
+  );
+
+  test(
+    'each read observes replacement member data instead of a cached proof',
+    () async {
+      expect((await proof())!.uniqueFilename, isTrue);
+      await insert(2, 'OtherFolder/Game.zip', 42);
+      final result = (await proof())!;
+      expect(result.fileCount, 3);
+      expect(result.totalSize, 94);
+      expect(result.uniqueFilename, isFalse);
+      expect(result.uniqueDecodedFilename, isFalse);
+    },
+  );
+
+  test('index gaps and conflicting duplicate rows disable proof', () async {
+    await database.delete('links', where: 'torrent_file_index = 1');
+    await insert(2, 'Collection/Other.zip', 10);
+    expect(await proof(), isNull);
+    await database.update('links', {
+      'torrent_file_index': 1,
+    }, where: 'torrent_file_index = 2');
+    await insert(1, 'Wrong.zip', 10);
+    expect(await proof(), isNull);
+  });
+
+  for (final (field, value) in <(String, Object?)>[
+    ('torrent_file_index', null),
+    ('torrent_file_index', '1'),
+    ('torrent_file_index', 1.5),
+    ('torrent_file_path', null),
+    ('torrent_file_path', 123),
+    ('size', null),
+    ('size', '10'),
+    ('size', 10.5),
+    ('size', -1),
+  ]) {
+    test(
+      'malformed member $field=$value disables the complete proof',
+      () async {
+        await database.update('links', {
+          field: value,
+        }, where: 'torrent_file_index = 1');
+        expect(await proof(), isNull);
+      },
+    );
+  }
+
+  test('missing schema and absent hashes give no proof', () async {
+    expect(await proof(hash: _otherHash), isNull);
+    await database.execute('DROP TABLE links');
+    await database.execute('CREATE TABLE links (torrent_infohash TEXT)');
+    expect(await proof(), isNull);
+  });
+
+  test('invalid hash returns before opening a catalog', () async {
+    expect(await proof(hash: "' OR 1=1 --"), isNull);
+    expect(service.opens, 0);
+  });
+}
