+              error: 'Still preparing. (CACHING_TIMEOUT)',
+            )
+            .waitingForDebrid,
+        isTrue,
+      );
+      for (final error in [
+        'CACHING_TIMEOUT',
+        'Still preparing. (CACHING_TIMEOUT_EXTRA)',
+        'Still preparing. (CACHING_TIMEOUT) extra',
+      ]) {
+        expect(
+          base
+              .copyWith(status: DownloadStatus.paused, error: error)
+              .waitingForDebrid,
+          isFalse,
+        );
+      }
+      expect(
+        base
+            .copyWith(
+              status: DownloadStatus.failed,
+              error: 'Still preparing. (CACHING_TIMEOUT)',
