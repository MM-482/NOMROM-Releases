+  /// Fast indexed local lookup after the store has loaded once. Ambiguous
+  /// aliases intentionally return no match instead of picking an arbitrary ROM.
+  Future<MetadataFound?> lookup({
+    required String title,
+    required String platform,
+  }) async {
+    await _writes;
+    await _load();
+    final aliases = <String>{_identity(title).key};
+    final stem = _romStem(title);
+    if (stem != title) aliases.add(_identity(stem).key);
+    final owners = <String>{};
+    final platformKey = _platformKey(platform);
+    for (final alias in aliases) {
+      owners.addAll(_aliasIndex['$platformKey\u0000$alias'] ?? const {});
+    }
+    return owners.length == 1 ? _records[owners.single]?.metadata : null;
+  }
