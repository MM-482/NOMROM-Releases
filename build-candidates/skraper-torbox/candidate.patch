+  }) : items = List.unmodifiable(items),
+       issues = List.unmodifiable(issues),
+       _drafts = List.unmodifiable(drafts),
+       _issuer = issuer;
+
+  final String platform;
+  final String sourceName;
+  final SkraperImageRole imageRole;
+  final List<SkraperPreviewItem> items;
+  final List<String> issues;
+  final int skippedCount;
+  final int ambiguousAliasCount;
+  final List<_Draft>? _drafts;
+  final Object? _issuer;
+
+  int get gameCount => items.length;
+  int get artworkCount =>
+      items.fold(0, (total, item) => total + item.artworkCount);
+  int get coverCount => items.fold(0, (total, item) => total + item.coverCount);
+  int get screenshotCount =>
+      items.fold(0, (total, item) => total + item.screenshotCount);
+}
+
+class SkraperImportSummary {
+  const SkraperImportSummary({
+    this.importedGames = 0,
+    this.importedArtwork = 0,
+    this.updatedGames = 0,
+    this.unchangedGames = 0,
+    this.skippedCount = 0,
+    this.issues = const [],
+  });
+
+  /// Newly added records; updates and unchanged records are counted separately.
+  final int importedGames;
+  final int importedArtwork;
+  final int updatedGames;
+  final int unchangedGames;
+  final int skippedCount;
+  final List<String> issues;
+}
+
+class SkraperImportStatus {
+  const SkraperImportStatus({
+    this.gameCount = 0,
+    this.artworkCount = 0,
+    this.platforms = const {},
+    this.lastImportAt,
+  });
+
+  final int gameCount;
+  final int artworkCount;
+  final Map<String, int> platforms;
+  final DateTime? lastImportAt;
+}
+
+/// Interoperable local gamelist importer, implemented independently of Skraper.
+/// Never executes Skraper, contacts a server, or changes its source directory.
+class SkraperImportService {
+  factory SkraperImportService({Directory? rootDirectory}) =>
+      rootDirectory == null ? _shared : SkraperImportService._(rootDirectory);
+
+  SkraperImportService._(this._rootOverride);
+
+  static final _shared = SkraperImportService._(null);
+  static const maxXmlBytes = 16 * 1024 * 1024;
+  static const maxImageBytes = 20 * 1024 * 1024;
+  static const maxGames = 50000;
+  static const maxPreviewImageBytes = 1024 * 1024 * 1024;
+  static const _maxIndexBytes = 64 * 1024 * 1024;
+  static const _maxIssues = 100;
+  static final _artName = RegExp(r'^[a-f0-9]{64}\.(?:png|jpg|webp|gif)$');
+
+  final Directory? _rootOverride;
+  final Object _issuer = Object();
+  Directory? _root;
+  Future<void>? _loading;
+  Future<void> _writes = Future.value();
+  Map<String, _Record> _records = {};
+  Map<String, Set<String>> _aliasIndex = {};
+  DateTime? _lastImportAt;
+  int _temporarySequence = 0;
+
+  /// The explicit platform is NOMROM's catalog platform ID, never guessed from
+  /// an XML game title or a folder name.
+  Future<SkraperImportPreview> previewFile(
+    String gamelistPath, {
+    required String platform,
+    SkraperImageRole imageRole = SkraperImageRole.artwork,
+    String? mediaRoot,
+  }) async {
+    final platformKey = _platformKey(platform);
+    final source = File(gamelistPath);
+    final stat = await source.stat();
+    if (stat.type != FileSystemEntityType.file || stat.size > maxXmlBytes) {
+      throw const FormatException('Choose a gamelist XML file under 16 MB.');
+    }
+    final bytes = await _boundedRead(
+      source,
+      maxXmlBytes,
+      'The gamelist exceeds the 16 MB limit.',
+    );
+    String text;
+    try {
+      text = utf8.decode(bytes);
+    } on FormatException {
+      throw const FormatException('The gamelist must use UTF-8 text.');
+    }
+    if (RegExp(
+      r'<!\s*(?:DOCTYPE|ENTITY)\b',
+      caseSensitive: false,
+    ).hasMatch(text)) {
+      throw const FormatException(
+        'XML document types and entities are not supported.',
+      );
+    }
+    XmlDocument document;
+    try {
+      document = XmlDocument.parse(text);
+    } on XmlException {
+      throw const FormatException('The selected gamelist is not valid XML.');
+    }
+    if (document.rootElement.name.local != 'gameList') {
+      throw const FormatException(
+        'Choose an EmulationStation gamelist.xml file.',
+      );
+    }
+    final elements = document.rootElement.findElements('game').toList();
+    if (elements.length > maxGames) {
+      throw const FormatException(
+        'Import at most 50,000 games in one gamelist.',
+      );
+    }
+    final canonicalSource = await source.resolveSymbolicLinks();
+    final sourceDirectory = await Directory(
+      p.dirname(canonicalSource),
+    ).resolveSymbolicLinks();
+    final allowedRoot = mediaRoot == null
+        ? sourceDirectory
+        : await Directory(mediaRoot).resolveSymbolicLinks();
+    final issues = <String>[];
+    final drafts = <_Draft>[];
+    final items = <SkraperPreviewItem>[];
+    final validatedImages = <String, _SourceImage?>{};
+    var readImageBytes = 0;
+    var skipped = 0;
