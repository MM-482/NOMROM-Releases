+              validatedImages[cacheKey] = null;
+              issue('$title: <$tag> artwork is missing or cannot be read.');
+            } on FormatException catch (error) {
+              validatedImages[cacheKey] = null;
+              issue('$title: <$tag> ${error.message}');
+            }
+          }
+          final image = validatedImages[cacheKey];
+          if (image != null && seen.add('${image.filename}:${role.name}')) {
+            images.add(_DraftImage(image, role));
+          }
+        }
+      }
+      final metadata = MetadataFound(
+        description: _field(element, 'desc', limit: 32768),
+        developer: _field(element, 'developer'),
+        publisher: _field(element, 'publisher'),
+        releaseDate: _date(_field(element, 'releasedate')),
+        genre: _field(element, 'genre'),
+        players: _field(element, 'players'),
+        sourceName: 'Skraper import',
+      );
+      drafts.add(_Draft(id, platformKey, title, aliases, metadata, images));
+      items.add(
+        SkraperPreviewItem(
+          title: title,
+          romFilename: romFilename,
+          artworkCount: images.length,
+          coverCount: images
