+    platform: platform,
+    title: other.title,
+    aliases: {...aliases, ...other.aliases}.toList()..sort(),
+    metadata: MetadataFound(
+      description: other.metadata.description ?? metadata.description,
+      developer: other.metadata.developer ?? metadata.developer,
+      publisher: other.metadata.publisher ?? metadata.publisher,
+      releaseDate: other.metadata.releaseDate ?? metadata.releaseDate,
+      genre: other.metadata.genre ?? metadata.genre,
+      players: other.metadata.players ?? metadata.players,
+      coverUrls: {
