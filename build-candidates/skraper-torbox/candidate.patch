+          cancelled = isCancelled;
+          progress = onProgress;
+          onProgress?.call(0, 9);
+          return gate.future;
+        },
+      ),
+    );
+    await tester.tap(find.byKey(const ValueKey('rom-choose-file')));
+    await tester.pump();
+    expect(cancelled!(), isFalse);
+    await tester.tap(find.text('Close'));
+    await tester.pumpAndSettle();
+    expect(cancelled!(), isTrue);
+    progress?.call(9, 9);
+    gate.complete(_identity);
+    await tester.pumpAndSettle();
+    expect(tester.takeException(), isNull);
+  });
+
+  testWidgets(
+    'archive selection gives a useful error without online requests',
+    (tester) async {
+      await _show(
+        tester,
+        RomIdentificationDialog(
+          lookup: (_, _) async => throw StateError('must not look up'),
+          pickFile: () async => '/fixture.zip',
+          identifyFile: (_, {onProgress, isCancelled}) async =>
+              throw const RomIdentificationException(
+                'Extract the archive first, then choose the ROM inside it.',
+              ),
+        ),
+      );
+      await tester.tap(find.byKey(const ValueKey('rom-choose-file')));
+      await tester.pumpAndSettle();
+      expect(find.textContaining('Extract the archive first'), findsOneWidget);
+      expect(find.byKey(const ValueKey('rom-fingerprints')), findsNothing);
+    },
+  );
+}
diff --git a/test/skraper/rom_identity_service_test.dart b/test/skraper/rom_identity_service_test.dart
new file mode 100644
--- /dev/null
+++ b/test/skraper/rom_identity_service_test.dart
@@ -0,0 +1,110 @@
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:path/path.dart' as p;
+import 'package:romgi/services/skraper/rom_identity_service.dart';
+
+void main() {
+  late Directory directory;
+  setUp(() async {
+    directory = await Directory.systemTemp.createTemp('nomrom-rom-identity-');
+  });
+  tearDown(() => directory.delete(recursive: true));
+
+  test(
+    'standard CRC32, MD5 and SHA-1 check vector identifies exactly one file',
+    () async {
+      final file = await File(p.join(directory.path, 'Fixture (USA).nes'))
+          .writeAsString('123456789');
+      final progress = <(int, int)>[];
+      final result = await RomIdentityService().identifyFile(
+        file.path,
+        onProgress: (read, total) => progress.add((read, total)),
+      );
+      expect(result.filename, 'Fixture (USA).nes');
+      expect(result.size, 9);
+      expect(result.crc32, 'CBF43926');
+      expect(result.md5, '25f9e794323b453885f5181f1b624d0b');
+      expect(result.sha1, 'f7c3bc1d808e04732adf679965ccc34ca7ae3441');
+      expect(progress.first, (0, 9));
+      expect(progress.last, (9, 9));
+    },
+  );
+
+  test(
+    'multi-chunk input matches independent zlib and hashlib fixture digests',
+    () async {
+      final file = await File(p.join(directory.path, 'large.bin'))
+          .writeAsString(List.filled(15000, '123456789').join());
+      final result = await RomIdentityService().identifyFile(file.path);
+      expect(result.size, 135000);
+      expect(result.crc32, '92902EB7');
+      expect(result.md5, '660d820d281fa08a43d890e1f62dd7a9');
+      expect(result.sha1, '96b8ab7d11225eb1bcff992a609647a55b4e7724');
+    },
+  );
+
+  test('cancel during a read never returns a partial fingerprint', () async {
+    final file = await File(p.join(directory.path, 'large.bin'))
+        .writeAsBytes(List.filled(200000, 42));
+    var cancelled = false;
+    await expectLater(
+      RomIdentityService().identifyFile(
+        file.path,
+        isCancelled: () => cancelled,
+        onProgress: (read, _) {
+          if (read > 0) cancelled = true;
+        },
+      ),
+      throwsA(isA<RomIdentificationCancelled>()),
+    );
+  });
+
+  test('a changed file is rejected after reading', () async {
+    final file = await File(p.join(directory.path, 'changing.bin'))
+        .writeAsBytes(List.filled(100000, 42));
+    var changed = false;
+    await expectLater(
+      RomIdentityService().identifyFile(
+        file.path,
+        onProgress: (read, _) {
+          if (read > 0 && !changed) {
+            changed = true;
+            file.setLastModifiedSync(DateTime(2001));
+          }
+        },
+      ),
+      throwsA(
+        isA<RomIdentificationException>().having(
+          (error) => error.message,
+          'message',
+          contains('changed'),
+        ),
+      ),
+    );
+  });
+
+  for (final extension in ['zip', '7Z', 'rar', 'cue', 'm3u']) {
+    test(
+      'requires actual ROM data instead of .$extension container or sidecar',
+      () async {
+        final file = await File(p.join(directory.path, 'fixture.$extension'))
+            .writeAsString('123');
+        await expectLater(
+          RomIdentityService().identifyFile(file.path),
+          throwsA(isA<RomIdentificationException>()),
+        );
+      },
+    );
+  }
+
+  test('empty files and directories have no ROM identity', () async {
+    final file = await File(p.join(directory.path, 'empty.nes')).create();
+    for (final path in [file.path, directory.path]) {
+      await expectLater(
+        RomIdentityService().identifyFile(path),
+        throwsA(isA<RomIdentificationException>()),
+      );
+    }
+  });
+}
diff --git a/test/skraper/rom_lookup_test.dart b/test/skraper/rom_lookup_test.dart
new file mode 100644
--- /dev/null
+++ b/test/skraper/rom_lookup_test.dart
@@ -0,0 +1,166 @@
+import 'dart:convert';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:romgi/services/metadata/metadata_provider.dart';
+import 'package:romgi/services/metadata/screenscraper_provider.dart';
+import 'package:romgi/services/skraper/rom_identity_service.dart';
+
+import '../debrid/debrid_test_utils.dart';
+
+const _identity = RomFileIdentity(
+  filename: 'Fixture (USA).nes',
+  size: 9,
+  crc32: 'CBF43926',
+  md5: '25f9e794323b453885f5181f1b624d0b',
+  sha1: 'f7c3bc1d808e04732adf679965ccc34ca7ae3441',
+);
+const _creds = {'username': 'fixture-user', 'password': 'fixture-secret'};
+const _infoPath = '/api2/jeuInfos.php';
+
+Map<String, Object> _game({Map<String, Object>? rom, String system = '3'}) => {
+  'id': '123',
+  'systeme': {'id': system},
+  'noms': [
+    {'region': 'us', 'text': 'Fixture Game'},
+  ],
+  'developpeur': {'text': 'Fixture Studio'},
+  'synopsis': [
+    {'langue': 'en', 'text': 'Fixture description.'},
+  ],
+  'rom':
+      rom ??
+      {
+        'romcrc': _identity.crc32.toLowerCase(),
+        'rommd5': _identity.md5.toUpperCase(),
+        'romsha1': _identity.sha1,
+        'romsize': '9',
+      },
+};
+
+(ScreenScraperProvider, StubAdapter) _provider(
+  Map<String, Object> game, {
+  bool authorized = true,
+  int status = 200,
+}) {
+  final dio = stubbedDio('https://api.screenscraper.fr/api2', {
+    '/api2/ssuserInfos.php': (_) =>
+        jsonBody('{"response":{"ssuser":{"id":"fixture-user","numid":"123"}}}'),
+    _infoPath: (_) => jsonBody(
+      jsonEncode({
+        'response': {'jeu': game},
+      }),
+      status,
+    ),
+  });
+  return (
+    ScreenScraperProvider(
+      dio: dio,
+      devId: authorized ? 'test-application' : '',
+      devPassword: authorized ? 'test-application-password' : '',
+      requestInterval: Duration.zero,
+    ),
+    dio.httpClientAdapter as StubAdapter,
+  );
+}
+
+void main() {
+  test(
+    'optional lookup requires NOMROM app access before any request',
+    () async {
+      final (provider, adapter) = _provider(_game(), authorized: false);
+      final result = await provider.fetchByRomIdentity(
+        identity: _identity,
+        platform: 'nes',
+        creds: _creds,
+      );
+      expect(result.metadata, isA<MetadataError>());
+      expect(result.checksumVerified, isFalse);
+      expect(adapter.calls, isEmpty);
+    },
+  );
+
+  test('hash lookup submits identifiers only and verifies system and returned checksums', () async {
+    final (provider, adapter) = _provider(_game());
+    final result = await provider.fetchByRomIdentity(
+      identity: _identity,
+      platform: 'nes',
+      creds: _creds,
+    );
+    expect(result.metadata, isA<MetadataFound>());
+    expect(result.checksumVerified, isTrue);
+    expect(result.title, 'Fixture Game');
+    expect(result.gameId, '123');
+    expect((result.metadata as MetadataFound).developer, 'Fixture Studio');
+    final call = adapter.calls.singleWhere(
+      (request) => request.uri.path == _infoPath,
+    );
+    expect(call.method, 'GET');
+    expect(call.data, isNull);
+    expect(call.queryParameters, containsPair('crc', _identity.crc32));
+    expect(call.queryParameters, containsPair('md5', _identity.md5));
+    expect(call.queryParameters, containsPair('sha1', _identity.sha1));
+    expect(call.queryParameters, containsPair('romnom', _identity.filename));
+    expect(call.queryParameters, containsPair('romtaille', 9));
+    expect(call.queryParameters, containsPair('systemeid', 3));
+  });
+
+  for (final field in ['romcrc', 'rommd5', 'romsha1', 'romsize']) {
+    test('mismatched $field cannot be called a verified match', () async {
+      final game = _game();
+      (game['rom'] as Map)[field] = field == 'romsize' ? '10' : '00000000';
+      final (provider, _) = _provider(game);
+      final result = await provider.fetchByRomIdentity(
+        identity: _identity,
+        platform: 'nes',
+        creds: _creds,
+      );
+      expect(result.metadata, isA<MetadataNoMatch>());
+      expect(result.checksumVerified, isFalse);
+    });
+  }
+
+  test('same filename without a returned checksum is not verified', () async {
+    final (provider, _) = _provider(
+      _game(rom: {'romnom': _identity.filename, 'romsize': '9'}),
+    );
+    final result = await provider.fetchByRomIdentity(
+      identity: _identity,
+      platform: 'nes',
+      creds: _creds,
+    );
+    expect(result.metadata, isA<MetadataError>());
+    expect(result.checksumVerified, isFalse);
+  });
+
+  test('same checksum for a different platform is rejected', () async {
+    final (provider, _) = _provider(_game(system: '4'));
+    final result = await provider.fetchByRomIdentity(
+      identity: _identity,
+      platform: 'nes',
+      creds: _creds,
+    );
+    expect(result.metadata, isA<MetadataNoMatch>());
+  });
+
+  test('an unknown platform never sends a guessed system ID', () async {
+    final (provider, adapter) = _provider(_game());
+    final result = await provider.fetchByRomIdentity(
+      identity: _identity,
+      platform: 'unknown-system',
+      creds: _creds,
+    );
+    expect(result.metadata, isA<MetadataError>());
+    expect(adapter.calls, isEmpty);
+  });
+
+  test('404 is an explicit no-match result', () async {
+    final (provider, _) = _provider(_game(), status: 404);
+    final result = await provider.fetchByRomIdentity(
+      identity: _identity,
+      platform: 'nes',
+      creds: _creds,
+    );
+    expect(result.metadata, isA<MetadataNoMatch>());
+    expect(result.checksumVerified, isFalse);
+  });
+}
diff --git a/test/skraper/skraper_import_service_test.dart b/test/skraper/skraper_import_service_test.dart
