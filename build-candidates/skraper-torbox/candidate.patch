+  Future<void> resumeAll() async {}
+
+  @override
+  Future<void> cancel(String infohash) async => cancelCalls++;
+}
+
+final class _PublicationIO extends IOOverrides {
+  _PublicationIO(this.destination, {this.blockType = false});
+
+  final String destination;
+  final bool blockType;
+  final typeStarted = Completer<void>();
+  final releaseType = Completer<void>();
+  int syncRenames = 0;
+  int asyncRenames = 0;
+
+  @override
+  File createFile(String path) {
+    final file = super.createFile(path);
+    return path.contains('.nomrom-zip-member-') &&
+            path.replaceAll('\\', '/').endsWith('/member')
+        ? _PublicationFile(file, this)
+        : file;
+  }
+
+  @override
+  Future<FileSystemEntityType> fseGetType(String path, bool followLinks) async {
+    if (blockType && path == destination && !typeStarted.isCompleted) {
+      typeStarted.complete();
+      await releaseType.future;
+    }
+    return super.fseGetType(path, followLinks);
+  }
+}
+
+class _PublicationFile extends Fake implements File {
+  _PublicationFile(this.file, this.owner);
+  final File file;
+  final _PublicationIO owner;
+
+  @override
+  String get path => file.path;
+
+  @override
+  Future<int> length() => file.length();
+
+  @override
+  Future<File> writeAsBytes(
+    List<int> bytes, {
+    FileMode mode = FileMode.write,
+    bool flush = false,
+  }) => file.writeAsBytes(bytes, mode: mode, flush: flush);
+
+  @override
+  File renameSync(String newPath) {
+    owner.syncRenames++;
+    return file.renameSync(newPath);
+  }
+
+  @override
+  Future<File> rename(String newPath) async {
+    owner.asyncRenames++;
+    throw StateError('The final archive publication must not yield.');
+  }
+}
+
+Future<void> _until(bool Function() condition) async {
+  final end = DateTime.now().add(const Duration(seconds: 3));
+  while (!condition()) {
+    if (DateTime.now().isAfter(end)) fail('Archive transfer did not settle');
+    await Future<void>.delayed(const Duration(milliseconds: 5));
+  }
+}
