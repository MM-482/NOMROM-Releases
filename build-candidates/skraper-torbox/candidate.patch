+              alias,
+              () => {...?_aliasIndex['$platformKey\u0000$alias']},
+            )
+            .add(draft.id);
+      }
+    }
+    final ambiguous = aliasOwners.values
+        .where((owners) => owners.length > 1)
+        .length;
+    if (ambiguous > 0) {
+      issue(
+        '$ambiguous shared title aliases are ambiguous and will not match automatically.',
+      );
+    }
