+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:path/path.dart' as p;
+import 'package:romgi/services/skraper/skraper_import_service.dart';
+
+final _png = base64Decode(
+  'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aF1QAAAAASUVORK5CYII=',
+);
+
+void main() {
+  late Directory sandbox;
+  late Directory source;
+  late Directory owned;
+  late SkraperImportService service;
+
+  setUp(() async {
+    sandbox = await Directory.systemTemp.createTemp('nomrom-skraper-test-');
+    source = await Directory(p.join(sandbox.path, 'source')).create();
+    owned = Directory(p.join(sandbox.path, 'owned'));
+    service = SkraperImportService(rootDirectory: owned);
+  });
+
+  tearDown(() async {
+    if (await sandbox.exists()) await sandbox.delete(recursive: true);
+  });
+
+  Future<File> image([String name = 'image.png']) async {
+    final file = File(p.join(source.path, name));
+    await file.parent.create(recursive: true);
+    return file.writeAsBytes(_png);
+  }
+
+  Future<File> list(String games, {String name = 'gamelist.xml'}) =>
+      File(p.join(source.path, name)).writeAsString(
+        '<?xml version="1.0" encoding="utf-8"?><gameList>$games</gameList>',
+      );
+
+  Future<SkraperImportSummary> importGames(
+    String games, {
+    String platform = 'snes',
+    SkraperImageRole role = SkraperImageRole.artwork,
+    String name = 'gamelist.xml',
+  }) async {
+    final file = await list(games, name: name);
+    final preview = await service.previewFile(
+      file.path,
+      platform: platform,
+      imageRole: role,
+    );
+    return service.importPreview(preview);
+  }
+
+  test(
+    'imports facts and explicit image roles with one owned content copy',
+    () async {
+      final original = await image('media/cover.png');
+      final file = await list('''
+      <game id="42">
+        <path>./Zelda, The (USA).sfc</path><name>Zelda, The</name>
+        <desc>A &amp; B: 日本語 description.</desc><developer>Nintendo</developer>
+        <publisher>Nintendo</publisher><releasedate>19911121T000000</releasedate>
+        <genre>Adventure</genre><players>1</players>
+        <box>./media/cover.png</box><image>./media/cover.png</image>
+        <screenshot>./media/cover.png</screenshot><marquee>./media/cover.png</marquee>
+      </game>''');
+      final preview = await service.previewFile(file.path, platform: 'SNES');
+      expect(preview.platform, 'snes');
+      expect(preview.gameCount, 1);
+      expect(preview.artworkCount, 3);
+      expect(preview.coverCount, 1);
+      expect(preview.screenshotCount, 1);
+      expect(preview.items.single.hasCover, isTrue);
+      expect(preview.issues, isEmpty);
+
+      final result = await service.importPreview(preview);
+      expect(result.importedGames, 1);
+      expect(result.importedArtwork, 1);
+      final metadata = await service.lookup(
+        title: 'The Zelda (Europe)',
+        platform: 'snes',
+      );
+      expect(metadata?.description, 'A & B: 日本語 description.');
+      expect(metadata?.releaseDate, '1991-11-21');
+      expect(metadata?.developer, 'Nintendo');
+      expect(metadata?.players, '1');
+      expect(metadata?.coverUrls, hasLength(1));
+      expect(metadata?.screenshotUrls, hasLength(1));
+      expect(metadata?.artworkUrls, hasLength(1));
+      final uri = metadata!.coverUrls.single;
+      expect(uri, matches(r'^nomrom-skraper://artwork/[a-f0-9]{64}\.png$'));
+      expect(uri, isNot(contains(source.path)));
+      final copy = await service.resolveArtwork(uri);
+      expect(copy, isNotNull);
+      expect(await copy!.readAsBytes(), _png);
+      expect(await original.exists(), isTrue);
+      expect(await file.exists(), isTrue);
+      final status = await service.getStatus();
+      expect(status.gameCount, 1);
+      expect(status.artworkCount, 1);
+      expect(status.platforms, {'snes': 1});
+      expect(status.lastImportAt, isNotNull);
+    },
+  );
+
+  test(
+    'unknown image never becomes a cover until explicitly classified',
+    () async {
+      await image();
+      const game =
+          '<game><path>Game.zip</path><name>Game</name><image>image.png</image></game>';
+      await importGames(game);
+      var found = await service.lookup(title: 'Game', platform: 'snes');
+      expect(found!.coverUrls, isEmpty);
+      expect(found.artworkUrls, hasLength(1));
+
+      final promoted = await importGames(game, role: SkraperImageRole.cover);
+      expect(promoted.updatedGames, 1);
+      found = await service.lookup(title: 'Game', platform: 'snes');
+      expect(found!.coverUrls, hasLength(1));
+      expect(found.artworkUrls, isEmpty);
+
+      await importGames(game, role: SkraperImageRole.screenshot);
+      found = await service.lookup(title: 'Game', platform: 'snes');
+      expect(found!.coverUrls, isEmpty);
+      expect(found.screenshotUrls, hasLength(1));
+    },
+  );
+
+  test(
+    'restart preserves metadata and artwork without original source files',
+    () async {
+      await image();
+      await importGames(
+        '<game><path>Game.zip</path><name>Game</name><desc>Imported</desc><boxart>image.png</boxart></game>',
+      );
+      await source.delete(recursive: true);
+      final reopened = SkraperImportService(rootDirectory: owned);
+      final found = await reopened.lookup(title: 'Game.zip', platform: 'snes');
+      expect(found?.description, 'Imported');
+      expect(await reopened.resolveArtwork(found!.coverUrls.single), isNotNull);
+      final persisted = await File(
+        p.join(owned.path, 'index.json'),
+      ).readAsString();
+      expect(persisted, isNot(contains(source.path)));
+    },
+  );
+
+  test(
+    'regional and disc aliases match while demos and editions stay separate',
+    () async {
+      await importGames('''
+      <game><path>Game (USA) (Disc 1).zip</path><name>Game</name><desc>Retail</desc></game>
+      <game><path>Game (Demo).zip</path><name>Game</name><desc>Demo</desc></game>
+      <game><path>Game (Deluxe Edition).zip</path><name>Game</name><desc>Deluxe</desc></game>
+      <game><path>Other.zip</path><name>Other (Beta)</name><desc>Beta</desc></game>
+      <game><path>日本語 (Japan).zip</path><name>日本語</name><desc>Unicode</desc></game>
+    ''');
+      expect(
+        (await service.lookup(
+          title: 'Game (Europe) (Disc 2)',
+          platform: 'snes',
+        ))?.description,
+        'Retail',
+      );
+      expect(
+        (await service.lookup(
+          title: 'Game (Demo)',
+          platform: 'snes',
+        ))?.description,
+        'Demo',
+      );
+      expect(
+        (await service.lookup(
+          title: 'Game (Deluxe Edition)',
+          platform: 'snes',
+        ))?.description,
+        'Deluxe',
+      );
+      expect(await service.lookup(title: 'Other', platform: 'snes'), isNull);
+      expect(
+        (await service.lookup(
+          title: 'Other (Beta)',
+          platform: 'snes',
+        ))?.description,
+        'Beta',
+      );
+      expect(
+        (await service.lookup(title: '日本語', platform: 'snes'))?.description,
+        'Unicode',
+      );
+      expect(await service.lookup(title: 'Game', platform: 'nes'), isNull);
